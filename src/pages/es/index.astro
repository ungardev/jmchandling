---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Hero from '../../components/home/Hero.astro';
import StatsStrip from '../../components/home/StatsStrip.astro';
import ServicesGrid from '../../components/home/ServicesGrid.astro';
import SafetySection from '../../components/home/SafetySection.astro';
import Section from '../../components/ui/Section.astro';
---

<Layout
  locale="es"
  title="Inicio — JMC Handling | Servicios Aeroportuarios Certificados INAC"
  description="Servicios especializados aeroportuarios en el Aeropuerto Internacional Simón Bolívar de Maiquetía. Handling, limpieza, GSE, despacho de vuelos. Certificados CESEA-021."
  canonical="/es/"
>
  <Header locale="es" />
  <main id="main-content">
    <Hero locale="es" />
    <StatsStrip locale="es" />
    <ServicesGrid locale="es" />
    <SafetySection locale="es" />
    <Section background="deep" padY="lg">
      <div class="text-center max-w-2xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white mb-4">
          ¿Listo para operar con nosotros?
        </h2>
        <p class="text-white/60 mb-8">
          Solicite una cotización personalizada y nuestro equipo comercial se pondrá en contacto en menos de 24 horas.
        </p>
        <a href="/es/cotizacion" class="btn-primary px-8 py-4 text-base">
          Solicitar Cotización
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </Section>
  </main>
  <Footer locale="es" />
</Layout>
