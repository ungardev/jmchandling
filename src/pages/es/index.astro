---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import About from '../../components/home/About.astro';
import EquipmentGrid from '../../components/home/EquipmentGrid.astro';
import Hero from '../../components/home/Hero.astro';
import HistoryStrip from '../../components/home/HistoryStrip.astro';
import RequestPrompt from '../../components/home/RequestPrompt.astro';
import ServicesGrid from '../../components/home/ServicesGrid.astro';
import { useTranslations } from '../../i18n/utils';

const locale = 'es';
const t = useTranslations(locale);
---

<Layout locale={locale} title={t('meta.homeTitle')} description={t('meta.homeDesc')} canonical="/es/">
  <Header locale={locale} />
  <main id="main-content">
    <Hero locale={locale} />
    <HistoryStrip locale={locale} />
    <ServicesGrid locale={locale} />
    <EquipmentGrid locale={locale} />
    <About locale={locale} />
    <RequestPrompt locale={locale} />
  </main>
  <Footer locale={locale} variant="compact" />
</Layout>
