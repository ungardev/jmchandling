---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/global/Header.astro';
import Footer from '../../../components/global/Footer.astro';
import Section from '../../../components/ui/Section.astro';
import { useTranslations } from '../../../i18n/utils';
import { serviceFamilies } from '../../../data/siteContent';

const locale = 'es';
const t = useTranslations(locale);
---

<Layout locale={locale} title={t('capabilities.metaTitle')} description={t('capabilities.metaDesc')} canonical="/es/capacidades">
  <Header locale={locale} />
  <main id="main-content" class="pt-[4.5rem]">
    <Section background="deep" padY="xl" ariaLabel={t('services.sectionLabel')}>
      <div class="grid gap-8 border-b border-cargo-light/20 pb-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
        <p class="font-mono text-xs uppercase tracking-[0.12em] text-cargo-light">{t('services.sectionLabel')}</p>
        <div>
          <h1 class="max-w-4xl text-balance text-5xl font-semibold leading-[0.98] tracking-[-0.045em] text-cargo-white sm:text-6xl">{t('capabilities.indexTitle')}</h1>
          <p class="mt-6 max-w-2xl text-base leading-relaxed text-cargo-white/75">{t('capabilities.indexSubtitle')}</p>
        </div>
      </div>
    </Section>

    <Section background="mist" padY="xl" ariaLabel={t('capabilities.catalogLabel')}>
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {serviceFamilies.map((family, index) => (
          <article class="group relative border border-cargo-deep/15 bg-cargo-white p-6 transition-all duration-300 hover:border-cargo-emerald/50 hover:shadow-lg">
            <span class="font-mono text-xs text-cargo-emerald/70">[{String(index + 1).padStart(2, '0')}]</span>
            <h2 class="mt-3 text-xl font-semibold tracking-[-0.025em] text-cargo-deep">{t(family.titleKey)}</h2>
            <p class="mt-3 text-sm leading-relaxed text-cargo-ink/70">{t(family.descriptionKey)}</p>
            <div class="mt-6 flex flex-wrap gap-2">
              <span class="font-mono text-[10px] uppercase tracking-wider text-cargo-ink/40">{family.serviceKeys.length} servicios</span>
            </div>
            <a
              href={`/es/capacidades/${family.key}`}
              class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-cargo-emerald transition-colors group-hover:gap-3"
            >
              {t('common.learnMore')} <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    </Section>

    <Section background="deep" padY="xl" ariaLabel={t('capabilities.ctaLabel')}>
      <div class="grid gap-8 border-t border-cargo-light/20 pt-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
        <p class="font-mono text-xs uppercase tracking-[0.12em] text-cargo-light">{t('quote.title')}</p>
        <div>
          <h2 class="max-w-3xl text-balance text-4xl font-semibold leading-tight tracking-[-0.04em] text-cargo-white sm:text-5xl">{t('capabilities.ctaTitle')}</h2>
          <p class="mt-5 max-w-2xl text-base leading-relaxed text-cargo-white/75">{t('capabilities.ctaText')}</p>
          <a href="/es/contacto" class="btn-primary mt-8">{t('common.getQuote')} <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </Section>
  </main>
  <Footer locale={locale} />
</Layout>
