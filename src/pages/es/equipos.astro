---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Section from '../../components/ui/Section.astro';
import { useTranslations } from '../../i18n/utils';

const locale = 'es';
const t = useTranslations(locale);

const equipment = [
  {
    key: 'carrucha',
    titleKey: 'equipment.carruchaTitle',
    descKey: 'equipment.carruchaDesc',
    image: '/assets/images/gse-fleet.webp',
  },
  {
    key: 'tractor',
    titleKey: 'equipment.tractorTitle',
    descKey: 'equipment.tractorDesc',
    image: '/assets/images/gse-fleet.webp',
  },
  {
    key: 'water',
    titleKey: 'equipment.waterTitle',
    descKey: 'equipment.waterDesc',
    image: '/assets/images/equipment-cleaning.webp',
  },
  {
    key: 'belt',
    titleKey: 'equipment.beltTitle',
    descKey: 'equipment.beltDesc',
    image: '/assets/images/gse-fleet.webp',
  },
  {
    key: 'gpu',
    titleKey: 'equipment.gpuTitle',
    descKey: 'equipment.gpuDesc',
    image: '/assets/images/gse-maintenance.webp',
  },
  {
    key: 'asu',
    titleKey: 'equipment.asuTitle',
    descKey: 'equipment.asuDesc',
    image: '/assets/images/gse-maintenance.webp',
  },
];
---

<Layout locale={locale} title={t('equipment.metaTitle')} description={t('equipment.metaDesc')} canonical="/es/equipos">
  <Header locale={locale} />
  <main id="main-content" class="pt-[4.5rem]">
    <Section background="deep" padY="xl" ariaLabel={t('equipment.sectionLabel')}>
      <div class="grid gap-8 border-b border-cargo-light/20 pb-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
        <p class="font-mono text-xs uppercase tracking-[0.12em] text-cargo-light">{t('equipment.sectionLabel')}</p>
        <div>
          <h1 class="max-w-4xl text-balance text-5xl font-semibold leading-[0.98] tracking-[-0.045em] text-cargo-white sm:text-6xl">{t('equipment.title')}</h1>
          <p class="mt-6 max-w-2xl text-base leading-relaxed text-cargo-white/75">{t('equipment.subtitle')}</p>
        </div>
      </div>
    </Section>

    <Section background="mist" padY="xl" ariaLabel={t('equipment.gridLabel')}>
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {equipment.map((item, index) => (
          <article class="group overflow-hidden border border-cargo-deep/15 bg-cargo-white">
            <div class="aspect-[4/3] overflow-hidden bg-cargo-deep/5">
              <img
                src={item.image}
                alt={t(item.titleKey)}
                width="640"
                height="480"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
            </div>
            <div class="p-6">
              <span class="font-mono text-xs text-cargo-emerald/70">[{String(index + 1).padStart(2, '0')}]</span>
              <h2 class="mt-2 text-xl font-semibold tracking-[-0.025em] text-cargo-deep">{t(item.titleKey)}</h2>
              <p class="mt-3 text-sm leading-relaxed text-cargo-ink/70">{t(item.descKey)}</p>
            </div>
          </article>
        ))}
      </div>
    </Section>

    <Section background="cargo-light" padY="lg" ariaLabel={t('equipment.ctaLabel')}>
      <div class="flex flex-col justify-between gap-7 md:flex-row md:items-center">
        <div>
          <h2 class="max-w-xl text-2xl font-semibold tracking-[-0.035em] text-cargo-deep sm:text-3xl">{t('equipment.ctaTitle')}</h2>
          <p class="mt-3 max-w-2xl text-sm text-cargo-deep/80">{t('equipment.ctaText')}</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="/es/contacto" class="inline-flex items-center gap-3 bg-cargo-deep px-5 py-3.5 text-sm font-semibold text-cargo-white transition-colors hover:bg-cargo-ink">{t('common.getQuote')} <span aria-hidden="true">↗</span></a>
          <a href="/es/capacidades" class="inline-flex items-center border border-cargo-deep/40 px-5 py-3.5 text-sm font-semibold text-cargo-deep transition-colors hover:bg-cargo-white/50">{t('common.viewServices')}</a>
        </div>
      </div>
    </Section>
  </main>
  <Footer locale={locale} />
</Layout>
