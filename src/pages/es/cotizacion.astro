---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import QuoteForm from '../../components/contact/QuoteForm.astro';
import Section from '../../components/ui/Section.astro';

const url = Astro.url;
const sent = url.searchParams.get('sent') === 'true';
---

<Layout
  locale="es"
  title="Cotización — JMC Handling"
  description="Solicite una cotización personalizada para servicios de handling. Respuesta en menos de 24 horas."
  canonical="/es/cotizacion"
>
  <Header locale="es" />
  <main id="main-content" class="pt-28">
    <Section background="deep" padY="md">
      <div class="container-max text-center max-w-2xl mx-auto">
        <span class="badge-cert mb-4 inline-flex">Cotización</span>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-white mt-4 mb-4">
          Solicitar Cotización
        </h1>
        <p class="text-white/60 text-lg">
          Complete el formulario y nuestro equipo comercial se pondrá en contacto en menos de 24 horas.
        </p>
      </div>
    </Section>

    <Section background="dark" padY="lg">
      <div class="container-max">
        {sent && (
          <div class="max-w-2xl mx-auto mb-12 p-8 rounded-2xl bg-cargo-emerald/15 border border-cargo-emerald/30 text-center" role="alert">
            <svg class="w-16 h-16 text-cargo-emerald mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <h2 class="text-3xl font-bold text-white mb-3">¡Solicitud Recibida!</h2>
            <p class="text-white/60 text-lg">
              Nuestro equipo se pondrá en contacto con usted en las próximas 24 horas hábiles.
            </p>
            <a href="/es/" class="btn-primary mt-8 inline-flex">
              Volver al Inicio
            </a>
          </div>
        )}

        <div class="max-w-3xl mx-auto">
          <div class="glass rounded-2xl p-8 border border-white/10">
            <QuoteForm locale="es" variant="full" />
          </div>
        </div>
      </div>
    </Section>

    <Section background="deep" padY="lg">
      <div class="container-max text-center max-w-2xl mx-auto">
        <h2 class="text-2xl font-bold text-white mb-4">¿Prefiere contactarnos directamente?</h2>
        <p class="text-white/50 mb-6">
          Escríbanos a <a href="mailto:carlos.wood@jmchandling.com" class="text-cargo-emerald hover:underline">carlos.wood@jmchandling.com</a> o llámenos al <a href="tel:+582120000000" class="text-cargo-emerald hover:underline">+58 212 000 0000</a>.
        </p>
        <p class="text-white/30 text-sm">
          Lunes – Sábado · 05:00 – 22:00 (VET)
        </p>
      </div>
    </Section>
  </main>
  <Footer locale="es" />
</Layout>
