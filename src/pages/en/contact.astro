---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import ContactInfo from '../../components/contact/ContactInfo.astro';
import QuoteForm from '../../components/contact/QuoteForm.astro';
import FormStatus from '../../components/contact/FormStatus.astro';
import Section from '../../components/ui/Section.astro';
import { useTranslations } from '../../i18n/utils';

const locale = 'en';
const t = useTranslations(locale);
const sent = Astro.url.searchParams.get('sent') === 'true';
---

<Layout locale={locale} title={t('meta.contactTitle')} description={t('meta.contactDesc')} canonical="/en/contact">
  <Header locale={locale} />
  <main id="main-content" class="pt-[4.5rem]">
    <Section background="deep" padY="xl" ariaLabel={t('contact.title')}>
      <div class="grid gap-8 border-b border-cargo-light/20 pb-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
        <p class="font-mono text-xs uppercase tracking-[0.12em] text-cargo-light">{t('contact.title')}</p>
        <div>
          <h1 class="max-w-4xl text-balance text-5xl font-semibold leading-[0.98] tracking-[-0.045em] text-cargo-white sm:text-6xl">{t('contact.subtitle')}</h1>
        </div>
      </div>
    </Section>

    <Section background="dark" padY="xl" ariaLabel={t('contact.formTitle')}>
      {sent && <div class="mx-auto mb-14 max-w-3xl"><FormStatus locale={locale} /></div>}
      <div class="grid gap-16 lg:grid-cols-[0.9fr_1.1fr] lg:gap-24">
        <ContactInfo locale={locale} />
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.12em] text-cargo-emerald">{t('contact.formTitle')}</p>
          <h2 class="mt-5 text-3xl font-semibold tracking-[-0.03em] text-cargo-white">{t('quote.title')}</h2>
          <p class="mt-4 max-w-lg text-sm leading-relaxed text-cargo-white/70">{t('quote.subtitle')}</p>
          <div class="mt-10 border-t border-cargo-light/20 pt-8">
            <QuoteForm locale={locale} variant="lite" />
          </div>
        </div>
      </div>
    </Section>
  </main>
  <Footer locale={locale} />
</Layout>
