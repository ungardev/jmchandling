---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import ContactPage from '../../components/pages/ContactPage.astro';
import { useTranslations } from '../../i18n/utils';

const locale = 'en';
const t = useTranslations(locale);
const sent = Astro.url.searchParams.get('sent') === 'true';
const intent = Astro.url.searchParams.get('intent');
const service = Astro.url.searchParams.get('service') ?? undefined;
---

<Layout locale={locale} title={t('meta.contactTitle')} description={t('meta.contactDesc')} canonical="/en/contact">
  <Header locale={locale} />
  <main id="main-content" class="pt-[4.5rem]">
    <ContactPage locale={locale} sent={sent} intent={intent} service={service} />
  </main>
  <Footer locale={locale} />
</Layout>
