---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Hero from '../../components/home/Hero.astro';
import AlliesStrip from '../../components/home/AlliesStrip.astro';
import ServiceAccordion from '../../components/home/ServiceAccordion.astro';
import EquipmentGrid from '../../components/home/EquipmentGrid.astro';
import SafetySection from '../../components/home/SafetySection.astro';
import RequestPrompt from '../../components/home/RequestPrompt.astro';
import { useTranslations } from '../../i18n/utils';

const locale = 'en';
const t = useTranslations(locale);
---

<Layout locale={locale} title={t('meta.homeTitle')} description={t('meta.homeDesc')} canonical="/en/">
  <Header locale={locale} overlay />
  <div class="scroll-progress" aria-hidden="true"></div>
  <main id="main-content">
    <span id="about" class="sr-only" aria-hidden="true"></span>
    <span id="empresa" class="sr-only" aria-hidden="true"></span>
    <Hero locale={locale} />
    <AlliesStrip locale={locale} />
    <ServiceAccordion locale={locale} />
    <EquipmentGrid locale={locale} />
    <span id="operations" class="sr-only" aria-hidden="true"></span>
    <SafetySection locale={locale} />
    <RequestPrompt locale={locale} />
  </main>
  <Footer locale={locale} />
</Layout>
