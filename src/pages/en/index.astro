---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Hero from '../../components/home/Hero.astro';
import StatsStrip from '../../components/home/StatsStrip.astro';
import About from '../../components/home/About.astro';
import HandlingExplainer from '../../components/home/HandlingExplainer.astro';
import ServicesGrid from '../../components/home/ServicesGrid.astro';
import AircraftTypes from '../../components/home/AircraftTypes.astro';
import WhyChoose from '../../components/home/WhyChoose.astro';
import EquipmentGrid from '../../components/home/EquipmentGrid.astro';
import AlliesStrip from '../../components/home/AlliesStrip.astro';
import SafetySection from '../../components/home/SafetySection.astro';
import Section from '../../components/ui/Section.astro';
import { useTranslations } from '../../i18n/utils';

const locale = 'en';
const t = useTranslations(locale);
---

<Layout locale={locale} title={t('meta.homeTitle')} description={t('meta.homeDesc')} canonical="/en/">
  <Header locale={locale} />
  <main id="main-content">
    <Hero locale={locale} />
    <StatsStrip locale={locale} />
    <About locale={locale} />
    <HandlingExplainer locale={locale} />
    <ServicesGrid locale={locale} />
    <AircraftTypes locale={locale} />
    <WhyChoose locale={locale} />
    <EquipmentGrid locale={locale} />
    <AlliesStrip locale={locale} />
    <SafetySection locale={locale} />
    <Section background="mist" padY="xl" ariaLabel={t('quote.title')}>
      <div class="grid gap-8 border-t border-cargo-deep/15 pt-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
        <p class="font-mono text-xs uppercase tracking-[0.12em] text-cargo-emerald">{t('quote.title')}</p>
        <div>
          <h2 class="max-w-3xl text-balance text-4xl font-semibold leading-tight tracking-[-0.04em] text-cargo-deep sm:text-5xl">{t('quote.title')}</h2>
          <p class="mt-5 max-w-2xl text-base leading-relaxed text-cargo-ink/70">{t('quote.subtitle')}</p>
          <a href="/en/quote" class="btn-primary mt-8">{t('common.getQuote')} <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </Section>
  </main>
  <Footer locale={locale} />
</Layout>
