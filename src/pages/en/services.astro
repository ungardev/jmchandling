---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import ServiceDetail from '../../components/services/ServiceDetail.astro';
import Section from '../../components/ui/Section.astro';
import { getLocalizedArray, useTranslations } from '../../i18n/utils';
import { getService, serviceFamilies } from '../../data/siteContent';

const locale = 'en';
const t = useTranslations(locale);
---

<Layout locale={locale} title={t('meta.servicesTitle')} description={t('meta.servicesDesc')} canonical="/en/services">
  <Header locale={locale} />
  <main id="main-content" class="pt-[4.5rem]">
    <Section background="deep" padY="xl" ariaLabel={t('services.sectionLabel')}>
      <div class="grid gap-8 border-b border-cargo-light/20 pb-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
        <p class="font-mono text-xs uppercase tracking-[0.12em] text-cargo-light">{t('services.sectionLabel')}</p>
        <div>
          <h1 class="max-w-4xl text-balance text-5xl font-semibold leading-[0.98] tracking-[-0.045em] text-cargo-white sm:text-6xl">{t('services.indexTitle')}</h1>
          <p class="mt-6 max-w-2xl text-base leading-relaxed text-cargo-white/75">{t('services.indexSubtitle')}</p>
        </div>
      </div>
    </Section>

    <Section background="mist" padY="xl" ariaLabel={t('common.serviceIndex')}>
      <div>
        {serviceFamilies.map((family, familyIndex) => (
          <section id={family.key} class="border-b border-cargo-deep/15 py-12 first:pt-0 last:border-b-0 lg:py-20" aria-labelledby={`${family.key}-heading`}>
            <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr]">
              <div>
                <p class="font-mono text-xs uppercase tracking-[0.1em] text-cargo-emerald">[{String(familyIndex + 1).padStart(2, '0')}] · {t('services.familyLabel')}</p>
                <h2 id={`${family.key}-heading`} class="mt-4 max-w-md text-3xl font-semibold leading-tight tracking-[-0.04em] text-cargo-deep sm:text-4xl">{t(family.titleKey)}</h2>
                <p class="mt-4 max-w-md text-sm leading-relaxed text-cargo-ink/70">{t(family.descriptionKey)}</p>
              </div>
              <div>
                {family.serviceKeys.map((serviceKey, serviceIndex) => {
                  const service = getService(serviceKey);
                  if (!service) return null;
                  return (
                    <ServiceDetail
                      locale={locale}
                      id={service.key}
                      index={`${familyIndex + 1}.${serviceIndex + 1}`}
                      title={t(service.titleKey)}
                      description={t(service.descriptionKey)}
                      bullets={getLocalizedArray(locale, service.bulletsKey)}
                      bullethead={service.key === 'special' ? getLocalizedArray(locale, 'services.specialHeadlineBullets') : undefined}
                      familyLabel={t(family.titleKey)}
                      href={`/en/quote?service=${service.key}`}
                      actionLabel={t('common.getQuote')}
                    />
                  );
                })}
              </div>
            </div>
          </section>
        ))}
      </div>
    </Section>

    <Section background="deep" padY="xl" ariaLabel={t('quote.title')}>
      <div class="grid gap-8 border-t border-cargo-light/20 pt-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
        <p class="font-mono text-xs uppercase tracking-[0.12em] text-cargo-light">{t('quote.title')}</p>
        <div>
          <h2 class="max-w-3xl text-balance text-4xl font-semibold leading-tight tracking-[-0.04em] text-cargo-white sm:text-5xl">{t('quote.title')}</h2>
          <p class="mt-5 max-w-2xl text-base leading-relaxed text-cargo-white/75">{t('quote.subtitle')}</p>
          <a href="/en/quote" class="btn-primary mt-8">{t('common.getQuote')} <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </Section>
  </main>
  <Footer locale={locale} />
</Layout>
