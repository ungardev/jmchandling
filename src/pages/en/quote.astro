---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import QuoteForm from '../../components/contact/QuoteForm.astro';
import FormStatus from '../../components/contact/FormStatus.astro';
import Section from '../../components/ui/Section.astro';
import { useTranslations } from '../../i18n/utils';

const locale = 'en';
const t = useTranslations(locale);
const sent = Astro.url.searchParams.get('sent') === 'true';
const selectedService = Astro.url.searchParams.get('service') ?? undefined;
---

<Layout locale={locale} title={t('meta.quoteTitle')} description={t('meta.quoteDesc')} canonical="/en/quote">
  <Header locale={locale} />
  <main id="main-content" class="pt-[4.5rem]">
    <Section background="deep" padY="xl" ariaLabel={t('quote.title')}>
      <div class="grid gap-8 border-b border-cargo-light/20 pb-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
        <p class="font-mono text-xs uppercase tracking-[0.12em] text-cargo-light">{t('quote.title')}</p>
        <div>
          <h1 class="max-w-4xl text-balance text-5xl font-semibold leading-[0.98] tracking-[-0.045em] text-cargo-white sm:text-6xl">{t('quote.title')}</h1>
          <p class="mt-6 max-w-2xl text-base leading-relaxed text-cargo-white/75">{t('quote.subtitle')}</p>
        </div>
      </div>
    </Section>

    <Section background="dark" padY="xl" ariaLabel={t('quote.title')}>
      <div class="mx-auto max-w-3xl">
        {sent && <div class="mb-12"><FormStatus locale={locale} /></div>}
        <div class="border border-cargo-light/20 bg-cargo-deep/35 p-6 sm:p-10">
          <QuoteForm locale={locale} variant="full" selectedService={selectedService} successPath="/en/quote?sent=true" />
        </div>
      </div>
    </Section>

    <Section background="deep" padY="lg" ariaLabel={t('quote.directTitle')}>
      <div class="grid gap-8 border-t border-cargo-light/20 pt-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
        <p class="font-mono text-xs uppercase tracking-[0.12em] text-cargo-light">{t('quote.directTitle')}</p>
        <div>
          <h2 class="text-3xl font-semibold tracking-[-0.03em] text-cargo-white">{t('quote.directTitle')}</h2>
          <p class="mt-4 max-w-2xl text-sm leading-relaxed text-cargo-white/70">{t('quote.directText')}</p>
          <div class="mt-6 flex flex-col gap-2 text-sm text-cargo-light sm:flex-row sm:gap-6">
            <a href={`mailto:${t('footer.emailPrimary')}`} class="transition-colors hover:text-cargo-white">{t('footer.emailPrimary')}</a>
            <a href={`tel:${t('footer.phone').replaceAll(' ', '')}`} class="transition-colors hover:text-cargo-white">{t('footer.phone')}</a>
          </div>
        </div>
      </div>
    </Section>
  </main>
  <Footer locale={locale} />
</Layout>
