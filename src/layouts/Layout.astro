---
import type { Locale } from '../i18n/utils';
import { getAlternateUrls, useTranslations } from '../i18n/utils';
import { serviceFamilies, services } from '../data/siteContent';
import '../styles/global.css';

export interface Props {
  locale: Locale;
  title: string;
  description: string;
  ogImage?: string;
  canonical?: string;
  noindex?: boolean;
}

const {
  locale,
  title,
  description,
  ogImage = locale === 'en' ? '/assets/og/jmc-og-en.png' : '/assets/og/jmc-og-es.png',
  canonical,
  noindex = false,
} = Astro.props;

const t = useTranslations(locale);
const currentPath = Astro.url.pathname;
const alternates = getAlternateUrls(currentPath, locale);
const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? 'https://jmc-handling.com';
const canonicalUrl = canonical ? `${siteUrl}${canonical}` : `${siteUrl}${currentPath}`;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl}/#organization`,
  name: 'Servicios Especializados JMC, C.A.',
  alternateName: 'JMC Handling',
  url: siteUrl,
  logo: `${siteUrl}/assets/brand/logo-complete-white-1024.webp`,
  image: `${siteUrl}${ogImage}`,
  description:
    'Servicios especializados aeroportuarios en Maiquetía: apoyo en plataforma con equipos GSE, cuidado de aeronaves, OBF, tráfico de pasajeros y mantenimiento.',
  foundingDate: '2012',
  taxID: 'J401336558',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Maiquetía',
    addressRegion: 'La Guaira',
    addressCountry: 'VE',
    streetAddress: 'Aeropuerto Internacional Simón Bolívar, Nivel 1, Sector 8.2',
  },
  areaServed: 'VE',
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    email: 'customer.service@jmchandling.com',
    telephone: '+58-414-118-0806',
    availableLanguage: ['Spanish', 'English'],
  },
  sameAs: ['https://www.instagram.com/jmchandling/'],
};

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${siteUrl}/#localbusiness`,
  name: 'Servicios Especializados JMC, C.A.',
  url: siteUrl,
  image: `${siteUrl}${ogImage}`,
  telephone: '+58-414-118-0806',
  email: 'customer.service@jmchandling.com',
  priceRange: '$$',
  parentOrganization: { '@id': `${siteUrl}/#organization` },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Maiquetía',
    addressRegion: 'La Guaira',
    addressCountry: 'VE',
    streetAddress: 'Aeropuerto Internacional Simón Bolívar, Nivel 1, Sector 8.2',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 10.6013,
    longitude: -66.9914,
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    opens: '05:00',
    closes: '22:00',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
  },
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: t('home.taskHeading'),
  itemListElement: serviceFamilies.map((family, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Service',
      name: t(family.titleKey),
      description: t(family.descriptionKey),
      serviceType: t(family.titleKey),
      provider: { '@id': `${siteUrl}/#organization` },
      areaServed: 'VE',
      url: `${siteUrl}${locale === 'es' ? '/es/' : '/en/'}#${family.key}`,
    },
  })),
};

const serviceDetailSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: services.map((service, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Service',
      name: t(service.titleKey),
      description: t(service.descriptionKey),
      provider: { '@id': `${siteUrl}/#organization` },
      areaServed: 'VE',
    },
  })),
};
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow'} />
    <link rel="canonical" href={canonicalUrl} />

    <link rel="alternate" hreflang="es" href={`${siteUrl}${alternates.es}`} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}${alternates.en}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${alternates.xDefault}`} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('meta.twitterImageAlt')} />
    <meta property="og:site_name" content="JMC Handling" />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'es_ES'} />
    <meta property="og:locale:alternate" content={locale === 'en' ? 'es_ES' : 'en_US'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@jmchandling" />
    <meta name="twitter:creator" content="@jmchandling" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />
    <meta name="twitter:image:alt" content={t('meta.twitterImageAlt')} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceDetailSchema)} />
  </head>
  <body class="bg-cargo-mist text-cargo-ink antialiased">
    <a href="#main-content" class="skip-to-content">
      {t('common.skipToContent')}
    </a>

    <slot />
  </body>
</html>
