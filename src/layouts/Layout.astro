---
import type { Locale } from '../i18n/utils';
import { getAlternateUrls, useTranslations } from '../i18n/utils';
import '../styles/global.css';

export interface Props {
  locale: Locale;
  title: string;
  description: string;
  ogImage?: string;
  canonical?: string;
}

const {
  locale,
  title,
  description,
  ogImage = '/assets/brand/logo-complete-white-1024.webp',
  canonical,
} = Astro.props;

const t = useTranslations(locale);
const currentPath = Astro.url.pathname;
const alternates = getAlternateUrls(currentPath, locale);
const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? 'https://jmchandling.vercel.app';
const canonicalUrl = canonical ? `${siteUrl}${canonical}` : `${siteUrl}${currentPath}`;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Servicios Especializados JMC, C.A.',
  alternateName: 'JMC Handling',
  url: siteUrl,
  logo: `${siteUrl}/assets/brand/logo-complete-white-1024.webp`,
  description,
  sameAs: ['https://www.instagram.com/jmchandling/'],
};
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonicalUrl} />

    <link rel="alternate" hreflang="es" href={`${siteUrl}${alternates.es}`} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}${alternates.en}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${alternates.xDefault}`} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'es_ES'} />
    <meta property="og:locale:alternate" content={locale === 'en' ? 'es_ES' : 'en_US'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  </head>
  <body class="bg-cargo-mist text-cargo-ink antialiased">
    <a href="#main-content" class="skip-to-content">
      {t('common.skipToContent')}
    </a>

    <slot />
  </body>
</html>
