---
import type { Locale } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const quotePath = locale === 'es' ? '/es/contacto?intent=quote' : '/en/contact?intent=quote';

const items = [
  { href: '#allies', index: '01', label: t('home.indexAllies') },
  { href: '#services', index: '02', label: t('home.indexServices') },
  { href: '#equipment', index: '03', label: t('home.indexEquipment') },
  { href: '#operations', index: '04', label: t('home.indexOperations') },
  { href: '#safety', index: '05', label: t('home.indexSafety') },
  { href: quotePath, index: '06', label: t('home.indexContact') },
];
---

<section class="bg-cargo-mist py-20 text-cargo-ink md:py-28" aria-label={t('home.indexLabel')}>
  <div class="container-max">
    <div class="grid-12 items-baseline border-b border-cargo-deep/20 pb-8">
      <p class="eyebrow eyebrow-on-light col-span-12 lg:col-span-3">{t('home.indexLabel')}</p>
      <p class="reveal type-lead col-span-12 text-cargo-ink/80 lg:col-span-7 lg:col-start-6">
        {t('home.indexIntro')}
      </p>
    </div>

    <ul class="mt-12 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((item) => (
        <li class="border-t border-cargo-deep/20 pt-5">
          <a
            href={item.href}
            class="group flex items-baseline gap-4 text-cargo-deep"
          >
            <span class="font-mono text-xs font-medium tracking-[0.14em] text-cargo-deep/70">{item.index}</span>
            <span class="text-xl font-semibold tracking-[-0.03em] underline decoration-cargo-emerald decoration-1 underline-offset-[8px] transition-colors group-hover:text-cargo-ink sm:text-2xl">
              {item.label}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
