---
import type { Locale } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';
import {
  galleryAircraftRamp,
  galleryBeltLoaderOps,
  galleryCargoHold,
  galleryNightOps,
  galleryRampTeam,
  galleryUldRamp,
} from '../../data/media.generated';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const strip = [
  galleryAircraftRamp,
  galleryRampTeam,
  galleryBeltLoaderOps,
  galleryCargoHold,
  galleryUldRamp,
  galleryNightOps,
];
---

<section class="bg-cargo-mist py-16 text-cargo-ink md:py-20" aria-labelledby="operations-heading">
  <div class="container-max">
    <div class="grid-12 items-start border-b border-cargo-deep/20 pb-8">
      <div class="col-span-12 lg:col-span-5">
        <p class="eyebrow eyebrow-on-light">{t('operations.sectionLabel')}</p>
        <h2 id="operations-heading" class="type-h2 mt-5 max-w-md text-balance text-cargo-deep">
          {t('operations.title')}
        </h2>
        <p class="type-lead mt-5 max-w-md text-cargo-ink/80">{t('operations.subtitle')}</p>
      </div>

      <figure class="col-span-12 lg:col-span-6 lg:col-start-7">
        <div class="overflow-hidden bg-cargo-ink">
          <video
            class="aspect-video w-full object-cover"
            controls
            preload="none"
            poster="/assets/photos/video/pushback-poster.webp"
            width="626"
            height="360"
          >
            <source src="/assets/photos/video/pushback.webm" type="video/webm" />
            <source src="/assets/photos/video/pushback.mp4" type="video/mp4" />
          </video>
        </div>
        <figcaption class="mt-3 font-mono text-xs uppercase tracking-[0.1em] text-cargo-ink/80">
          {t('operations.videoCaption')}
        </figcaption>
      </figure>
    </div>

    <ul class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
      {strip.map((media) => (
        <li class="overflow-hidden bg-cargo-white">
          <img
            src={media.src}
            srcset={media.srcset}
            sizes="(min-width: 1024px) 16vw, (min-width: 640px) 30vw, 45vw"
            alt={t(media.altKey)}
            width={media.width}
            height={media.height}
            loading="lazy"
            decoding="async"
            class="aspect-[3/4] w-full object-cover"
          />
        </li>
      ))}
    </ul>
  </div>
</section>
