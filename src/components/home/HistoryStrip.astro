---
import type { Locale } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="border-b border-cargo-deep/10 bg-cargo-white" aria-label={t('home.historyLabel')}>
  <dl class="container-max grid grid-cols-1 divide-y divide-cargo-deep/15 sm:grid-cols-2 sm:divide-y-0 lg:grid-cols-[0.7fr_1.3fr]">
    <div class="flex items-center gap-5 py-6 sm:pr-10">
      <dt class="font-mono text-3xl font-semibold tracking-[-0.05em] text-cargo-deep sm:text-4xl">{t('proof.foundedValue')}</dt>
      <dd class="max-w-[18rem] text-sm leading-snug text-cargo-ink/75">{t('home.foundedEvent')}</dd>
    </div>
    <div class="flex items-center gap-5 border-cargo-deep/15 py-6 sm:border-l sm:pl-10 lg:pl-12">
      <dt class="shrink-0 font-mono text-3xl font-semibold tracking-[-0.05em] text-cargo-deep sm:text-4xl">{t('home.stationYear')}</dt>
      <dd class="max-w-[22rem] text-sm leading-snug text-cargo-ink/75">{t('home.stationEvent')}</dd>
    </div>
  </dl>
</section>
