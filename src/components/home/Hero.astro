---
import type { Locale } from '../../i18n/utils';
import AWBTracker from '../ui/AWBTracker.tsx';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section
  class="relative min-h-screen flex items-center overflow-hidden"
  aria-label={locale === 'es' ? 'Hero principal' : 'Main hero'}
>
  <div class="absolute inset-0 z-0">
    <div class="absolute inset-0 bg-gradient-to-br from-cargo-deep via-cargo-ink to-cargo-ink/95" />
    <div
      class="absolute inset-0 opacity-10"
      style="background-image: radial-gradient(circle at 20% 50%, #A0DDF5 0%, transparent 50%), radial-gradient(circle at 80% 20%, #10B981 0%, transparent 40%);"
      aria-hidden="true"
    />
    <div class="absolute inset-0 z-10 bg-gradient-to-r from-cargo-ink/80 via-transparent to-transparent" />
  </div>

  <div class="relative z-20 container-max w-full py-32 lg:py-24">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="text-left">
        <div class="mb-8">
          <span class="badge-cert text-sm mb-6 inline-flex">
            E.S.E.A. &middot; CESEA-021 &middot; INAC RAV 111
          </span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-6">
          {locale === 'es'
            ? <>12 años<br />moviendo<br />Maiquetía.</>
            : <>12 years<br />moving<br />Maiquetía.</>}
        </h1>

        <p class="text-base sm:text-lg text-white/60 max-w-lg leading-relaxed mb-10">
          {locale === 'es'
            ? 'Handling, limpieza y mantenimiento GSE certificado bajo estándares que pocas empresas cumplen. Sin excepciones.'
            : 'Certified ground handling, aircraft cleaning and GSE maintenance under standards few operators meet. No exceptions.'}
        </p>

        <div class="flex flex-col sm:flex-row items-start gap-4 mb-10">
          <a
            href={locale === 'es' ? '/es/cotizacion' : '/en/quote'}
            class="btn-primary text-base px-8 py-4"
          >
            {locale === 'es' ? 'Solicitar cotización' : 'Request a quote'}
          </a>
          <a
            href={locale === 'es' ? '/es/servicios' : '/en/services'}
            class="btn-secondary text-base px-8 py-4"
          >
            {locale === 'es' ? 'Ver servicios' : 'View services'}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>

        <div class="max-w-sm">
          <AWBTracker client:visible locale={locale} />
        </div>
      </div>

      <div class="hidden lg:block relative">
        <div class="relative rounded-2xl overflow-hidden shadow-2xl shadow-black/50">
          <img
            src="/assets/images/gse-fleet.webp"
            alt={locale === 'es' ? 'Equipo GSE en plataforma del Aeropuerto Internacional de Maiquetía' : 'GSE equipment on the Maiquetía International Airport ramp'}
            width="1280"
            height="720"
            class="w-full h-auto object-cover"
            loading="eager"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-cargo-ink/40 to-transparent" />
        </div>
        <div class="absolute -bottom-4 -right-4 w-32 h-32 rounded-full bg-cargo-emerald/10 blur-2xl" aria-hidden="true" />
      </div>
    </div>
  </div>
</section>
