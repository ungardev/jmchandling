---
import type { Locale } from '../../i18n/utils';
import AWBTracker from '../ui/AWBTracker.tsx';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section
  class="relative min-h-screen flex items-center justify-center overflow-hidden"
  aria-label={locale === 'es' ? 'Hero principal' : 'Main hero'}
>
  <div class="absolute inset-0 z-0">
    <div class="absolute inset-0 bg-gradient-to-br from-cargo-deep via-cargo-ink to-cargo-ink/95 z-10" />
    <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(circle at 20% 50%, #A0DDF5 0%, transparent 50%), radial-gradient(circle at 80% 20%, #10B981 0%, transparent 40%);" />

    <video
      id="hero-video"
      class="absolute inset-0 w-full h-full object-cover opacity-30"
      poster="/assets/images/pushback-poster.webp"
      preload="none"
      playsinline
      muted
      loop
      aria-hidden="true"
    >
      <source src="/assets/images/pushback.webm" type="video/webm" />
      <source src="/assets/images/pushback.mp4" type="video/mp4" />
    </video>

    <div class="absolute inset-0 z-10 bg-gradient-to-t from-cargo-ink via-cargo-ink/60 to-transparent" />
  </div>

  <div class="relative z-20 container-max text-center px-4 pt-32 pb-24">
    <div class="max-w-4xl mx-auto">
      <div class="mb-6 flex items-center justify-center gap-3">
        <span class="badge-cert text-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          E.S.E.A. &middot; CESEA-021
        </span>
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-6 text-balance">
        {locale === 'es'
          ? 'Servicios Aeroportuarios de '
          : 'Premium Ground '}
        <span class="text-gradient-emerald">
          {locale === 'es' ? 'Excelencia en Tierra' : 'Handling Services'}
        </span>
      </h1>

      <p class="text-lg sm:text-xl text-white/70 max-w-2xl mx-auto mb-8 leading-relaxed">
        {locale === 'es'
          ? 'Apoyamos a las aerolíneas en el Aeropuerto Internacional Simón Bolívar de Maiquetía con operaciones certificadas INAC bajo la regulación RAV 111.'
          : 'Supporting airlines at Simón Bolívar de Maiquetía International Airport with INAC-certified operations under RAV 111.'}
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
        <a
          href={locale === 'es' ? '/es/cotizacion' : '/en/quote'}
          class="btn-primary text-base px-8 py-4 w-full sm:w-auto"
        >
          {locale === 'es' ? 'Solicitar Cotización' : 'Request a Quote'}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a
          href={locale === 'es' ? '/es/servicios' : '/en/services'}
          class="btn-secondary text-base px-8 py-4 w-full sm:w-auto"
        >
          {locale === 'es' ? 'Ver Servicios' : 'View Services'}
        </a>
      </div>

      <div class="max-w-md mx-auto">
        <AWBTracker client:visible locale={locale} />
      </div>
    </div>
  </div>

  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 animate-bounce">
    <button
      id="play-video-btn"
      class="w-12 h-12 rounded-full bg-white/10 border border-white/20 flex items-center justify-center hover:bg-white/20 transition-colors"
      aria-label={locale === 'es' ? 'Reproducir video de operaciones' : 'Play operations video'}
    >
      <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M8 5v14l11-7z" />
      </svg>
    </button>
  </div>
</section>

<script is:inline>
  const playBtn = document.getElementById('play-video-btn');
  const video = document.getElementById('hero-video');
  if (playBtn && video) {
    let playing = false;
    playBtn.addEventListener('click', () => {
      playing = !playing;
      if (playing) {
        video.play().catch(() => {});
        playBtn.innerHTML = '<svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>';
        playBtn.setAttribute('aria-label', 'Pausar video');
      } else {
        video.pause();
        playBtn.innerHTML = '<svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>';
        playBtn.setAttribute('aria-label', 'Reproducir video');
      }
    });
  }
</script>
