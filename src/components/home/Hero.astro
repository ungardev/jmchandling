---
import type { Locale } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';
import { heroGseRamp } from '../../data/media.generated';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const quotePath = locale === 'es' ? '/es/contacto?intent=quote' : '/en/contact?intent=quote';

const wide = heroGseRamp.sets.wide;
const tall = heroGseRamp.sets.tall;
---

<section class="relative isolate overflow-hidden bg-cargo-ink">
  <figure class="absolute inset-0 -z-10">
    <picture>
      <source media="(max-width: 767px)" srcset={tall.srcset} sizes="100vw" width={tall.width} height={tall.height} />
      <source media="(min-width: 768px)" srcset={wide.srcset} sizes="100vw" width={wide.width} height={wide.height} />
      <img
        src={wide.src}
        srcset={wide.srcset}
        sizes="100vw"
        alt={t(heroGseRamp.altKey)}
        width={wide.width}
        height={wide.height}
        class="h-full w-full object-cover object-[60%_center]"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </picture>
    <div
      class="absolute inset-0 bg-gradient-to-t from-cargo-ink/80 via-cargo-ink/25 to-cargo-ink/45"
      aria-hidden="true"
    ></div>
    <div
      class="absolute inset-0 bg-gradient-to-r from-cargo-ink/95 via-cargo-ink/70 to-cargo-ink/25"
      aria-hidden="true"
    ></div>
  </figure>

  <div class="container-max relative pt-[7rem] pb-14 sm:pt-[8rem] md:pb-20 lg:pb-24">
    <div class="max-w-2xl">
      <p class="eyebrow eyebrow-on-dark">{t('home.heroCompanyName')}</p>
      <h1 class="mt-5 text-balance text-4xl font-semibold leading-[1.02] tracking-[-0.045em] text-cargo-white sm:text-5xl md:text-6xl xl:text-7xl">
        {t('home.heroTitle')}
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-cargo-white">
        {t('home.heroSubtitle')}
      </p>
      <p class="mt-4 max-w-xl text-base italic leading-relaxed text-cargo-white/95">
        “{t('hero.tagline')}”
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-5">
        <a href="#services" class="btn-primary">
          {t('hero.ctaPrimary')}
          <span aria-hidden="true">↓</span>
        </a>
        <a
          href={quotePath}
          class="inline-flex items-center gap-2 border-b border-cargo-white/60 pb-0.5 text-sm font-semibold text-cargo-white transition-colors hover:border-cargo-light hover:text-cargo-light"
        >
          {t('hero.ctaSecondary')}
          <span aria-hidden="true">↗</span>
        </a>
      </div>

      <p class="mt-10 flex flex-wrap items-center gap-x-3 gap-y-1 border-t border-cargo-white/30 pt-5 text-sm text-cargo-white/95">
        <span class="h-2 w-2 shrink-0 rounded-full bg-cargo-emerald" aria-hidden="true"></span>
        {t('home.heroLocation')}
      </p>
    </div>
  </div>

  <figcaption class="border-t border-cargo-white/20 bg-cargo-ink/85">
    <div class="container-max flex flex-wrap items-end justify-between gap-4 py-4 text-sm text-cargo-white/90">
      <span>{t('home.heroMediaCaption')}</span>
      <span class="font-mono uppercase tracking-[0.1em] text-cargo-light">{t('home.heroMediaContext')}</span>
    </div>
  </figcaption>
</section>
