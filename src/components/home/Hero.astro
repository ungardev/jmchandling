---
import type { Locale } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const quotePath = locale === 'es' ? '/es/cotizacion' : '/en/quote';
const servicesPath = locale === 'es' ? '/es/servicios' : '/en/services';
---

<section class="overflow-hidden bg-cargo-mist pt-[4.5rem] text-cargo-ink" aria-label={t('hero.breadcrumb')}>
  <div class="container-max grid min-h-[calc(85vh-4.5rem)] items-center lg:grid-cols-2">
    <div class="flex flex-col justify-center py-16 lg:pr-12 lg:py-20">
      <h1 class="max-w-xl text-balance text-5xl font-semibold leading-[0.98] tracking-[-0.045em] text-cargo-deep sm:text-6xl lg:text-6xl xl:text-7xl">
        <span class="block">{t('hero.titleLine1')}</span>
        <span class="block">{t('hero.titleLine2')}</span>
        <span class="block text-cargo-emerald">{t('hero.titleLine3')}</span>
      </h1>
      <p class="mt-6 max-w-xl text-base leading-relaxed text-cargo-ink/75 sm:text-lg">{t('hero.subtitle')}</p>
      <p class="mt-4 max-w-xl font-mono text-xs italic text-cargo-deep/60 sm:text-sm">{t('hero.tagline')}</p>

      <div class="mt-10 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
        <a href={quotePath} class="btn-primary text-sm sm:text-base">
          {t('hero.ctaPrimary')}
          <span aria-hidden="true">↗</span>
        </a>
        <a href={servicesPath} class="btn-secondary text-sm sm:text-base">
          {t('hero.ctaSecondary')}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <figure class="relative aspect-[16/9] overflow-hidden bg-cargo-deep lg:aspect-auto lg:h-full">
      <img
        src="/assets/images/gse-fleet.webp"
        alt={t('hero.mediaAlt')}
        width="1280"
        height="720"
        class="absolute inset-0 h-full w-full object-cover"
        loading="eager"
      />
    </figure>
  </div>
</section>
