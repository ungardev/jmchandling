---
import type { Locale } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';
import { credentials } from '../../data/credentials';
import Credential from '../ui/Credential.astro';
import Section from '../ui/Section.astro';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const aboutPath = locale === 'es' ? '/es/sobre-jmc' : '/en/about-jmc';
---

<Section id="safety" class="scroll-mt-24" background="deep" padY="xl" ariaLabel={t('safety.sectionLabel')}>
  <span id="seguridad" class="sr-only" aria-hidden="true"></span>

  <div class="grid gap-14 lg:grid-cols-[1fr_1fr] lg:items-start lg:gap-20">
    <div>
      <p class="eyebrow eyebrow-on-dark">{t('safety.sectionLabel')}</p>
      <h2 class="type-h2 mt-5 max-w-xl text-balance text-cargo-white">{t('safety.title')}</h2>
      <p class="type-lead mt-6 max-w-xl text-cargo-white/90">{t('safety.subtitle')}</p>
      <p class="mt-8 max-w-xl border-l-4 border-cargo-emerald pl-6 text-base leading-relaxed text-cargo-white/90">
        {t('safety.intro')}
      </p>

      <div class="mt-12 grid gap-10 border-t border-cargo-light/20 pt-8 sm:grid-cols-2">
        <div>
          <h3 class="type-h3 text-cargo-white">{t('safety.smsLabel')}</h3>
          <p class="type-meta mt-3 max-w-lg text-cargo-white/80">{t('safety.smsText')}</p>
        </div>
        <div>
          <h3 class="type-h3 text-cargo-white">{t('safety.operatorLabel')}</h3>
          <p class="type-meta mt-3 max-w-lg text-cargo-white/80">{t('safety.operatorText')}</p>
        </div>
      </div>
    </div>

    <figure class="relative">
      <div class="overflow-hidden border border-cargo-light/20 bg-cargo-mist">
        <img
          src="/assets/photos/families/safety-sms-640.webp"
          srcset="/assets/photos/families/safety-sms-640.webp 640w, /assets/photos/families/safety-sms-1280.webp 1280w"
          sizes="(min-width: 1024px) 600px, 100vw"
          alt={t('media.alt.safetySms')}
          width="1280"
          height="966"
          class="h-auto w-full object-cover"
          loading="lazy"
          decoding="async"
        />
      </div>
      <figcaption class="flex flex-col gap-3 border-b border-x border-cargo-light/20 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
        <span class="font-mono text-xs uppercase tracking-[0.08em] text-cargo-white/85">{t('safety.teamCaption')}</span>
        <a
          href={aboutPath}
          class="inline-flex items-center gap-2 text-sm font-semibold text-cargo-light transition-colors hover:text-cargo-white"
        >
          {t('common.aboutCompanyLink')}
          <span aria-hidden="true">↗</span>
        </a>
      </figcaption>
    </figure>
  </div>

  <div class="mt-16 border-t border-cargo-light/20 pt-12 md:mt-20 md:pt-14">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div>
        <p class="eyebrow eyebrow-on-dark">{t('credentials.sectionLabel')}</p>
        <h3 class="type-h3 mt-4 max-w-xl text-cargo-white">{t('credentials.heading')}</h3>
      </div>
      <p class="font-mono text-sm text-cargo-light">
        {t('safety.rifLabel')}: {t('safety.rif')}
      </p>
    </div>

    <ul class="mt-10 grid gap-5 sm:grid-cols-2">
      {credentials.map((credential) => (
        <li class="flex">
          <Credential
            locale={locale}
            code={t(credential.codeKey)}
            title={t(credential.titleKey)}
            issuer={t(credential.issuerKey)}
            validity={credential.validityKey ? t(credential.validityKey) : undefined}
            evidenceHref={credential.evidenceHref}
          />
        </li>
      ))}
    </ul>

    <p class="type-meta mt-8 max-w-3xl text-cargo-white/80">{t('safety.certificationParagraph')}</p>
  </div>
</Section>
