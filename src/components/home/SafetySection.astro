---
import type { Locale } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';
import { credentials } from '../../data/credentials';
import ActionLink from '../ui/ActionLink.astro';
import CredentialMark from '../ui/CredentialMark.astro';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const aboutPath = locale === 'es' ? '/es/sobre-jmc' : '/en/about-jmc';
---

<section
  id="safety"
  class="scroll-mt-24 bg-cargo-deep py-20 text-cargo-white md:py-28"
  aria-labelledby="safety-heading"
>
  <span id="seguridad" class="sr-only" aria-hidden="true"></span>

  <div class="container-max">
    <div class="grid-12 items-end border-b border-cargo-light/20 pb-8">
      <h2 id="safety-heading" class="reveal type-h2 col-span-12 max-w-md text-balance text-cargo-white lg:col-span-5">
        {t('safety.title')}
      </h2>
      <p class="type-lead col-span-12 max-w-2xl text-cargo-white/85 lg:col-span-6 lg:col-start-7">
        {t('safety.subtitle')}
      </p>
    </div>

    <ul class="mt-10 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {
        credentials.map((credential) => (
          <li class="flex flex-col border-t border-cargo-light/20 pt-5">
            <CredentialMark name={credential.mark} class="h-12 w-12 text-cargo-light" />
            <p class="mt-6 font-mono text-sm font-semibold tracking-[0.02em] text-cargo-light">
              {t(credential.codeKey)}
            </p>
            <h3 class="type-h3 mt-2 text-balance text-cargo-white">{t(credential.titleKey)}</h3>
            <p class="type-body mt-2 text-cargo-white/75">{t(credential.issuerKey)}</p>
            {credential.validityKey && (
              <p class="type-meta mt-4 font-mono uppercase tracking-[0.08em] text-cargo-light/90">
                {t(credential.validityKey)}
              </p>
            )}
          </li>
        ))
      }
    </ul>

    <ActionLink href={aboutPath} tone="dark" class="mt-12">
      {t('safety.credentialsLink')}
    </ActionLink>
  </div>
</section>
