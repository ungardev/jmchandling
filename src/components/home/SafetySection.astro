---
import type { Locale } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';
import Badge from '../ui/Badge.astro';
import Section from '../ui/Section.astro';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Section id="seguridad" background="deep" padY="xl" ariaLabel={t('safety.sectionLabel')}>
  <div class="grid gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:items-start lg:gap-20">
    <div>
      <div class="flex flex-wrap gap-2">
        <Badge variant="cert" size="sm">{t('safety.ceseaBadge')}</Badge>
        <Badge variant="inac" size="sm">{t('safety.inacBadge')}</Badge>
        <Badge variant="sms" size="sm">{t('safety.rav111')}</Badge>
      </div>
      <p class="mt-8 font-mono text-xs uppercase tracking-[0.12em] text-cargo-light">{t('safety.sectionLabel')}</p>
      <h2 class="mt-5 max-w-xl text-balance text-4xl font-semibold leading-tight tracking-[-0.04em] text-cargo-white sm:text-5xl">{t('safety.title')}</h2>
      <p class="mt-6 max-w-xl text-base leading-relaxed text-cargo-white/75">{t('safety.subtitle')}</p>
      <p class="mt-8 max-w-xl border-l-4 border-cargo-emerald pl-5 text-sm leading-relaxed text-cargo-white/80">{t('safety.intro')}</p>

      <div class="mt-12 space-y-8">
        <div class="border-t border-cargo-light/20 pt-5">
          <h3 class="text-base font-semibold text-cargo-white">{t('safety.smsLabel')}</h3>
          <p class="mt-2 max-w-lg text-sm leading-relaxed text-cargo-white/65">{t('safety.smsText')}</p>
        </div>
        <div class="border-t border-cargo-light/20 pt-5">
          <h3 class="text-base font-semibold text-cargo-white">{t('safety.operatorLabel')}</h3>
          <p class="mt-2 max-w-lg text-sm leading-relaxed text-cargo-white/65">{t('safety.operatorText')}</p>
        </div>
      </div>
    </div>

    <figure class="relative">
      <div class="overflow-hidden border border-cargo-light/20 bg-cargo-mist">
        <img
          src="/assets/images/cesea-cert.webp"
          alt={t('safety.mediaAlt')}
          width="800"
          height="600"
          class="h-auto w-full object-cover"
          loading="lazy"
        />
      </div>
      <figcaption class="flex flex-col gap-3 border-b border-x border-cargo-light/20 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
        <span class="font-mono text-xs uppercase tracking-[0.08em] text-cargo-white/65">{t('safety.mediaCaption')}</span>
        <a href="/assets/images/cesea-cert.webp" target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-cargo-light transition-colors hover:text-cargo-white">{t('safety.mediaLink')} <span aria-hidden="true">↗</span></a>
      </figcaption>
    </figure>
  </div>
</Section>
