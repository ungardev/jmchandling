---
import type { Locale } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';
import { credentials } from '../../data/credentials';
import Section from '../ui/Section.astro';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const aboutPath = locale === 'es' ? '/es/sobre-jmc' : '/en/about-jmc';

const questions = [
  {
    key: 'cesea',
    questionKey: 'safety.qCesea',
    answerKey: 'safety.aCesea',
    credentialKey: 'cesea',
  },
  {
    key: 'rav111',
    questionKey: 'safety.qRav',
    answerKey: 'safety.aRav',
    credentialKey: 'rav111',
  },
  {
    key: 'inac',
    questionKey: 'safety.qInac',
    answerKey: 'safety.aInac',
    credentialKey: 'inac',
  },
  {
    key: 'sms',
    questionKey: 'safety.qSms',
    answerKey: 'safety.aSms',
    credentialKey: 'sms',
  },
] as const;

const credentialByKey = new Map(credentials.map((credential) => [credential.key, credential]));
---

<Section id="safety" class="scroll-mt-24" background="deep" padY="xl" ariaLabel={t('safety.sectionLabel')}>
  <span id="seguridad" class="sr-only" aria-hidden="true"></span>

  <div class="grid-12 items-start">
    <div class="col-span-12 lg:col-span-5">
      <p class="eyebrow eyebrow-on-dark">{t('safety.sectionLabel')}</p>
      <h2 class="reveal type-h2 mt-5 max-w-xl text-balance text-cargo-white">{t('safety.title')}</h2>
      <p class="type-lead mt-6 max-w-xl text-cargo-white/90">{t('safety.subtitle')}</p>

      <figure class="mt-12">
        <div class="overflow-hidden bg-cargo-ink">
          <img
            src="/assets/photos/families/safety-sms-640.webp"
            srcset="/assets/photos/families/safety-sms-640.webp 640w, /assets/photos/families/safety-sms-1280.webp 1280w"
            sizes="(min-width: 1024px) 40vw, 100vw"
            alt={t('media.alt.safetySms')}
            width="1280"
            height="966"
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full object-cover"
          />
        </div>
        <figcaption class="mt-3 flex flex-wrap items-center justify-between gap-3 font-mono text-xs uppercase tracking-[0.1em] text-cargo-white/85">
          <span>{t('safety.teamCaption')}</span>
          <a
            href={aboutPath}
            class="font-sans text-sm font-semibold normal-case tracking-normal text-cargo-light underline decoration-cargo-light/50 underline-offset-4 transition-colors hover:text-cargo-white"
          >
            {t('common.aboutCompanyLink')}
          </a>
        </figcaption>
      </figure>
    </div>

    <div class="col-span-12 mt-14 lg:col-span-6 lg:col-start-7 lg:mt-0">
      <p class="eyebrow eyebrow-on-dark">{t('safety.qaLabel')}</p>

      <dl class="mt-6">
        {
          questions.map((item) => {
            const credential = credentialByKey.get(item.credentialKey);
            return (
              <div class="border-t border-cargo-light/20 py-7">
                <dt class="type-h3 text-balance text-cargo-white">{t(item.questionKey)}</dt>
                <dd class="mt-3">
                  <p class="type-body max-w-2xl text-cargo-white/85">{t(item.answerKey)}</p>
                  {credential && (
                    <p class="mt-4 flex flex-wrap items-baseline gap-x-3 gap-y-1 font-mono text-xs uppercase tracking-[0.1em] text-cargo-light">
                      <span class="text-cargo-light">{t(credential.codeKey)}</span>
                      <span aria-hidden="true">·</span>
                      <span class="text-cargo-white/70">{t(credential.issuerKey)}</span>
                      {credential.validityKey && (
                        <>
                          <span aria-hidden="true">·</span>
                          <span class="text-cargo-white/70">{t(credential.validityKey)}</span>
                        </>
                      )}
                    </p>
                  )}
                </dd>
              </div>
            );
          })
        }
      </dl>
    </div>
  </div>
</Section>
