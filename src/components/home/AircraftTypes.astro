---
import type { Locale } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';
import Section from '../ui/Section.astro';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Section background="white" padY="lg" ariaLabel={t('services.aircraftTypesTitle')}>
  <div class="text-center">
    <p class="font-mono text-xs uppercase tracking-[0.12em] text-cargo-emerald">{t('services.aircraftTypesTitle')}</p>
    <p class="mt-4 max-w-3xl mx-auto text-base leading-relaxed text-cargo-ink/80">{t('services.aircraftTypesText')}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <span class="badge-cert">{t('services.aircraftTypesNarrow')}</span>
      <span class="badge-cert">{t('services.aircraftTypesWide')}</span>
      <span class="badge-cert">{t('services.aircraftTypesExec')}</span>
    </div>
  </div>
</Section>
