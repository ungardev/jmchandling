---
import type { Locale } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';
import {
  equipmentBeltLoader,
  equipmentCarrucha,
  equipmentGpu,
  equipmentTractor,
  equipmentTractorService,
  equipmentWaterCart,
} from '../../data/media.generated';
import ActionLink from '../ui/ActionLink.astro';
import Button from '../ui/Button.astro';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const quotePath = locale === 'es' ? '/es/contacto?intent=quote' : '/en/contact?intent=quote';

const equipment = [
  { key: 'carrucha', media: equipmentCarrucha },
  { key: 'tractor', media: equipmentTractor },
  { key: 'tractorService', media: equipmentTractorService },
  { key: 'water', media: equipmentWaterCart },
  { key: 'belt', media: equipmentBeltLoader },
  { key: 'gpu', media: equipmentGpu },
] as const;
---

<section id="equipment" class="scroll-mt-24 bg-cargo-white py-20 text-cargo-ink md:py-28" aria-labelledby="equipment-heading">
  <span id="equipos" class="sr-only" aria-hidden="true"></span>
  <div class="container-max">
    <div class="grid-12 items-end border-b border-cargo-deep/20 pb-8">
      <h2 id="equipment-heading" class="reveal type-h2 col-span-12 max-w-md text-cargo-deep lg:col-span-5">
        {t('home.equipmentHeading')}
      </h2>
      <p class="type-lead col-span-12 max-w-2xl text-cargo-ink/80 lg:col-span-6 lg:col-start-7">
        {t('home.equipmentIntro')}
      </p>
    </div>

    <ul class="mt-10 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {equipment.map(({ key, media }) => (
        <li id={`equipment-${key}`} class="group flex scroll-mt-24 flex-col border-t border-cargo-deep/20 pt-5">
          <div class="overflow-hidden bg-cargo-mist">
            <img
              src={media.src}
              srcset={media.srcset}
              sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 90vw"
              alt={t(media.altKey)}
              width={media.width}
              height={media.height}
              loading="lazy"
              decoding="async"
              class="aspect-[4/5] w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03] motion-reduce:transform-none motion-reduce:transition-none"
            />
          </div>
          <h3 class="type-h3 mt-5 text-cargo-deep">{t(`equipment.${key}Title`)}</h3>
          <p class="type-body mt-3 max-w-md text-cargo-ink/80">{t(`equipment.${key}Desc`)}</p>
        </li>
      ))}
    </ul>

    <div class="mt-14 grid-12 items-start border-t border-cargo-deep/20 pt-8">
      <div class="col-span-12 lg:col-span-5">
        <h3 class="type-h3 text-cargo-deep">{t('equipment.asuCtaTitle')}</h3>
        <p class="type-body mt-3 max-w-md text-cargo-ink/80">{t('equipment.asuCtaText')}</p>
      </div>
      <div class="col-span-12 lg:col-span-5 lg:col-start-8">
        <h3 class="type-h3 text-cargo-deep">{t('equipment.ctaTitle')}</h3>
        <p class="type-body mt-3 max-w-md text-cargo-ink/80">{t('equipment.ctaText')}</p>
        <Button href={quotePath} size="sm" class="mt-6" arrow>
          {t('quote.submit')}
        </Button>
      </div>
    </div>

    <ActionLink href="#services" class="mt-10">
      {t('home.equipmentCatalogLink')}
    </ActionLink>
  </div>
</section>
