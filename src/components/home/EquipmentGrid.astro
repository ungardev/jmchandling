---
import type { Locale } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';
import Section from '../ui/Section.astro';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const equipmentKeys = ['carrucha', 'tractor', 'water', 'belt', 'gpu', 'asu'] as const;
---

<Section background="mist" padY="xl" ariaLabel={t('equipment.sectionLabel')}>
  <div class="text-center">
    <p class="font-mono text-xs uppercase tracking-[0.12em] text-cargo-emerald">{t('equipment.sectionLabel')}</p>
    <h2 class="mt-4 max-w-2xl mx-auto text-balance text-4xl font-semibold tracking-[-0.04em] text-cargo-deep sm:text-5xl">{t('equipment.title')}</h2>
    <p class="mt-5 max-w-xl mx-auto text-base text-cargo-ink/70">{t('equipment.subtitle')}</p>
  </div>

  <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {equipmentKeys.map((key) => (
      <div class="border border-cargo-deep/15 bg-white p-6">
        <p class="font-mono text-xs uppercase tracking-[0.1em] text-cargo-emerald">{t(`equipment.${key}Title`)}</p>
        <p class="mt-3 text-sm leading-relaxed text-cargo-ink/75">{t(`equipment.${key}Desc`)}</p>
      </div>
    ))}
  </div>
</Section>
