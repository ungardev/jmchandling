---
import type { Locale } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';
import {
  equipmentBeltLoader,
  equipmentCarrucha,
  equipmentGpu,
  equipmentTractor,
  equipmentTractorService,
  equipmentWaterCart,
} from '../../data/media.generated';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const quotePath = locale === 'es' ? '/es/contacto?intent=quote' : '/en/contact?intent=quote';

const equipment = [
  { key: 'carrucha', media: equipmentCarrucha },
  { key: 'tractor', media: equipmentTractor },
  { key: 'tractorService', media: equipmentTractorService },
  { key: 'water', media: equipmentWaterCart },
  { key: 'belt', media: equipmentBeltLoader },
  { key: 'gpu', media: equipmentGpu },
] as const;
---

<section id="equipment" class="scroll-mt-24 bg-cargo-white py-16 md:py-20" aria-labelledby="equipment-heading">
  <span id="equipos" class="sr-only" aria-hidden="true"></span>
  <div class="container-max">
    <div class="grid gap-6 border-b border-cargo-deep/20 pb-7 md:grid-cols-[0.75fr_1.25fr] md:items-end">
      <h2 id="equipment-heading" class="max-w-md text-3xl font-semibold tracking-[-0.04em] text-cargo-deep sm:text-4xl">
        {t('home.equipmentHeading')}
      </h2>
      <p class="max-w-2xl text-base leading-relaxed text-cargo-ink/75">{t('home.equipmentIntro')}</p>
    </div>

    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {equipment.map(({ key, media }) => (
        <li id={`equipment-${key}`} class="group flex scroll-mt-24 flex-col overflow-hidden border border-cargo-deep/15 bg-cargo-white">
          <div class="relative aspect-[4/5] overflow-hidden bg-cargo-mist">
            <img
              src={media.src}
              srcset={media.srcset}
              sizes="(min-width: 1280px) 280px, (min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
              alt={t(media.altKey)}
              width={media.width}
              height={media.height}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03] motion-reduce:transform-none motion-reduce:transition-none"
            />
          </div>
          <div class="flex flex-1 flex-col border-t border-cargo-deep/15 p-5">
            <h3 class="font-semibold tracking-[-0.02em] text-cargo-deep">{t(`equipment.${key}Title`)}</h3>
            <p class="mt-2 text-sm leading-relaxed text-cargo-ink/75">{t(`equipment.${key}Desc`)}</p>
          </div>
        </li>
      ))}

      <li class="flex flex-col justify-between border border-cargo-emerald/50 bg-cargo-mist p-5">
        <div>
          <span class="badge-cert">{t('equipment.ctaLabel')}</span>
          <h3 class="mt-4 font-semibold tracking-[-0.02em] text-cargo-deep">{t('equipment.asuCtaTitle')}</h3>
          <p class="mt-2 text-sm leading-relaxed text-cargo-ink/75">{t('equipment.asuCtaText')}</p>
        </div>
        <a
          href={quotePath}
          class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-cargo-deep underline decoration-cargo-emerald underline-offset-4 transition-colors hover:text-cargo-ink"
        >
          {t('equipment.ctaTitle')}
          <span aria-hidden="true">↗</span>
        </a>
      </li>
    </ul>

    <a
      href="#services"
      class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-cargo-deep underline decoration-cargo-emerald underline-offset-4 transition-colors hover:text-cargo-ink"
    >
      {t('home.equipmentCatalogLink')}
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>
