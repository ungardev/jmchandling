---
import type { Locale } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const servicesPath = locale === 'es' ? '/es/servicios' : '/en/services';
const equipmentKeys = ['carrucha', 'tractor', 'water', 'belt', 'gpu', 'asu'] as const;
---

<section id="equipos" class="scroll-mt-24 bg-cargo-white py-16 md:py-20" aria-labelledby="equipment-heading">
  <div class="container-max">
    <div class="grid gap-6 border-b border-cargo-deep/20 pb-7 md:grid-cols-[0.75fr_1.25fr] md:items-end">
      <h2 id="equipment-heading" class="max-w-md text-3xl font-semibold tracking-[-0.04em] text-cargo-deep sm:text-4xl">
        {t('home.equipmentHeading')}
      </h2>
      <p class="max-w-2xl text-base leading-relaxed text-cargo-ink/75">{t('home.equipmentIntro')}</p>
    </div>

    <dl class="mt-2 divide-y divide-cargo-deep/15">
      {equipmentKeys.map((key) => (
        <div class="grid gap-2 py-5 sm:grid-cols-[minmax(220px,0.44fr)_1fr] sm:gap-8">
          <dt class="font-semibold text-cargo-deep">{t(`equipment.${key}Title`)}</dt>
          <dd class="text-sm leading-relaxed text-cargo-ink/75">{t(`equipment.${key}Desc`)}</dd>
        </div>
      ))}
    </dl>

    <a href={`${servicesPath}#ramp-gse`} class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-cargo-deep underline decoration-cargo-emerald underline-offset-4 transition-colors hover:text-cargo-emerald">
      {t('home.equipmentCatalogLink')}
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>
