---
import type { Locale } from '../../i18n/utils';
import { getLocalizedArray, useTranslations } from '../../i18n/utils';
import { getService, serviceFamilies, type ServiceFamilyKey } from '../../data/siteContent';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const quotePath = locale === 'es' ? '/es/contacto?intent=quote' : '/en/contact?intent=quote';
const familyActionKeys: Record<ServiceFamilyKey, string> = {
  'ramp-gse': 'home.actionGse',
  'aircraft-care': 'home.actionAircraftCare',
  'fbo-operations': 'home.actionObf',
  'passenger-services': 'home.actionPassengers',
  'gse-maintenance': 'home.actionMaintenance',
};
const specialServices = [
  ...getLocalizedArray(locale, 'services.specialHeadlineBullets'),
  ...getLocalizedArray(locale, 'services.specialBullets'),
];
---

<section id="services" class="scroll-mt-24 bg-cargo-mist py-16 text-cargo-ink md:py-20" aria-labelledby="task-heading">
  <span id="capacidades" class="sr-only" aria-hidden="true"></span>
  <div class="container-max">
    <div class="mb-8 flex flex-col justify-between gap-5 border-b border-cargo-deep/20 pb-6 md:flex-row md:items-end">
      <div class="max-w-2xl">
        <h2 id="task-heading" class="type-h2 max-w-2xl text-balance text-cargo-deep">
          {t('home.taskHeading')}
        </h2>
        <p class="type-lead mt-4 max-w-xl text-cargo-ink/80">
          {t('home.taskIntro')}
        </p>
      </div>
      <a href={quotePath} class="inline-flex shrink-0 items-center gap-3 text-sm font-semibold text-cargo-deep underline decoration-cargo-emerald/70 underline-offset-4 transition-colors hover:text-cargo-ink">
        {t('home.openCatalog')}
        <span aria-hidden="true">↗</span>
      </a>
    </div>

    <div class="grid items-start gap-9 lg:grid-cols-[minmax(0,1.12fr)_minmax(340px,0.88fr)] lg:gap-14">
      <div class="divide-y divide-cargo-deep/15 border-y border-cargo-deep/15">
        {serviceFamilies.map((family) => (
          <article id={family.key} class="scroll-mt-24 py-6 sm:py-7">
            <div class="grid gap-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-start">
              <div>
                <h3 class="type-h3 text-cargo-deep">{t(family.titleKey)}</h3>
                <p class="type-body mt-3 max-w-2xl text-cargo-ink/80">{t(family.descriptionKey)}</p>
                {family.serviceKeys.length > 0 && (
                  <p class="type-meta mt-3 text-cargo-ink/75">
                    {family.serviceKeys.map((serviceKey) => {
                      const service = getService(serviceKey);
                      return service ? t(service.titleKey) : '';
                    }).filter(Boolean).join(' · ')}
                  </p>
                )}
              </div>
              <a
                href={`${quotePath}&service=${encodeURIComponent(family.key)}`}
                class="inline-flex items-center gap-2 text-sm font-semibold text-cargo-deep underline decoration-cargo-emerald underline-offset-4 transition-colors hover:text-cargo-ink"
                aria-label={`${t(familyActionKeys[family.key])}: ${t(family.titleKey)}`}
              >
                {t(familyActionKeys[family.key])}
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        ))}
      </div>

      <aside class="border-l-2 border-cargo-emerald pl-6 sm:pl-8">
        <h3 class="type-h3 max-w-md text-cargo-deep">
          {t('home.specialAsideTitle')}
        </h3>
        <p class="type-body mt-4 text-cargo-ink/80">
          {t('home.specialAsideLead')} {specialServices.join('; ')}.
        </p>
        <a href="#passenger-services" class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-cargo-deep underline decoration-cargo-emerald underline-offset-4 transition-colors hover:text-cargo-ink">
          {t('home.viewSpecialScope')}
          <span aria-hidden="true">↗</span>
        </a>
      </aside>
    </div>
  </div>
</section>
