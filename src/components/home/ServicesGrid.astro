---
import type { Locale } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';
import { getService, serviceFamilies } from '../../data/siteContent';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const servicesPath = locale === 'es' ? '/es/servicios' : '/en/services';
---

<section class="section-pad bg-cargo-mist text-cargo-ink" id="servicios" aria-labelledby="services-heading">
  <div class="container-max">
    <div class="grid gap-8 border-b border-cargo-deep/15 pb-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
      <p class="font-mono text-xs uppercase tracking-[0.12em] text-cargo-deep/65">{t('services.sectionLabel')}</p>
      <div>
        <h2 id="services-heading" class="max-w-3xl text-balance text-4xl font-semibold leading-tight tracking-[-0.04em] text-cargo-deep sm:text-5xl">{t('services.title')}</h2>
        <p class="mt-5 max-w-2xl text-base leading-relaxed text-cargo-ink/70">{t('services.subtitle')}</p>
      </div>
    </div>

    <div class="mt-12 grid gap-12 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-16">
      <figure class="self-start lg:sticky lg:top-28">
        <div class="relative aspect-[4/5] overflow-hidden bg-cargo-deep">
          {serviceFamilies.map((family, index) => (
            <img
              src={family.media}
              data-family-media={family.key}
              data-alt={t(family.mediaAltKey)}
              alt={index === 0 ? t(family.mediaAltKey) : ''}
              aria-hidden={index === 0 ? undefined : 'true'}
              width="1280"
              height="720"
              class:list={['absolute inset-0 h-full w-full object-cover transition-opacity duration-500', index === 0 ? 'opacity-100' : 'opacity-0']}
              loading={index === 0 ? 'eager' : 'lazy'}
            />
          ))}
          <div class="absolute inset-0 bg-gradient-to-t from-cargo-ink/85 via-transparent to-transparent" aria-hidden="true"></div>
          <figcaption class="absolute bottom-0 left-0 right-0 border-t border-cargo-white/20 px-5 py-4 font-mono text-[10px] uppercase tracking-[0.1em] text-cargo-white/80 sm:px-6">
            {t('services.mediaLabel')}
          </figcaption>
        </div>
      </figure>

      <div class="border-t border-cargo-deep/15">
        {serviceFamilies.map((family, index) => (
          <article
            data-capability-row={family.key}
            class="group border-b border-cargo-deep/15 py-7 transition-colors duration-200 hover:bg-cargo-emerald/10 focus-within:bg-cargo-emerald/10 sm:py-8"
          >
            <div class="grid gap-5 sm:grid-cols-[3.5rem_minmax(0,1fr)_auto] sm:items-start">
              <p class="font-mono text-sm text-cargo-deep/55">[{String(index + 1).padStart(2, '0')}]</p>
              <div>
                <p class="font-mono text-[10px] uppercase tracking-[0.1em] text-cargo-emerald">{t('services.familyLabel')}</p>
                <h3 class="mt-2 text-2xl font-semibold tracking-[-0.03em] text-cargo-deep transition-colors group-hover:text-cargo-ink">{t(family.titleKey)}</h3>
                <p class="mt-3 max-w-2xl text-sm leading-relaxed text-cargo-ink/70">{t(family.descriptionKey)}</p>
                <p class="mt-4 text-xs leading-relaxed text-cargo-ink/55">
                  {family.serviceKeys.map((serviceKey) => {
                    const service = getService(serviceKey);
                    return service ? t(service.titleKey) : '';
                  }).filter(Boolean).join(' · ')}
                </p>
              </div>
              <a href={`${servicesPath}#${family.key}`} class="inline-flex items-center gap-2 justify-self-start text-sm font-semibold text-cargo-deep transition-colors hover:text-cargo-emerald sm:justify-self-end" aria-label={`${t('services.viewFamily')}: ${t(family.titleKey)}`}>
                <span>{t('services.viewFamily')}</span>
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script is:inline>
  const capabilityRows = Array.from(document.querySelectorAll('[data-capability-row]'));
  const capabilityMedia = Array.from(document.querySelectorAll('[data-family-media]'));

  const setActiveFamily = (familyKey) => {
    capabilityMedia.forEach((media) => {
      const isActive = media.dataset.familyMedia === familyKey;
      media.classList.toggle('opacity-100', isActive);
      media.classList.toggle('opacity-0', !isActive);
      media.setAttribute('aria-hidden', isActive ? 'false' : 'true');
      media.setAttribute('alt', isActive ? media.dataset.alt ?? '' : '');
    });
  };

  capabilityRows.forEach((row) => {
    const familyKey = row.dataset.capabilityRow;
    if (!familyKey) return;
    row.addEventListener('mouseenter', () => setActiveFamily(familyKey));
    row.addEventListener('focusin', () => setActiveFamily(familyKey));
  });
</script>
