---
import type { Locale } from '../../i18n/utils';
import { getLocalizedArray, useTranslations } from '../../i18n/utils';
import { getService, serviceFamilies, type ServiceFamilyKey } from '../../data/siteContent';
import ActionLink from '../ui/ActionLink.astro';
import Button from '../ui/Button.astro';
import IndexLabel from '../ui/IndexLabel.astro';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const quotePath = locale === 'es' ? '/es/contacto?intent=quote' : '/en/contact?intent=quote';
const familyActionKeys: Record<ServiceFamilyKey, string> = {
  'ramp-gse': 'home.actionGse',
  'aircraft-care': 'home.actionAircraftCare',
  'fbo-operations': 'home.actionObf',
  'passenger-services': 'home.actionPassengers',
  'gse-maintenance': 'home.actionMaintenance',
};
const specialServices = [
  ...getLocalizedArray(locale, 'services.specialHeadlineBullets'),
  ...getLocalizedArray(locale, 'services.specialBullets'),
];
---

<section id="services" class="scroll-mt-24 bg-cargo-mist py-16 text-cargo-ink md:py-20" aria-labelledby="task-heading">
  <span id="capacidades" class="sr-only" aria-hidden="true"></span>
  <div class="container-max">
    <div class="grid-12 items-end border-b border-cargo-deep/20 pb-8">
      <div class="col-span-12 lg:col-span-7">
        <h2 id="task-heading" class="type-h2 max-w-2xl text-balance text-cargo-deep">
          {t('home.taskHeading')}
        </h2>
        <p class="type-lead mt-5 max-w-xl text-cargo-ink/80">
          {t('home.taskIntro')}
        </p>
      </div>
      <div class="col-span-12 lg:col-span-3 lg:col-start-10">
        <Button href={quotePath} variant="secondary" size="sm" arrow>
          {t('home.openCatalog')}
        </Button>
      </div>
    </div>

    <div class="mt-10 grid-12 items-start">
      <div class="col-span-12 lg:col-span-7">
        {serviceFamilies.map((family, position) => (
          <article
            id={family.key}
            class="scroll-mt-24 border-t border-cargo-deep/20 py-8 first:border-t-0 first:pt-0"
          >
            <div class="grid grid-cols-12 gap-x-6 gap-y-4">
              <div class="col-span-3 sm:col-span-2 lg:col-span-1">
                <IndexLabel index={String(position + 1).padStart(2, '0')} />
              </div>
              <div class="col-span-9 sm:col-span-10 lg:col-span-5">
                <h3 class="type-h3 text-cargo-deep">{t(family.titleKey)}</h3>
                <p class="type-body mt-3 max-w-xl text-cargo-ink/80">{t(family.descriptionKey)}</p>
              </div>
              <div class="col-span-12 lg:col-span-3">
                <p class="type-meta text-cargo-ink/75">
                  {family.serviceKeys
                    .map((serviceKey) => {
                      const service = getService(serviceKey);
                      return service ? t(service.titleKey) : '';
                    })
                    .filter(Boolean)
                    .join(' · ')}
                </p>
              </div>
              <div class="col-span-12 lg:col-span-3 lg:text-right">
                <ActionLink
                  href={`${quotePath}&service=${encodeURIComponent(family.key)}`}
                  aria-label={`${t(familyActionKeys[family.key])}: ${t(family.titleKey)}`}
                >
                  {t(familyActionKeys[family.key])}
                </ActionLink>
              </div>
            </div>
          </article>
        ))}
      </div>

      <aside class="col-span-12 mt-12 lg:col-span-4 lg:col-start-9 lg:mt-0">
        <h3 class="type-h3 text-cargo-deep">
          {t('home.specialAsideTitle')}
        </h3>
        <p class="type-body mt-3 text-cargo-ink/80">
          {t('home.specialAsideLead')}
        </p>
        <ul class="mt-6 grid gap-x-8 gap-y-3 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
          {specialServices.map((service) => (
            <li class="border-t border-cargo-deep/20 pt-2 text-sm leading-snug text-cargo-ink/85">
              {service}
            </li>
          ))}
        </ul>
        <ActionLink href="#passenger-services" class="mt-6">
          {t('home.viewSpecialScope')}
        </ActionLink>
      </aside>
    </div>
  </div>
</section>
