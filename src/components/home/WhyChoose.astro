---
import type { Locale } from '../../i18n/utils';
import { useTranslations, getLocalizedObject } from '../../i18n/utils';
import Section from '../ui/Section.astro';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const reasons = getLocalizedObject<Record<string, { title: string; text: string }>>(locale, 'whyChoose.reasons');
const reasonKeys = ['fleet', 'maintenance', 'certs', 'team', 'tailorMade', 'reliability'] as const;
---

<Section background="mist" padY="xl" ariaLabel={t('whyChoose.sectionLabel')}>
  <div class="text-center">
    <p class="font-mono text-xs uppercase tracking-[0.12em] text-cargo-emerald">{t('whyChoose.sectionLabel')}</p>
    <h2 class="mt-5 max-w-3xl mx-auto text-balance text-4xl font-semibold leading-tight tracking-[-0.04em] text-cargo-deep sm:text-5xl">{t('whyChoose.title')}</h2>
    <p class="mt-5 max-w-2xl mx-auto text-base text-cargo-ink/70">{t('whyChoose.subtitle')}</p>
  </div>

  <div class="mt-16 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {reasonKeys.map((key, index) => (
      <div class="group relative border-t-2 border-cargo-emerald pt-6">
        <span class="font-mono text-xs text-cargo-emerald/60" aria-hidden="true">
          {String(index + 1).padStart(2, '0')}
        </span>
        <h3 class="mt-3 text-lg font-semibold text-cargo-deep">{reasons[key].title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-cargo-ink/70">{reasons[key].text}</p>
      </div>
    ))}
  </div>
</Section>
