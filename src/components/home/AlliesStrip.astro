---
import type { Locale } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';
import { allies } from '../../data/allies';
import Section from '../ui/Section.astro';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Section id="allies" class="scroll-mt-24" background="white" padY="lg" ariaLabel={t('allies.sectionLabel')}>
  <div class="text-center">
    <p class="eyebrow eyebrow-on-light">{t('allies.sectionLabel')}</p>
    <h2 class="mt-4 text-balance text-2xl font-semibold tracking-[-0.02em] text-cargo-deep sm:text-3xl">{t('allies.title')}</h2>
    <p class="mt-3 max-w-xl mx-auto text-sm text-cargo-ink/75">{t('allies.subtitle')}</p>
  </div>

  <ul class="mt-12 flex flex-wrap items-center justify-center gap-x-12 gap-y-8 md:gap-x-16">
    {allies.map((ally) => (
      <li class="group flex items-center justify-center">
        <img
          src={ally.logo}
          alt={ally.name}
          width={ally.width}
          height={ally.height}
          style={`height:${ally.displayHeight}px;width:auto`}
          class={`max-w-[220px] object-contain transition-opacity duration-300 md:max-w-none ${ally.wordmark ? 'opacity-80' : 'opacity-95'} group-hover:opacity-100`}
          loading="lazy"
          decoding="async"
        />
      </li>
    ))}
  </ul>
</Section>
