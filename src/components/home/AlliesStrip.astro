---
import type { Locale } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';
import { allies } from '../../data/allies';
import Section from '../ui/Section.astro';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Section id="allies" class="scroll-mt-24" background="white" padY="lg" ariaLabel={t('allies.sectionLabel')}>
  <div class="grid-12 items-end">
    <div class="col-span-12 lg:col-span-4">
      <h2 class="reveal type-h2 max-w-md text-balance text-cargo-deep">{t('allies.title')}</h2>
      <p class="type-lead mt-5 max-w-md text-cargo-ink/80">{t('allies.subtitle')}</p>
    </div>

    <div class="col-span-12 lg:col-span-7 lg:col-start-6">
      <ul class="grid grid-cols-2 gap-x-10 gap-y-8 sm:grid-cols-3">
        {allies.map((ally) => (
          <li class="flex items-end border-t border-cargo-deep/20 pt-5">
            <img
              src={ally.logo}
              alt={ally.name}
              width={ally.width}
              height={ally.height}
              style={`height:${ally.displayHeight}px;width:auto`}
              class={`max-w-[220px] object-contain transition-opacity duration-300 ${ally.wordmark ? 'opacity-80' : 'opacity-95'} hover:opacity-100`}
              loading="lazy"
              decoding="async"
            />
          </li>
        ))}
      </ul>
    </div>
  </div>
</Section>
