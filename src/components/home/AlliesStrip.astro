---
import type { Locale } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';
import { allies } from '../../data/allies';
import Section from '../ui/Section.astro';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Section background="white" padY="lg" ariaLabel={t('allies.sectionLabel')}>
  <div class="text-center">
    <p class="font-mono text-xs uppercase tracking-[0.12em] text-cargo-emerald">{t('allies.sectionLabel')}</p>
    <h2 class="mt-4 text-balance text-2xl font-semibold tracking-[-0.02em] text-cargo-deep sm:text-3xl">{t('allies.title')}</h2>
    <p class="mt-3 max-w-xl mx-auto text-sm text-cargo-ink/70">{t('allies.subtitle')}</p>
  </div>

  <div class="mt-12 flex flex-wrap items-center justify-center gap-10 md:gap-16">
    {allies.map((ally) => (
      <div class="group flex h-16 w-auto items-center justify-center opacity-70 transition-opacity duration-300 hover:opacity-100">
        <img
          src={ally.logo}
          alt={ally.name}
          width="160"
          height="48"
          class="h-full w-auto object-contain"
          loading="lazy"
        />
      </div>
    ))}
  </div>
</Section>
