---
import type { Locale } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';
import { allies } from '../../data/allies';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<!-- Cinta de aliados: liston horizontal en movimiento continuo.

     No es un carrusel: no hay paginacion, ni posiciones, ni flechas. La
     cinta recorre su propio ciclo en CSS y se detiene al hover o al foco.

     La copia duplicada del listado lleva aria-hidden, de modo que el
     lector de pantalla anuncie seis logos y no doce.

     Fondo blanco obligatorio: los logotipos oficiales son de color y sobre
     cargo-deep el wordmark de Aerotur (#0F3E51) seria invisible (1.00:1).
     Sobre blanco los seis superan 3:1 (WCAG 1.4.11). -->
<section id="allies" class="relative isolate scroll-mt-24 bg-cargo-white pb-24 sm:pb-28 lg:pb-32">
  <div class="container-max pt-24 sm:pt-28 lg:pt-32">
    <h2 class="type-h2 mx-auto max-w-4xl text-center text-balance text-cargo-deep">
      {t('allies.title')}
    </h2>
  </div>

  <div
    class="ally-marquee mt-12 sm:mt-14"
    role="group"
    tabindex="0"
    aria-label={t('allies.ariaLabel')}
  >
    <ul class="ally-marquee-track">
      {allies.map((ally) => (
        <li class="ally-marquee-item">
          <img
            src={ally.logo}
            alt={ally.name}
            width={ally.width}
            height={ally.height}
            style={`--ally-h: ${ally.displayHeight}px; --ally-cap: ${ally.capOffset}px`}
            class={`ally-logo ${ally.wordmark ? 'opacity-75' : ''}`}
            loading="lazy"
            decoding="async"
          />
        </li>
      ))}
    </ul>
    <ul class="ally-marquee-track" aria-hidden="true">
      {allies.map((ally) => (
        <li class="ally-marquee-item">
          <img
            src={ally.logo}
            alt=""
            width={ally.width}
            height={ally.height}
            style={`--ally-h: ${ally.displayHeight}px; --ally-cap: ${ally.capOffset}px`}
            class={`ally-logo ${ally.wordmark ? 'opacity-75' : ''}`}
            loading="lazy"
            decoding="async"
          />
        </li>
      ))}
    </ul>
  </div>
</section>
