---
import type { Locale } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';
import { allies } from '../../data/allies';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<!-- Seccion a pantalla completa. Fondo blanco obligatorio: los logotipos
     oficiales son de color y sobre cargo-deep el wordmark de Aerotur
     (#0F3E51) seria invisible (1.00:1). Sobre blanco los seis superan
     3:1 (WCAG 1.4.11). -->
<section id="allies" class="hero-full relative isolate flex flex-col scroll-mt-24 bg-cargo-white">
  <div class="container-max flex w-full flex-1 flex-col justify-center py-24 sm:py-28 lg:py-32">
    <div class="grid-12 items-end gap-y-6">
      <div class="col-span-12 lg:col-span-5">
        <p class="eyebrow eyebrow-on-light">{t('allies.sectionLabel')}</p>
        <h2 class="type-h2 mt-4 max-w-md text-balance text-cargo-deep">{t('allies.title')}</h2>
      </div>
      <div class="col-span-12 lg:col-span-6 lg:col-start-7">
        <p class="type-lead max-w-md text-cargo-ink/80">{t('allies.subtitle')}</p>
      </div>
    </div>

    <ul class="reveal mt-12 grid grid-cols-1 gap-x-6 gap-y-7 sm:grid-cols-2 lg:mt-14 xl:grid-cols-3">
      {allies.map((ally) => (
        <li class="flex items-center border-t border-cargo-deep/20 pt-5">
          <img
            src={ally.logo}
            alt={ally.name}
            width={ally.width}
            height={ally.height}
            style={`--ally-h: ${ally.displayHeight}px`}
            class={`ally-logo ${ally.wordmark ? 'opacity-75' : ''} transition-opacity duration-300 hover:opacity-100`}
            loading="lazy"
            decoding="async"
          />
        </li>
      ))}
    </ul>
  </div>
</section>
