---
import type { Locale } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const proofPoints = [
  { value: t('proof.certificationValue'), label: t('proof.certificationLabel') },
  { value: t('proof.stationValue'), label: t('proof.stationLabel') },
  { value: t('proof.foundedValue'), label: t('proof.foundedLabel') },
  { value: t('proof.experienceValue'), label: t('proof.experienceLabel') },
];
---

<section class="border-y border-cargo-deep/15 bg-cargo-white" aria-label={t('proof.sectionLabel')}>
  <div class="container-max">
    <div class="grid grid-cols-2 md:grid-cols-4">
      {proofPoints.map((point, index) => (
        <div class:list={['min-h-32 border-cargo-deep/15 px-4 py-7 sm:px-6 md:px-8', index > 0 && 'border-l']}>
          <dt class="font-mono text-2xl font-medium tracking-[-0.04em] text-cargo-deep sm:text-3xl">{point.value}</dt>
          <dd class="mt-3 text-xs uppercase tracking-[0.08em] text-cargo-ink/60">{point.label}</dd>
        </div>
      ))}
    </div>
  </div>
</section>
