---
import type { Locale } from '../../i18n/utils';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const stats = [
  {
    value: '+12',
    label: locale === 'es' ? 'Años en Operación' : 'Years Operating',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />`,
  },
  {
    value: '+120',
    label: locale === 'es' ? 'Profesionales Certificado' : 'Certified Professionals',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />`,
  },
  {
    value: '+80',
    label: locale === 'es' ? 'Operaciones Diarias' : 'Daily Operations',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />`,
  },
  {
    value: '1',
    label: locale === 'es' ? 'Estación Principal' : 'Main Station',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />`,
  },
];
---

<section class="bg-cargo-deep border-y border-white/5" aria-label={locale === 'es' ? 'Estadísticas' : 'Statistics'}>
  <div class="container-max">
    <dl class="grid grid-cols-2 lg:grid-cols-4 divide-x divide-white/10">
      {stats.map((stat) => (
        <div class="flex items-center gap-4 px-6 py-10 first:pl-0 last:pr-0">
          <div class="w-12 h-12 rounded-xl bg-cargo-emerald/15 flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-cargo-emerald" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" set:html={stat.icon} />
          </div>
          <div>
            <dt class="text-3xl font-extrabold text-white">{stat.value}</dt>
            <dd class="text-xs text-white/50 mt-0.5">{stat.label}</dd>
          </div>
        </div>
      ))}
    </dl>
  </div>
</section>
