---
import type { Locale } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';
import Section from '../ui/Section.astro';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Section id="empresa" class="scroll-mt-24" background="deep" padY="lg" ariaLabel={t('home.companyTitle')}>
  <div class="grid gap-12 lg:grid-cols-[0.96fr_1.04fr] lg:gap-16">
    <div>
      <h2 class="max-w-xl text-balance text-3xl font-semibold tracking-[-0.04em] text-cargo-white sm:text-4xl">
        {t('home.companyTitle')}
      </h2>
      <p class="mt-5 max-w-xl text-base leading-relaxed text-cargo-white/85">{t('home.companyIntro')}</p>
      <p class="mt-4 max-w-xl text-sm leading-relaxed text-cargo-white/75">{t('home.companyHistory')}</p>

      <div class="mt-8 grid gap-6 border-t border-cargo-white/20 pt-6 sm:grid-cols-2">
        <div>
          <h3 class="font-mono text-xs uppercase tracking-[0.12em] text-cargo-light">{t('home.missionLabel')}</h3>
          <p class="mt-3 text-sm leading-relaxed text-cargo-white/85">{t('home.mission')}</p>
        </div>
        <div>
          <h3 class="font-mono text-xs uppercase tracking-[0.12em] text-cargo-light">{t('home.visionLabel')}</h3>
          <p class="mt-3 text-sm leading-relaxed text-cargo-white/85">{t('home.vision')}</p>
        </div>
      </div>

      <p class="mt-7 border-t border-cargo-white/15 pt-5 text-sm leading-relaxed text-cargo-white/75">
        <span class="font-semibold text-cargo-white">{t('home.valuesLabel')} </span>
        {t('home.values')}
      </p>
    </div>

    <div class="flex flex-col justify-center border-t border-cargo-white/20 pt-8 lg:border-l lg:border-t-0 lg:pl-12 lg:pt-0">
      <p class="flex flex-wrap gap-x-7 gap-y-3 font-mono text-sm text-cargo-light">
        <span>{t('safety.inacBadge')}</span>
        <span>{t('safety.rav111')}</span>
        <span>{t('safety.ceseaBadge')}</span>
      </p>
      <h3 class="mt-7 max-w-lg text-2xl font-semibold tracking-[-0.025em] text-cargo-white">{t('home.documentTitle')}</h3>
      <p class="mt-3 max-w-lg text-sm leading-relaxed text-cargo-white/80">{t('home.documentDescription')}</p>

      <figure class="mt-7 flex items-center gap-5 border border-cargo-white/15 bg-cargo-white/5 p-4 sm:gap-7 sm:p-5">
        <img
          src="/assets/images/cesea-cert.webp"
          alt={t('home.certificateAlt')}
          width="800"
          height="600"
          class="h-24 w-32 shrink-0 border border-cargo-white/15 bg-cargo-white object-cover object-top sm:h-32 sm:w-44"
          loading="lazy"
        />
        <figcaption>
          <p class="font-mono text-xs uppercase tracking-[0.1em] text-cargo-light">{t('home.evidenceCaption')}</p>
          <p class="mt-2 text-sm leading-relaxed text-cargo-white/85">{t('home.documentIssuer')}</p>
          <a
            class="mt-3 inline-flex items-center gap-2 text-sm font-semibold text-cargo-white underline decoration-cargo-emerald underline-offset-4 transition-colors hover:text-cargo-light"
            href="/assets/images/cesea-cert.webp"
            target="_blank"
            rel="noopener noreferrer"
          >
            {t('safety.mediaLink')}
            <span aria-hidden="true">↗</span>
          </a>
        </figcaption>
      </figure>
    </div>
  </div>
</Section>
