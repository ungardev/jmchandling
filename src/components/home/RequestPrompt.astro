---
import type { Locale } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';
import Button from '../ui/Button.astro';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const quotePath = locale === 'es' ? '/es/contacto?intent=quote' : '/en/contact?intent=quote';
---

<section id="contact" class="scroll-mt-24 bg-cargo-white text-cargo-ink" aria-labelledby="request-heading">
  <div class="container-max py-20 md:py-28">
    <div class="grid-12 items-start border-t border-cargo-deep/20 pt-10">
      <div class="col-span-12 lg:col-span-6">
        <h2 id="request-heading" class="reveal type-h2 max-w-xl text-balance text-cargo-deep">
          {t('home.requestTitle')}
        </h2>
        <p class="type-lead mt-5 max-w-lg text-cargo-ink/80">{t('home.requestDescription')}</p>
        <Button href={quotePath} class="mt-8" arrow>
          {t('quote.submit')}
        </Button>
      </div>

      {/* Rail de contacto: una sola linea, no una ficha. El bloque completo
          vive en el pie y en la pagina de contacto. */}
      <div class="col-span-12 mt-12 lg:col-span-5 lg:col-start-8 lg:mt-0">
        <p class="font-mono text-xs uppercase tracking-[0.1em] text-cargo-deep/70">
          {t('company.hoursLabel')}
        </p>
        <p class="mt-2 font-mono text-sm text-cargo-deep">{t('company.hours')}</p>

        <ul class="mt-6 flex flex-wrap items-baseline gap-x-3 gap-y-2 font-mono text-sm text-cargo-ink/80">
          <li>
            <a
              href={`tel:${t('company.phoneVzla').replaceAll(' ', '')}`}
              class="transition-colors hover:text-cargo-ink"
            >
              {t('company.phoneVzla')}
            </a>
          </li>
          <li aria-hidden="true" class="text-cargo-deep/60">·</li>
          <li>
            <a
              href={`tel:${t('company.phoneUsa').replaceAll(' ', '')}`}
              class="transition-colors hover:text-cargo-ink"
            >
              {t('company.phoneUsa')}
            </a>
          </li>
          <li aria-hidden="true" class="text-cargo-deep/60">·</li>
          <li>
            <a
              href={`mailto:${t('company.email')}`}
              class="transition-colors hover:text-cargo-ink"
            >
              {t('company.email')}
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
