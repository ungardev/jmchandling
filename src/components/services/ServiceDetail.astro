---
import type { Locale } from '../../i18n/utils';

export interface Props {
  locale: Locale;
  id: string;
  index: string;
  title: string;
  description: string;
  bullets: string[];
  bullethead?: string[];
  familyLabel: string;
  href: string;
  actionLabel: string;
}

const { id, index, title, description, bullets, bullethead, familyLabel, href, actionLabel } = Astro.props;
---

<article id={id} class="border-b border-cargo-deep/15 py-8 first:border-t sm:py-10">
  <div class="grid gap-6 lg:grid-cols-[4rem_minmax(0,1fr)_auto] lg:items-start lg:gap-8">
    <p class="font-mono text-sm text-cargo-deep/50">[{index}]</p>
    <div>
      <p class="font-mono text-[10px] uppercase tracking-[0.1em] text-cargo-emerald">{familyLabel}</p>
      <h3 class="mt-2 text-2xl font-semibold tracking-[-0.03em] text-cargo-deep sm:text-3xl">{title}</h3>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-cargo-ink/70 sm:text-base">{description}</p>
    </div>
    <a href={href} class="inline-flex items-center gap-2 justify-self-start text-sm font-semibold text-cargo-deep transition-colors hover:text-cargo-emerald lg:justify-self-end">
      <span>{actionLabel}</span>
      <span aria-hidden="true">↗</span>
    </a>
    {bullethead && bullethead.length > 0 && (
      <ul class="space-y-3 border-l-2 border-cargo-light/40 pl-4 text-sm leading-relaxed text-cargo-ink/70 lg:col-start-2 lg:col-span-2" aria-label={`${title} - principales servicios`}>
        {bullethead.map((bullet) => <li>{bullet}</li>)}
      </ul>
    )}
    <ul class="space-y-3 border-l border-cargo-emerald/60 pl-4 text-sm leading-relaxed text-cargo-ink/70 lg:col-start-2 lg:col-span-2" aria-label={`${title} - ${familyLabel}`}>
      {bullets.map((bullet) => <li>{bullet}</li>)}
    </ul>
  </div>
</article>
