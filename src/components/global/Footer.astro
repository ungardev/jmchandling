---
import type { Locale } from '../../i18n/utils';
import { switchLocalePath, useTranslations } from '../../i18n/utils';
import ArrowUpRight from '../ui/icons/ArrowUpRight.astro';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();
const localePath = locale === 'es' ? '/es' : '/en';
const homePath = `${localePath}/`;
const aboutPath = switchLocalePath('/es/sobre-jmc', locale);
const contactPath = switchLocalePath('/es/contacto', locale);
const currentPath = Astro.url.pathname;
const alternatePath = switchLocalePath(currentPath, locale === 'en' ? 'es' : 'en');
// Reemplaza el anyo de referencia solo si el copy lo incluye.
const legalYear = t('footer.legal').includes('2026')
  ? t('footer.legal').replace('2026', String(year))
  : t('footer.legal');
---

<footer class="bg-cargo-deep text-cargo-white" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">{t('company.legalName')}</h2>
  <div class="container-max py-16 md:py-20">
    <div class="grid-12 border-b border-cargo-light/20 pb-12">
      <div class="col-span-12 lg:col-span-4">
        <a href={homePath} class="inline-flex items-center gap-3" aria-label="JMC Handling">
          <img
            src="/assets/brand/isotipo-logo.webp"
            alt="JMC Handling"
            width="114"
            height="96"
            class="h-10 w-auto"
            loading="lazy"
          />
          <img
            src="/assets/brand/fuente-logo.webp"
            alt=""
            width="320"
            height="111"
            class="h-8 w-auto"
            loading="lazy"
            aria-hidden="true"
          />
        </a>
        <p class="type-body mt-6 max-w-xs text-cargo-white/80">{t('footer.description')}</p>
        <a
          href="https://www.instagram.com/jmchandling/"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-cargo-light underline decoration-cargo-light/50 underline-offset-4 transition-colors hover:text-cargo-white"
          aria-label={t('footer.instagramLabel')}
        >
          Instagram
          <ArrowUpRight class="h-3.5 w-3.5" />
        </a>
      </div>

      <nav class="col-span-6 lg:col-span-2 lg:col-start-6" aria-label={t('footer.navLabel')}>
        <p class="eyebrow eyebrow-on-dark">{t('footer.navTitle')}</p>
        <ul class="mt-5 space-y-3">
          <li><a href={`${homePath}#services`} class="text-sm text-cargo-white/80 transition-colors hover:text-cargo-white">{t('nav.services')}</a></li>
          <li><a href={aboutPath} class="text-sm text-cargo-white/80 transition-colors hover:text-cargo-white">{t('nav.about')}</a></li>
          <li><a href={contactPath} class="text-sm text-cargo-white/80 transition-colors hover:text-cargo-white">{t('nav.contact')}</a></li>
          <li>
            <a
              href={alternatePath}
              lang={locale === 'en' ? 'es' : 'en'}
              rel="alternate"
              class="text-sm text-cargo-light underline decoration-cargo-light/40 underline-offset-4 transition-colors hover:text-cargo-white"
            >
              {locale === 'en' ? t('nav.switchToSpanish') : t('nav.switchToEnglish')}
            </a>
          </li>
        </ul>
      </nav>

      {/* Estacion: el unico dato que no vive en la CTA ni en la pagina de
          contacto. */}
      <div class="col-span-6 lg:col-span-2">
        <p class="eyebrow eyebrow-on-dark">{t('company.stationLabel')}</p>
        <p class="mt-5 font-mono text-sm text-cargo-white/85">{t('company.station')}</p>
        <address class="mt-5 not-italic">
          <p class="text-sm text-cargo-white/70">{t('company.addressLine1')}</p>
          <p class="text-sm text-cargo-white/70">{t('company.addressLine2')}</p>
          <p class="text-sm text-cargo-white/70">{t('company.addressLine3')}</p>
        </address>
      </div>

      {/* Referencia tecnica de contacto: mono, sin etiquetas, en una sola
          columna. Es el registro completo; la CTA de la home solo enlaza. */}
      <div class="col-span-12 mt-10 lg:col-span-3 lg:col-start-10 lg:mt-0">
        <p class="eyebrow eyebrow-on-dark">{t('footer.contact')}</p>
        <ul class="mt-5 space-y-2 font-mono text-xs text-cargo-white/80">
          <li>
            <a
              href={`mailto:${t('company.email')}`}
              class="block transition-colors hover:text-cargo-white"
            >
              {t('company.email')}
            </a>
          </li>
          <li>
            <a
              href={`tel:${t('company.phoneVzla').replaceAll(' ', '')}`}
              class="block transition-colors hover:text-cargo-white"
            >
              {t('company.phoneVzla')}
            </a>
          </li>
          <li>
            <a
              href={`tel:${t('company.phoneUsa').replaceAll(' ', '')}`}
              class="block transition-colors hover:text-cargo-white"
            >
              {t('company.phoneUsa')}
            </a>
          </li>
          <li class="pt-2 text-cargo-light/80">{t('company.hours')}</li>
        </ul>
      </div>
    </div>

    <div class="flex flex-col gap-2 pt-6 text-xs text-cargo-white/75 sm:flex-row sm:items-center sm:justify-between">
      <p>{legalYear} {t('footer.allRights')}</p>
      <p class="font-mono uppercase tracking-[0.08em]">
        {t('company.certCodes')} · {t('company.rifLabel')}: {t('company.rif')}
      </p>
    </div>
  </div>
</footer>
