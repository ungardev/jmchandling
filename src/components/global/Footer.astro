---
import type { Locale } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';
import { serviceFamilies } from '../../data/siteContent';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();
const servicesPath = locale === 'es' ? '/es/servicios' : '/en/services';
const quotePath = locale === 'es' ? '/es/cotizacion' : '/en/quote';
---

<footer class="bg-cargo-deep text-cargo-white" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">{t('footer.company')}</h2>
  <div class="container-max section-pad">
    <div class="grid gap-12 border-b border-cargo-light/15 pb-16 md:grid-cols-2 lg:grid-cols-[1.2fr_0.9fr_0.9fr_1fr]">
      <div>
        <a href={locale === 'es' ? '/es/' : '/en/'} class="inline-flex items-center gap-3" aria-label="JMC Handling">
          <img src="/assets/brand/isotipo-logo.webp" alt="JMC Handling" width="114" height="96" class="h-10 w-auto" loading="lazy" />
          <img src="/assets/brand/fuente-logo.webp" alt="" width="320" height="111" class="h-8 w-auto" loading="lazy" aria-hidden="true" />
        </a>
        <p class="mt-6 max-w-xs text-sm leading-relaxed text-cargo-white/70">{t('footer.description')}</p>
        <a href="https://www.instagram.com/jmchandling/" target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex items-center gap-2 border-b border-cargo-light/30 pb-1 font-mono text-xs uppercase tracking-[0.08em] text-cargo-light transition-colors hover:border-cargo-light hover:text-cargo-white" aria-label={t('footer.instagramLabel')}>
          Instagram <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div>
        <h3 class="font-mono text-xs uppercase tracking-[0.12em] text-cargo-light">{t('footer.services')}</h3>
        <ul class="mt-5 space-y-3">
          {serviceFamilies.map((family) => (
            <li><a href={`${servicesPath}#${family.key}`} class="text-sm text-cargo-white/70 transition-colors hover:text-cargo-white">{t(family.titleKey)}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="font-mono text-xs uppercase tracking-[0.12em] text-cargo-light">{t('footer.stations')}</h3>
        <p class="mt-5 text-sm text-cargo-white/80">{t('footer.stationValue')}</p>
        <p class="mt-2 text-sm text-cargo-white/50">{t('footer.moreStations')}</p>

        <h3 class="mt-10 font-mono text-xs uppercase tracking-[0.12em] text-cargo-light">{t('footer.contact')}</h3>
        <div class="mt-5 space-y-2 text-sm text-cargo-white/70">
          <a href={`mailto:${t('footer.emailPrimary')}`} class="block transition-colors hover:text-cargo-white">{t('footer.emailPrimary')}</a>
          <a href={`mailto:${t('footer.emailSecondary')}`} class="block transition-colors hover:text-cargo-white">{t('footer.emailSecondary')}</a>
          <a href={`tel:${t('footer.phone').replaceAll(' ', '')}`} class="block transition-colors hover:text-cargo-white">{t('footer.phone')}</a>
        </div>
      </div>

      <div>
        <h3 class="font-mono text-xs uppercase tracking-[0.12em] text-cargo-light">{t('footer.office')}</h3>
        <address class="mt-5 not-italic text-sm leading-relaxed text-cargo-white/70">
          <p>{t('footer.officeLine1')}</p>
          <p>{t('footer.officeLine2')}</p>
          <p>{t('footer.officeLine3')}</p>
        </address>
        <a href={quotePath} class="mt-8 inline-flex items-center gap-2 border-b border-cargo-light/30 pb-1 text-sm font-semibold text-cargo-white transition-colors hover:border-cargo-light hover:text-cargo-light">{t('common.getQuote')} <span aria-hidden="true">↗</span></a>
      </div>
    </div>

    <div class="flex flex-col gap-3 pt-6 text-xs text-cargo-white/45 sm:flex-row sm:items-center sm:justify-between">
      <p>{t('footer.legal').replace('2026', String(year))} {t('footer.allRights')}</p>
      <p class="font-mono uppercase tracking-[0.08em]">{t('footer.legalCert')}</p>
    </div>
  </div>
</footer>
