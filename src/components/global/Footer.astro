---
import type { Locale } from '../../i18n/utils';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="bg-cargo-deep border-t border-white/10" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Footer</h2>

  <div class="container-max section-pad">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">

      <div>
        <div class="flex items-center gap-3 mb-4">
          <img
            src="/assets/brand/isotipo-logo.webp"
            srcset="/assets/brand/isotipo-logo.webp 1x, /assets/brand/isotipo-logo-sm.webp 2x"
            alt="JMC Handling"
            width="57"
            height="48"
            class="h-10 w-auto"
            loading="lazy"
          />
          <img
            src="/assets/brand/fuente-logo.webp"
            srcset="/assets/brand/fuente-logo.webp 1x, /assets/brand/fuente-logo-sm.webp 2x"
            alt=""
            width="115"
            height="40"
            class="h-8 w-auto"
            loading="lazy"
            aria-hidden="true"
          />
        </div>
        <p class="text-sm text-white/60 leading-relaxed mb-4">
          {locale === 'es'
            ? 'Proveedor certificado de servicios especializados aeroportuarios en Venezuela. Operamos bajo la regulación RAV 111 con certificación CESEA-021.'
            : 'Certified provider of specialized airport services in Venezuela. Operating under RAV 111 regulation with CESEA-021 certification.'}
        </p>
        <div class="flex items-center gap-3">
          <a
            href="https://www.instagram.com/jmchandling/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram JMC Handling"
            class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center hover:bg-cargo-emerald/30 transition-colors"
          >
            <svg class="w-4 h-4 text-white/70" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
        </div>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">
          {locale === 'es' ? 'Servicios' : 'Services'}
        </h3>
        <ul class="space-y-2.5">
          {[
            locale === 'es' ? 'Handling en Plataforma' : 'Ramp Handling',
            locale === 'es' ? 'Limpieza de Aeronaves' : 'Aircraft Cleaning',
            locale === 'es' ? 'Despacho de Vuelos' : 'Flight Dispatch',
            locale === 'es' ? 'Tráfico de Pasajeros' : 'Passenger Traffic',
            locale === 'es' ? 'Mantenimiento GSE' : 'GSE Maintenance',
            locale === 'es' ? 'Servicios Especiales' : 'Special Services',
          ].map((service) => (
            <li>
              <a href={locale === 'es' ? '/es/servicios' : '/en/services'} class="text-sm text-white/60 hover:text-cargo-emerald transition-colors">
                {service}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">
          {locale === 'es' ? 'Estaciones' : 'Stations'}
        </h3>
        <ul class="space-y-2.5">
          <li class="text-sm text-white/60">CCS – {locale === 'es' ? 'Maiquetía' : 'Maiquetía'}</li>
          <li class="text-sm text-white/40 italic">
            {locale === 'es' ? 'Próximamente más estaciones' : 'More stations coming soon'}
          </li>
        </ul>

        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mt-8 mb-4">
          {locale === 'es' ? 'Contacto' : 'Contact'}
        </h3>
        <ul class="space-y-2">
          <li>
            <a href="mailto:carlos.wood@jmchandling.com" class="text-sm text-white/60 hover:text-cargo-emerald transition-colors">
              carlos.wood@jmchandling.com
            </a>
          </li>
          <li>
            <a href="tel:+582120000000" class="text-sm text-white/60 hover:text-cargo-emerald transition-colors">
              +58 212 000 0000
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">
          {locale === 'es' ? 'Oficina Principal' : 'Main Office'}
        </h3>
        <address class="not-italic text-sm text-white/60 leading-relaxed space-y-1">
          <p>{locale === 'es' ? 'Aeropuerto Internacional Simón Bolívar' : 'Simón Bolívar International Airport'}</p>
          <p>{locale === 'es' ? 'Nivel 1, Sector 8.2' : 'Level 1, Sector 8.2'}</p>
          <p>Maiquetía, La Guaira, Venezuela</p>
        </address>

        <div class="mt-6 flex flex-wrap gap-2">
          <span class="badge-cert text-[10px]">CESEA-021</span>
          <span class="badge-cert text-[10px]">INAC</span>
          <span class="badge-cert text-[10px]">RAV 111</span>
        </div>
      </div>

    </div>

    <div class="mt-16 pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-white/40">
        &copy; {year} Servicios Especializados JMC, C.A. {locale === 'es' ? 'Todos los derechos reservados.' : 'All rights reserved.'}
      </p>
      <p class="text-xs text-white/30">
        CESEA-021 &middot; INAC RAV 111
      </p>
    </div>
  </div>
</footer>
