---
import type { Locale } from '../../i18n/utils';
import { switchLocalePath, useTranslations } from '../../i18n/utils';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const currentPath = Astro.url.pathname;
const homePath = locale === 'es' ? '/es/' : '/en/';
const servicesPath = locale === 'es' ? '/es/servicios' : '/en/services';
const contactPath = locale === 'es' ? '/es/contacto' : '/en/contact';
const quotePath = locale === 'es' ? '/es/cotizacion' : '/en/quote';
const isHome = currentPath === `/${locale}/` || currentPath === `/${locale}`;
const isServices = currentPath.includes('/servicios') || currentPath.includes('/services');
const isContact = currentPath.includes('/contacto') || currentPath.includes('/contact');
const homeLinks = [
  { href: '#capacidades', label: t('nav.services') },
  { href: '#empresa', label: t('home.navCompany') },
  { href: '#equipos', label: t('home.navEquipment') },
  { href: contactPath, label: t('nav.contact') },
];
const pageLinks = [
  { href: homePath, label: t('nav.home'), isCurrent: isHome },
  { href: servicesPath, label: t('nav.services'), isCurrent: isServices },
  { href: contactPath, label: t('nav.contact'), isCurrent: isContact },
];
const navLinks = isHome ? homeLinks : pageLinks;
---

<header class="fixed inset-x-0 top-0 z-50">
  <nav class="border-b border-cargo-light/15 bg-cargo-deep text-cargo-white" aria-label={t('nav.primaryNav')}>
    <div class="container-max">
      <div class="flex min-h-[4.5rem] items-center justify-between gap-6">
        <a href={homePath} class="flex shrink-0 items-center gap-3" aria-label="JMC Handling">
          <img
            src="/assets/brand/isotipo-logo.webp"
            srcset="/assets/brand/isotipo-logo.webp 1x, /assets/brand/isotipo-logo-sm.webp 2x"
            alt="JMC Handling"
            width="114"
            height="96"
            class="h-10 w-auto"
            loading="eager"
          />
          <img
            src="/assets/brand/fuente-logo.webp"
            srcset="/assets/brand/fuente-logo.webp 1x, /assets/brand/fuente-logo-sm.webp 2x"
            alt=""
            width="320"
            height="111"
            class="h-6 w-auto sm:h-8"
            loading="eager"
            aria-hidden="true"
          />
        </a>

        <div class="hidden items-center gap-7 lg:flex">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class="nav-link"
              aria-current={'isCurrent' in link && link.isCurrent ? 'page' : undefined}
            >
              {link.label}
            </a>
          ))}
          <a href={quotePath} class="border border-cargo-light/60 px-4 py-2.5 text-sm font-semibold text-cargo-white transition-colors hover:bg-cargo-white/10">
            {t('quote.submit')}
            <span aria-hidden="true" class="ml-3 text-cargo-light">↗</span>
          </a>
          <a
            href={isHome ? (locale === 'en' ? '/es/' : '/en/') : switchLocalePath(currentPath, locale === 'en' ? 'es' : 'en')}
            class="font-mono text-xs uppercase tracking-[0.08em] text-cargo-white/70 transition-colors hover:text-cargo-white"
            aria-label={locale === 'en' ? t('nav.switchToSpanish') : t('nav.switchToEnglish')}
            rel="alternate"
            lang={locale === 'en' ? 'es' : 'en'}
          >
            <span class:list={[{ 'text-cargo-light': locale === 'es' }]}>ES</span>
            <span class="px-1 text-cargo-white/35" aria-hidden="true">/</span>
            <span class:list={[{ 'text-cargo-light': locale === 'en' }]}>EN</span>
          </a>
        </div>

        <button
          id="mobile-menu-btn"
          class="rounded-sm border border-cargo-light/25 p-2 text-cargo-white/80 transition-colors hover:border-cargo-light hover:text-cargo-white lg:hidden"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label={t('nav.openMenu')}
          data-open-label={t('nav.openMenu')}
          data-close-label={t('nav.closeMenu')}
          type="button"
        >
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="hidden border-t border-cargo-light/15 bg-cargo-deep lg:hidden" aria-hidden="true">
      <div class="container-max flex flex-col gap-1 py-4">
        {navLinks.map((link) => (
          <a href={link.href} class="border-b border-cargo-light/10 px-1 py-3 text-sm text-cargo-white/80 hover:text-cargo-white">
            {link.label}
          </a>
        ))}
        <a href={quotePath} class="btn-primary mt-4 text-center text-sm">{t('quote.submit')}</a>
        <div class="mt-3 flex items-center gap-3 border-t border-cargo-light/15 pt-4 font-mono text-xs uppercase tracking-[0.08em]">
          <span class="text-cargo-white/45">{t('nav.language')}</span>
          <a href={isHome ? '/es/' : switchLocalePath(currentPath, 'es')} lang="es" class:list={['px-1 py-1', locale === 'es' ? 'text-cargo-light' : 'text-cargo-white/55']}>ES</a>
          <span class="text-cargo-white/30" aria-hidden="true">/</span>
          <a href={isHome ? '/en/' : switchLocalePath(currentPath, 'en')} lang="en" class:list={['px-1 py-1', locale === 'en' ? 'text-cargo-light' : 'text-cargo-white/55']}>EN</a>
        </div>
      </div>
    </div>
  </nav>
</header>

<script is:inline>
  const menuButton = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileLinks = mobileMenu?.querySelectorAll('a') ?? [];

  const closeMobileMenu = () => {
    if (!menuButton || !mobileMenu) return;
    menuButton.setAttribute('aria-expanded', 'false');
    menuButton.setAttribute('aria-label', menuButton.dataset.openLabel ?? '');
    mobileMenu.classList.add('hidden');
    mobileMenu.setAttribute('aria-hidden', 'true');
  };

  if (menuButton && mobileMenu) {
    menuButton.addEventListener('click', () => {
      const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
      menuButton.setAttribute('aria-expanded', String(!isOpen));
      menuButton.setAttribute('aria-label', isOpen ? menuButton.dataset.openLabel ?? '' : menuButton.dataset.closeLabel ?? '');
      mobileMenu.classList.toggle('hidden', isOpen);
      mobileMenu.setAttribute('aria-hidden', String(isOpen));
      if (!isOpen) mobileLinks[0]?.focus();
    });

    mobileLinks.forEach((link) => link.addEventListener('click', closeMobileMenu));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closeMobileMenu();
        menuButton.focus();
      }
    });
  }
</script>
