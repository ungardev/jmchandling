---
import type { Locale } from '../../i18n/utils';
import { switchLocalePath } from '../../i18n/utils';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 inset-x-0 z-50">
  <div class="glass-dark">
    <div class="container-max">
      <div class="flex items-center justify-between h-12 text-xs">
        <div class="flex items-center gap-4">
          <span class="badge-cert">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            INAC · CESEA-021 · RAV 111
          </span>
        </div>

        <div class="hidden md:flex items-center gap-6 text-white/70">
          <a
            href={`tel:+582120000000`}
            class="flex items-center gap-1.5 hover:text-cargo-emerald transition-colors"
            aria-label="Teléfono"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            +58 212 000 0000
          </a>

          <a
            href="mailto:carlos.wood@jmchandling.com"
            class="flex items-center gap-1.5 hover:text-cargo-emerald transition-colors"
            aria-label="Correo electrónico"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            carlos.wood@jmchandling.com
          </a>

          <span class="text-white/40" aria-hidden="true">|</span>

          <span class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-cargo-emerald" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            {locale === 'es' ? 'Lun–Sáb 05:00–22:00' : 'Mon–Sat 05:00–22:00'}
          </span>
        </div>

        <div class="flex items-center">
          <a
            href={switchLocalePath(currentPath, locale === 'en' ? 'es' : 'en')}
            class="flex items-center gap-1 px-3 py-1 rounded-md text-xs font-semibold transition-all hover:bg-white/10"
            aria-label={locale === 'en' ? 'Cambiar a Español' : 'Switch to English'}
          >
            <span class={locale === 'es' ? 'text-white' : 'text-white/50'}>ES</span>
            <span class="text-white/30" aria-hidden="true">|</span>
            <span class={locale === 'en' ? 'text-white' : 'text-white/50'}>EN</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <nav
    class="glass-dark border-t border-white/5"
    aria-label="Navegación principal"
  >
    <div class="container-max">
      <div class="flex items-center justify-between h-16">
        <a href={locale === 'es' ? '/es/' : '/en/'} class="flex items-center gap-3" aria-label="JMC Handling - Inicio">
          <img
            src="/assets/brand/isotipo-white-256.webp"
            alt="JMC Handling"
            width="36"
            height="36"
            class="h-9 w-auto"
            loading="eager"
          />
          <div class="hidden sm:block">
            <div class="text-white font-bold text-sm tracking-wide leading-none">JMC</div>
            <div class="text-cargo-light text-[9px] tracking-widest uppercase mt-0.5">
              {locale === 'es' ? 'Handling' : 'Handling'}
            </div>
          </div>
        </a>

        <div class="hidden md:flex items-center gap-8">
          <a
            href={locale === 'es' ? '/es/' : '/en/'}
            class="nav-link"
            class:list={[{ active: currentPath === `/${locale}/` || currentPath === `/${locale}` }]}
            aria-current={currentPath === `/${locale}/` ? 'page' : undefined}
          >
            {locale === 'es' ? 'Inicio' : 'Home'}
          </a>
          <a
            href={locale === 'es' ? '/es/servicios' : '/en/services'}
            class="nav-link"
            class:list={[{ active: currentPath.includes('/servicios') || currentPath.includes('/services') }]}
            aria-current={currentPath.includes('/servicios') || currentPath.includes('/services') ? 'page' : undefined}
          >
            {locale === 'es' ? 'Servicios' : 'Services'}
          </a>
          <a
            href={locale === 'es' ? '/es/contacto' : '/en/contact'}
            class="nav-link"
            class:list={[{ active: currentPath.includes('/contacto') || currentPath.includes('/contact') }]}
            aria-current={currentPath.includes('/contacto') || currentPath.includes('/contact') ? 'page' : undefined}
          >
            {locale === 'es' ? 'Contacto' : 'Contact'}
          </a>
          <a
            href={locale === 'es' ? '/es/cotizacion' : '/en/quote'}
            class="btn-primary text-sm py-2"
          >
            {locale === 'es' ? 'Cotización' : 'Quote'}
          </a>
        </div>

        <button
          id="mobile-menu-btn"
          class="md:hidden p-2 rounded-lg text-white/70 hover:text-white hover:bg-white/10 transition-colors"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label={locale === 'es' ? 'Abrir menú de navegación' : 'Open navigation menu'}
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <div
      id="mobile-menu"
      class="md:hidden hidden glass-dark border-t border-white/5"
      aria-hidden="true"
    >
      <div class="container-max py-4 flex flex-col gap-2">
        <a href={locale === 'es' ? '/es/' : '/en/'} class="px-4 py-3 rounded-lg hover:bg-white/10 text-white/80 hover:text-white transition-colors">
          {locale === 'es' ? 'Inicio' : 'Home'}
        </a>
        <a href={locale === 'es' ? '/es/servicios' : '/en/services'} class="px-4 py-3 rounded-lg hover:bg-white/10 text-white/80 hover:text-white transition-colors">
          {locale === 'es' ? 'Servicios' : 'Services'}
        </a>
        <a href={locale === 'es' ? '/es/contacto' : '/en/contact'} class="px-4 py-3 rounded-lg hover:bg-white/10 text-white/80 hover:text-white transition-colors">
          {locale === 'es' ? 'Contacto' : 'Contact'}
        </a>
        <a href={locale === 'es' ? '/es/cotizacion' : '/en/quote'} class="btn-primary text-center mt-2">
          {locale === 'es' ? 'Cotización' : 'Quote'}
        </a>
      </div>
    </div>
  </nav>
</header>

<script is:inline>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      menu.classList.toggle('hidden', expanded);
      menu.setAttribute('aria-hidden', String(expanded));
    });
  }
</script>
