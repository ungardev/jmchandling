---
import type { Locale } from '../../i18n/utils';
import { switchLocalePath } from '../../i18n/utils';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 inset-x-0 z-50">
  <nav
    class="glass-dark"
    aria-label="Navegación principal"
  >
    <div class="container-max">
      <div class="flex items-center justify-between h-16">
        <a
          href={locale === 'es' ? '/es/' : '/en/'}
          class="flex items-center gap-3"
          aria-label="JMC Handling - Inicio"
        >
          <img
            src="/assets/brand/isotipo-logo.webp"
            srcset="/assets/brand/isotipo-logo.webp 1x, /assets/brand/isotipo-logo-sm.webp 2x"
            alt="JMC Handling"
            width="57"
            height="48"
            class="h-9 md:h-12 w-auto"
            loading="eager"
          />
          <img
            src="/assets/brand/fuente-logo.webp"
            srcset="/assets/brand/fuente-logo.webp 1x, /assets/brand/fuente-logo-sm.webp 2x"
            alt=""
            width="115"
            height="40"
            class="hidden md:block h-9 w-auto"
            loading="eager"
            aria-hidden="true"
          />
        </a>

        <div class="hidden md:flex items-center gap-8">
          <a
            href={locale === 'es' ? '/es/' : '/en/'}
            class="nav-link"
            class:list={[{ active: currentPath === `/${locale}/` || currentPath === `/${locale}` }]}
            aria-current={currentPath === `/${locale}/` ? 'page' : undefined}
          >
            {locale === 'es' ? 'Inicio' : 'Home'}
          </a>
          <a
            href={locale === 'es' ? '/es/servicios' : '/en/services'}
            class="nav-link"
            class:list={[{ active: currentPath.includes('/servicios') || currentPath.includes('/services') }]}
            aria-current={currentPath.includes('/servicios') || currentPath.includes('/services') ? 'page' : undefined}
          >
            {locale === 'es' ? 'Servicios' : 'Services'}
          </a>
          <a
            href={locale === 'es' ? '/es/contacto' : '/en/contact'}
            class="nav-link"
            class:list={[{ active: currentPath.includes('/contacto') || currentPath.includes('/contact') }]}
            aria-current={currentPath.includes('/contacto') || currentPath.includes('/contact') ? 'page' : undefined}
          >
            {locale === 'es' ? 'Contacto' : 'Contact'}
          </a>
          <a
            href={locale === 'es' ? '/es/cotizacion' : '/en/quote'}
            class="btn-primary text-sm py-2"
          >
            {locale === 'es' ? 'Cotización' : 'Quote'}
          </a>

          <a
            href={switchLocalePath(currentPath, locale === 'en' ? 'es' : 'en')}
            class="flex items-center gap-1 px-3 py-1.5 rounded-md text-xs font-semibold
                   bg-white/10 border border-white/20 text-white/80 hover:bg-white/20
                   hover:text-white transition-all duration-200"
            aria-label={locale === 'en' ? 'Cambiar a Español' : 'Switch to English'}
            rel="alternate"
            lang={locale === 'en' ? 'es' : 'en'}
          >
            <span class:list={[{ 'text-white font-bold': locale === 'es' }]}>ES</span>
            <span class="text-white/30" aria-hidden="true">|</span>
            <span class:list={[{ 'text-white font-bold': locale === 'en' }]}>EN</span>
          </a>
        </div>

        <button
          id="mobile-menu-btn"
          class="md:hidden p-2 rounded-lg text-white/70 hover:text-white hover:bg-white/10 transition-colors"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label={locale === 'es' ? 'Abrir menú de navegación' : 'Open navigation menu'}
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <div
      id="mobile-menu"
      class="md:hidden hidden glass-dark border-t border-white/5"
      aria-hidden="true"
    >
      <div class="container-max py-4 flex flex-col gap-2">
        <a href={locale === 'es' ? '/es/' : '/en/'} class="px-4 py-3 rounded-lg hover:bg-white/10 text-white/80 hover:text-white transition-colors">
          {locale === 'es' ? 'Inicio' : 'Home'}
        </a>
        <a href={locale === 'es' ? '/es/servicios' : '/en/services'} class="px-4 py-3 rounded-lg hover:bg-white/10 text-white/80 hover:text-white transition-colors">
          {locale === 'es' ? 'Servicios' : 'Services'}
        </a>
        <a href={locale === 'es' ? '/es/contacto' : '/en/contact'} class="px-4 py-3 rounded-lg hover:bg-white/10 text-white/80 hover:text-white transition-colors">
          {locale === 'es' ? 'Contacto' : 'Contact'}
        </a>
        <a href={locale === 'es' ? '/es/cotizacion' : '/en/quote'} class="btn-primary text-center mt-2">
          {locale === 'es' ? 'Cotización' : 'Quote'}
        </a>
        <div class="flex items-center gap-2 px-4 py-2 border-t border-white/10 mt-2 pt-4">
          <span class="text-xs text-white/50">Idioma:</span>
          <a
            href={switchLocalePath(currentPath, 'es')}
            class:list={['text-xs font-semibold px-2 py-1 rounded', locale === 'es' ? 'text-white bg-white/20' : 'text-white/50 hover:text-white']}
          >
            ES
          </a>
          <span class="text-white/30">|</span>
          <a
            href={switchLocalePath(currentPath, 'en')}
            class:list={['text-xs font-semibold px-2 py-1 rounded', locale === 'en' ? 'text-white bg-white/20' : 'text-white/50 hover:text-white']}
          >
            EN
          </a>
        </div>
      </div>
    </div>
  </nav>
</header>

<script is:inline>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      menu.classList.toggle('hidden', expanded);
      menu.setAttribute('aria-hidden', String(expanded));
    });
  }
</script>
