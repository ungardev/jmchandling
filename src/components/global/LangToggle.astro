---
import type { Locale } from '../../i18n/utils';
import { switchLocalePath } from '../../i18n/utils';

export interface Props {
  currentLocale: Locale;
  currentPath: string;
}

const { currentLocale, currentPath } = Astro.props;
const targetLocale: Locale = currentLocale === 'en' ? 'es' : 'en';
const targetPath = switchLocalePath(currentPath, targetLocale);
---

<a
  href={targetPath}
  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-semibold
         bg-white/10 border border-white/20 text-white/80 hover:bg-white/20
         hover:text-white transition-all duration-200 focus-visible:ring-2
         focus-visible:ring-cargo-emerald focus-visible:ring-offset-2 focus-visible:ring-offset-cargo-deep"
  aria-label={currentLocale === 'en'
    ? 'Cambiar a Español'
    : 'Switch to English'}
  rel="alternate"
  lang={targetLocale}
>
  <span class:list={[{ 'text-white font-bold': currentLocale === 'en' }]}>ES</span>
  <span class="text-white/30" aria-hidden="true">|</span>
  <span class:list={[{ 'text-white font-bold': currentLocale === 'es' }]}>EN</span>
</a>
