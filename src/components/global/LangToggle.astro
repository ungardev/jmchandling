---
import type { Locale } from '../../i18n/utils';
import { switchLocalePath, useTranslations } from '../../i18n/utils';

export interface Props {
  currentLocale: Locale;
  currentPath: string;
}

const { currentLocale, currentPath } = Astro.props;
const t = useTranslations(currentLocale);
const targetLocale: Locale = currentLocale === 'en' ? 'es' : 'en';
const targetPath = switchLocalePath(currentPath, targetLocale);
---

<a
  href={targetPath}
  class="inline-flex items-center gap-1 font-mono text-xs uppercase tracking-[0.08em] text-cargo-white/70 transition-colors hover:text-cargo-white focus-visible:ring-2 focus-visible:ring-cargo-emerald"
  aria-label={currentLocale === 'en' ? t('nav.switchToSpanish') : t('nav.switchToEnglish')}
  rel="alternate"
  lang={targetLocale}
>
  <span class:list={[{ 'text-cargo-light': currentLocale === 'es' }]}>ES</span>
  <span class="text-cargo-white/30" aria-hidden="true">/</span>
  <span class:list={[{ 'text-cargo-light': currentLocale === 'en' }]}>EN</span>
</a>
