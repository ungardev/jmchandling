---
import type { Locale } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';

export interface Props {
  locale: Locale;
  variant?: 'full' | 'lite';
}

const { locale, variant = 'full' } = Astro.props;
const t = useTranslations(locale);

const serviceOptions = [
  locale === 'es' ? 'Handling en Plataforma / Ramp Handling' : 'Ramp Handling',
  locale === 'es' ? 'Limpieza de Aeronaves / Aircraft Cleaning' : 'Aircraft Cleaning',
  locale === 'es' ? 'Despacho de Vuelos / Flight Dispatch' : 'Flight Dispatch',
  locale === 'es' ? 'Tráfico de Pasajeros / Passenger Traffic' : 'Passenger Traffic',
  locale === 'es' ? 'Servicios Especiales / Special Services' : 'Special Services',
  locale === 'es' ? 'Mantenimiento GSE / GSE Maintenance' : 'GSE Maintenance',
  locale === 'es' ? 'Desinfección / Disinfection' : 'Disinfection & Disinsection',
  locale === 'es' ? 'Otro / Other' : 'Other',
];
---

<form
  action="https://formsubmit.co/carlos.wood@jmchandling.com"
  method="POST"
  class="space-y-5"
  aria-label={locale === 'es' ? 'Formulario de cotización' : 'Quote request form'}
>
  <input type="hidden" name="_cc" value="jose.moncada@jmchandling.com" />
  <input type="hidden" name="_captcha" value="false" />
  <input type="hidden" name="_subject" value={locale === 'es'
    ? 'Nueva Solicitud de Servicio - JMC Handling Web'
    : 'New Service Request - JMC Handling Web'} />
  <input
    type="hidden"
    name="_next"
    value={locale === 'es' ? `${Astro.url.origin}/es/contacto?sent=true` : `${Astro.url.origin}/en/contact?sent=true`}
  />

  <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <div class="space-y-1.5">
      <label for="quote-name" class="block text-xs font-medium text-white/70">
        {t('quote.name')} <span class="text-cargo-emerald" aria-label="obligatorio">*</span>
      </label>
      <input
        type="text"
        id="quote-name"
        name="Empresa_o_Nombre"
        required
        autocomplete="organization"
        placeholder={t('quote.namePlaceholder')}
        class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white placeholder-white/30
               focus:outline-none focus:border-cargo-emerald focus:ring-1 focus:ring-cargo-emerald
               transition-colors text-sm"
      />
    </div>

    <div class="space-y-1.5">
      <label for="quote-email" class="block text-xs font-medium text-white/70">
        {t('quote.email')} <span class="text-cargo-emerald" aria-label="obligatorio">*</span>
      </label>
      <input
        type="email"
        id="quote-email"
        name="Correo_Cliente"
        required
        autocomplete="email"
        placeholder={t('quote.emailPlaceholder')}
        class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white placeholder-white/30
               focus:outline-none focus:border-cargo-emerald focus:ring-1 focus:ring-cargo-emerald
               transition-colors text-sm"
      />
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <div class="space-y-1.5">
      <label for="quote-phone" class="block text-xs font-medium text-white/70">
        {t('quote.phone')}
      </label>
      <input
        type="tel"
        id="quote-phone"
        name="Telefono"
        autocomplete="tel"
        placeholder={t('quote.phonePlaceholder')}
        class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white placeholder-white/30
               focus:outline-none focus:border-cargo-emerald focus:ring-1 focus:ring-cargo-emerald
               transition-colors text-sm"
      />
    </div>

    <div class="space-y-1.5">
      <label for="quote-service" class="block text-xs font-medium text-white/70">
        {t('quote.service')} <span class="text-cargo-emerald" aria-label="obligatorio">*</span>
      </label>
      <select
        id="quote-service"
        name="Servicio_Requerido"
        required
        class="w-full px-4 py-3 rounded-xl bg-cargo-deep border border-white/10 text-white
               focus:outline-none focus:border-cargo-emerald focus:ring-1 focus:ring-cargo-emerald
               transition-colors text-sm appearance-none cursor-pointer"
      >
        <option value="" disabled selected class="bg-cargo-deep">{t('quote.servicePlaceholder')}</option>
        {serviceOptions.map((opt) => (
          <option value={opt} class="bg-cargo-deep">{opt}</option>
        ))}
      </select>
    </div>
  </div>

  {variant === 'full' && (
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div class="space-y-1.5">
        <label for="quote-fleet" class="block text-xs font-medium text-white/70">
          {t('quote.fleet')}
        </label>
        <input
          type="text"
          id="quote-fleet"
          name="Tipo_Flota"
          placeholder={t('quote.fleetPlaceholder')}
          class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white placeholder-white/30
                 focus:outline-none focus:border-cargo-emerald focus:ring-1 focus:ring-cargo-emerald
                 transition-colors text-sm"
        />
      </div>

      <div class="space-y-1.5">
        <label for="quote-stations" class="block text-xs font-medium text-white/70">
          {t('quote.stations')}
        </label>
        <input
          type="text"
          id="quote-stations"
          name="Estaciones"
          placeholder={t('quote.stationsPlaceholder')}
          class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white placeholder-white/30
                 focus:outline-none focus:border-cargo-emerald focus:ring-1 focus:ring-cargo-emerald
                 transition-colors text-sm"
        />
      </div>
    </div>
  )}

  <div class="space-y-1.5">
    <label for="quote-message" class="block text-xs font-medium text-white/70">
      {t('quote.message')} <span class="text-cargo-emerald" aria-label="obligatorio">*</span>
    </label>
    <textarea
      id="quote-message"
      name="Mensaje"
      rows={variant === 'full' ? 5 : 3}
      required
      placeholder={t('quote.messagePlaceholder')}
      class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-white placeholder-white/30
             focus:outline-none focus:border-cargo-emerald focus:ring-1 focus:ring-cargo-emerald
             transition-colors text-sm resize-none"
    />
  </div>

  <button
    type="submit"
    class="btn-primary w-full py-4 text-base"
  >
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
    </svg>
    {t('quote.submit')}
  </button>

  <p class="text-center text-xs text-white/30">
    {locale === 'es'
      ? 'Sus datos están protegidos. Nunca compartimos información con terceros.'
      : 'Your data is protected. We never share information with third parties.'}
  </p>
</form>
