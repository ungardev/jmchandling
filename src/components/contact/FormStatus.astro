---
import type { Locale } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';

export interface Props {
  locale: Locale;
  variant?: 'success' | 'error';
}

const { locale, variant = 'success' } = Astro.props;
const t = useTranslations(locale);
const isSuccess = variant === 'success';
---

<div
  class:list={[
    'border px-6 py-6',
    isSuccess ? 'border-cargo-emerald/50 bg-cargo-emerald/10' : 'border-cargo-light/60 bg-cargo-light/10',
  ]}
  role={isSuccess ? 'status' : 'alert'}
>
  <p class="font-mono text-xs uppercase tracking-[0.1em] text-cargo-light">
    {isSuccess ? t('quote.successCode') : t('quote.errorCode')}
  </p>
  <h2 class="type-h3 mt-3 text-cargo-white">
    {isSuccess ? t('quote.successTitle') : t('quote.errorTitle')}
  </h2>
  <p class="type-body mt-3 text-cargo-white/85">
    {isSuccess ? t('quote.successText') : t('quote.errorText')}
  </p>

  {
    !isSuccess && (
      <ul class="mt-5 flex flex-wrap items-baseline gap-x-3 gap-y-2 font-mono text-sm text-cargo-white/85">
        <li>
          <a
            href={`tel:${t('company.phoneVzla').replaceAll(' ', '')}`}
            class="underline decoration-cargo-light/50 underline-offset-4 transition-colors hover:text-cargo-white"
          >
            {t('company.phoneVzla')}
          </a>
        </li>
        <li aria-hidden="true" class="text-cargo-white/60">
          ·
        </li>
        <li>
          <a
            href={`tel:${t('company.phoneUsa').replaceAll(' ', '')}`}
            class="underline decoration-cargo-light/50 underline-offset-4 transition-colors hover:text-cargo-white"
          >
            {t('company.phoneUsa')}
          </a>
        </li>
        <li aria-hidden="true" class="text-cargo-white/60">
          ·
        </li>
        <li>
          <a
            href={`mailto:${t('company.email')}`}
            class="underline decoration-cargo-light/50 underline-offset-4 transition-colors hover:text-cargo-white"
          >
            {t('company.email')}
          </a>
        </li>
      </ul>
    )
  }
</div>
