---
import type { Locale } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';
import Badge from '../ui/Badge.astro';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const quotePath = locale === 'es' ? '/es/cotizacion' : '/en/quote';
---

<div>
  <p class="font-mono text-xs uppercase tracking-[0.12em] text-cargo-emerald">{t('contact.title')}</p>
  <h2 class="mt-5 max-w-xl text-balance text-4xl font-semibold leading-tight tracking-[-0.04em] text-cargo-white sm:text-5xl">{t('contact.introTitle')}</h2>
  <p class="mt-6 max-w-xl text-base leading-relaxed text-cargo-white/75">{t('contact.intro')}</p>

  <dl class="mt-12 space-y-8">
    <div class="border-t border-cargo-light/20 pt-5">
      <dt class="font-mono text-xs uppercase tracking-[0.1em] text-cargo-light">01 · {t('contact.addressLabel')}</dt>
      <dd class="mt-3 max-w-lg text-sm leading-relaxed text-cargo-white/75">{t('contact.address')}</dd>
    </div>
    <div class="border-t border-cargo-light/20 pt-5">
      <dt class="font-mono text-xs uppercase tracking-[0.1em] text-cargo-light">02 · {t('contact.certLabel')}</dt>
      <dd class="mt-3 flex flex-wrap gap-2">
        <Badge variant="cert" size="sm">{t('safety.ceseaBadge')}</Badge>
        <Badge variant="inac" size="sm">{t('safety.inacBadge')}</Badge>
        <Badge variant="sms" size="sm">{t('safety.rav111')}</Badge>
      </dd>
    </div>
    <div class="border-t border-cargo-light/20 pt-5">
      <dt class="font-mono text-xs uppercase tracking-[0.1em] text-cargo-light">03 · {t('contact.emailLabel')}</dt>
      <dd class="mt-3 space-y-2 text-sm text-cargo-white/75">
        <a href={`mailto:${t('footer.emailPrimary')}`} class="block transition-colors hover:text-cargo-white">{t('footer.emailPrimary')}</a>
      </dd>
    </div>
    <div class="border-t border-cargo-light/20 pt-5">
      <dt class="font-mono text-xs uppercase tracking-[0.1em] text-cargo-light">04 · {t('contact.phoneLabelVzla')}</dt>
      <dd class="mt-3 text-sm text-cargo-white/75">
        <a href={`tel:${t('footer.phoneVzla').replaceAll(' ', '')}`} class="block transition-colors hover:text-cargo-white">{t('footer.phoneVzla')}</a>
      </dd>
    </div>
    <div class="border-t border-cargo-light/20 pt-5">
      <dt class="font-mono text-xs uppercase tracking-[0.1em] text-cargo-light">05 · {t('contact.phoneLabelUsa')}</dt>
      <dd class="mt-3 text-sm text-cargo-white/75">
        <a href={`tel:${t('footer.phoneUsa').replaceAll(' ', '')}`} class="block transition-colors hover:text-cargo-white">{t('footer.phoneUsa')}</a>
      </dd>
    </div>
    <div class="border-t border-cargo-light/20 pt-5">
      <dt class="font-mono text-xs uppercase tracking-[0.1em] text-cargo-light">06 · {t('contact.hoursLabel')}</dt>
      <dd class="mt-3 text-sm leading-relaxed text-cargo-white/75">{t('contact.hours')}</dd>
    </div>
  </dl>

  <a href={quotePath} class="btn-primary mt-12 w-full justify-between sm:max-w-md">
    <span>{t('contact.primaryCta')}</span>
    <span aria-hidden="true">↗</span>
  </a>
</div>
