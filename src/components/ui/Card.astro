---
export interface Props {
  href?: string;
  class?: string;
  hover?: boolean;
}

const { href, class: className = '', hover = true } = Astro.props;
const baseClasses = [
  'relative overflow-hidden border border-cargo-deep/15 bg-cargo-white p-6',
  hover ? 'transition-colors duration-200 hover:border-cargo-emerald/60 hover:bg-cargo-emerald/5' : '',
  className,
].filter(Boolean).join(' ');
---

{href ? (
  <a href={href} class="group block">
    <div class={baseClasses}><slot /></div>
  </a>
) : (
  <div class={baseClasses}><slot /></div>
)}
