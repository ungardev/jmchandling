---
export interface Props {
  href?: string;
  class?: string;
  hover?: boolean;
}

const {
  href,
  class: className = '',
  hover = true,
} = Astro.props;

const baseClasses = [
  'relative overflow-hidden rounded-2xl p-6',
  'border border-white/10',
  'bg-cargo-deep/60',
  'backdrop-blur-sm',
  hover ? 'card-service' : '',
  className,
].filter(Boolean).join(' ');

const Inner = () => (
  <div class={baseClasses}>
    <slot />
  </div>
);
---

{href ? (
  <a href={href} class="block group">
    <Inner />
  </a>
) : (
  <div class={baseClasses}>
    <slot />
  </div>
)}
