---
export interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'dark';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  class?: string;
  ariaLabel?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  disabled = false,
  class: className = '',
  ariaLabel,
} = Astro.props;

const baseClasses = 'inline-flex items-center justify-center gap-3 font-semibold transition-colors duration-200 active:-translate-y-px disabled:cursor-not-allowed disabled:opacity-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cargo-emerald focus-visible:ring-offset-2 focus-visible:ring-offset-cargo-mist';

const variantClasses = {
  primary: 'btn-primary',
  secondary: 'btn-secondary',
  ghost: 'btn-ghost',
  dark: 'inline-flex items-center justify-center gap-3 rounded-sm border border-cargo-light/30 bg-cargo-deep px-6 py-3 font-semibold text-cargo-white transition-colors duration-200 hover:bg-cargo-ink active:-translate-y-px',
};

const sizeClasses = {
  sm: 'text-xs px-4 py-2',
  md: 'text-sm px-6 py-3',
  lg: 'text-base px-8 py-4',
};

const classes = [
  baseClasses,
  variantClasses[variant],
  sizeClasses[size],
  className,
].filter(Boolean).join(' ');
---

{href ? (
  <a href={href} class={classes} aria-label={ariaLabel}>
    <slot />
  </a>
) : (
  <button type={type} class={classes} disabled={disabled} aria-label={ariaLabel}>
    <slot />
  </button>
)}
