---
export interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'dark';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  class?: string;
  ariaLabel?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  disabled = false,
  class: className = '',
  ariaLabel,
} = Astro.props;

const baseClasses = 'inline-flex items-center justify-center gap-2 font-semibold transition-all duration-200 active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cargo-emerald focus-visible:ring-offset-2 focus-visible:ring-offset-cargo-deep';

const variantClasses = {
  primary: 'btn-primary',
  secondary: 'btn-secondary',
  ghost: 'btn-ghost',
  dark: 'inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg bg-cargo-deep text-white font-semibold border border-white/20 hover:bg-cargo-ink transition-all duration-200 active:scale-95 disabled:opacity-50',
};

const sizeClasses = {
  sm: 'text-xs px-4 py-2',
  md: 'text-sm px-6 py-3',
  lg: 'text-base px-8 py-4',
};

const classes = [
  baseClasses,
  variantClasses[variant],
  variant === 'primary' || variant === 'secondary' || variant === 'dark' ? sizeClasses[size] : '',
  className,
].filter(Boolean).join(' ');
---

{href ? (
  <a
    href={href}
    class={classes}
    aria-label={ariaLabel}
    role={ariaLabel ? 'button' : undefined}
  >
    <slot />
  </a>
) : (
  <button
    type={type}
    class={classes}
    disabled={disabled}
    aria-label={ariaLabel}
  >
    <slot />
  </button>
)}
