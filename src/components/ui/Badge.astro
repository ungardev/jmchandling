---
export interface Props {
  variant?: 'cert' | 'inac' | 'sms' | 'esea';
  size?: 'sm' | 'md';
  class?: string;
}

const { variant = 'cert', size = 'md', class: className = '' } = Astro.props;

const iconMap: Record<string, string> = {
  cert: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />`,
  inac: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />`,
  sms: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />`,
  esea: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064" />`,
};

const variantStyles = {
  cert: 'bg-cargo-emerald/20 text-cargo-emerald border-cargo-emerald/30',
  inac: 'bg-cargo-light/20 text-cargo-light border-cargo-light/30',
  sms: 'bg-white/10 text-white border-white/20',
  esea: 'bg-cargo-deep text-cargo-light border-cargo-deep/50',
};

const sizeClasses = {
  sm: 'px-2 py-0.5 text-[10px]',
  md: 'px-3 py-1 text-xs',
};

const classes = [
  'inline-flex items-center gap-1.5 rounded-full font-semibold border',
  variantStyles[variant],
  sizeClasses[size],
  className,
].filter(Boolean).join(' ');
---

<span class={classes}>
  <svg
    class="w-3 h-3 flex-shrink-0"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
    aria-hidden="true"
    set:html={iconMap[variant]}
  />
  <slot />
</span>
