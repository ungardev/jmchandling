---
export interface Props {
  variant?: 'cert' | 'inac' | 'sms' | 'esea';
  size?: 'sm' | 'md';
  class?: string;
}

const { variant = 'cert', size = 'md', class: className = '' } = Astro.props;

const variantStyles = {
  cert: 'border-cargo-emerald/60 text-cargo-emerald',
  inac: 'border-cargo-light/60 text-cargo-light',
  sms: 'border-cargo-white/40 text-cargo-white',
  esea: 'border-cargo-deep/50 text-cargo-deep',
};

const sizeClasses = {
  sm: 'px-2 py-1 text-xs',
  md: 'px-2.5 py-1.5 text-xs',
};

const classes = [
  'inline-flex items-center gap-2 rounded-sm border font-mono font-medium uppercase tracking-[0.08em]',
  variantStyles[variant],
  sizeClasses[size],
  className,
].filter(Boolean).join(' ');
---

<span class={classes}>
  <span class="h-1.5 w-1.5 rounded-full bg-current" aria-hidden="true"></span>
  <slot />
</span>
