---
/**
 * Marcas alegoricas de habilitacion.
 *
 * No son emblemas de INAC, del Estado ni de la JMC: son pictogramas
 * geometricos que representan el CONCEPTO de cada credencial (autorizacion,
 * sistema gestionado, norma). El hecho verificable vive siempre en el texto
 * que acompana a la marca (codigo, emisor, vigencia), nunca en el dibujo.
 *
 * Reglas:
 * - Sin hojas de laurel, sin escudos de Estado, sin cintas, sin estrellas:
 *   nada que pueda leerse como un sello oficial.
 * - `aria-hidden`: la marca es decorativa. El lector de pantalla anuncia el
 *   codigo y el texto, no "un sello de certificacion".
 * - Monolinea, `currentColor`, trazo 1.6 sobre retícula de 48.
 * - El acento se puede cambiar con `accentClass` (por defecto cargo-emerald,
 *   4.31:1 sobre cargo-deep; sobre superficie clara usa cargo-deep).
 */
export interface Props {
  /** cesea = autorizacion del explotador · sms = sistema gestionado · rav = norma. */
  name: 'cesea' | 'sms' | 'rav';
  class?: string;
  /** Clase de color del elemento de acento. */
  accentClass?: string;
}

const { name, class: className = 'h-12 w-12 text-cargo-light', accentClass = 'text-cargo-emerald' } = Astro.props;
---

{
  name === 'cesea' && (
    <svg
      class={className}
      viewBox="0 0 48 48"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="square"
      stroke-linejoin="miter"
      aria-hidden="true"
    >
      <rect x="0.8" y="0.8" width="46.4" height="46.4" />
      {/* Escudo: la autorizacion concedida. */}
      <path d="M13 12h22v12.5c0 6.3-6.6 10.6-11 12.1-4.4-1.5-11-5.8-11-12.1z" />
      {/* En vuelo sobre la plataforma: el alcance del servicio. */}
      <path d="M18 26.5l6-5 6 5" class={accentClass} />
      <path d="M17.5 30h13" class={accentClass} />
    </svg>
  )
}

{
  name === 'sms' && (
    <svg
      class={className}
      viewBox="0 0 48 48"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="square"
      stroke-linejoin="miter"
      aria-hidden="true"
    >
      <rect x="0.8" y="0.8" width="46.4" height="46.4" />
      {/* Tres procesos periféricos alrededor de un nucleo: un sistema. */}
      <path d="M24 12.5L14 31.5h20zM24 12.5v11M14 31.5l10-8 10 8" />
      <circle cx="24" cy="12.5" r="2.6" fill="currentColor" stroke="none" />
      <circle cx="14" cy="31.5" r="2.6" fill="currentColor" stroke="none" />
      <circle cx="34" cy="31.5" r="2.6" fill="currentColor" stroke="none" />
      <circle cx="24" cy="23.5" r="2.6" fill="none" class={accentClass} />
    </svg>
  )
}

{
  name === 'rav' && (
    <svg
      class={className}
      viewBox="0 0 48 48"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="square"
      stroke-linejoin="miter"
      aria-hidden="true"
    >
      <rect x="0.8" y="0.8" width="46.4" height="46.4" />
      {/* Una regla graduada: en español, "regla" es tambien la norma. */}
      <path d="M14 12v24" />
      <path d="M14 15h19M14 20h19" />
      <path d="M14 25h19" class={accentClass} />
      <path d="M14 30h19M14 35h19" />
    </svg>
  )
}
