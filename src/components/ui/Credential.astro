---
import type { Locale } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';
import ArrowUpRight from './icons/ArrowUpRight.astro';

export interface Props {
  locale: Locale;
  code: string;
  title: string;
  issuer: string;
  validity?: string;
  evidenceHref?: string;
  evidenceLabel?: string;
}

const {
  locale,
  code,
  title,
  issuer,
  validity,
  evidenceHref,
  evidenceLabel,
} = Astro.props;
const t = useTranslations(locale);
---

<article class="flex h-full flex-col border-t border-cargo-white/20 pt-5">
  <p class="flex items-center gap-2.5 font-mono text-xl font-semibold tracking-[-0.02em] text-cargo-light sm:text-2xl">
    <span class="h-2 w-2 shrink-0 rounded-full bg-cargo-emerald" aria-hidden="true"></span>
    {code}
  </p>
  <p class="mt-4 text-base font-medium leading-snug text-cargo-white">{title}</p>
  <p class="mt-3 text-sm leading-relaxed text-cargo-white/75">{issuer}</p>

  {validity && (
    <p class="mt-auto pt-4 font-mono text-xs uppercase tracking-[0.08em] text-cargo-light/90">{validity}</p>
  )}

  {
    evidenceHref && (
      <a
        href={evidenceHref}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-cargo-light underline decoration-cargo-emerald underline-offset-4 transition-colors hover:text-cargo-white"
      >
        {evidenceLabel ?? t('safety.mediaLink')}
        <ArrowUpRight class="h-3.5 w-3.5" />
      </a>
    )
  }
</article>
