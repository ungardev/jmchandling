---
export interface Props {
  id?: string;
  class?: string;
  ariaLabel?: string;
  background?: 'dark' | 'deep' | 'mist' | 'transparent';
  padY?: 'none' | 'sm' | 'md' | 'lg' | 'xl';
}

const {
  id,
  class: className = '',
  ariaLabel,
  background = 'dark',
  padY = 'lg',
} = Astro.props;

const bgClasses = {
  dark: 'bg-cargo-ink text-cargo-white',
  deep: 'bg-cargo-deep text-cargo-white',
  mist: 'bg-cargo-mist text-cargo-ink',
  transparent: 'bg-transparent',
};

const padClasses = {
  none: '',
  sm: 'py-8',
  md: 'py-12 md:py-16',
  lg: 'py-20 md:py-28',
  xl: 'py-28 md:py-40',
};

const classes = [bgClasses[background], padClasses[padY], className].filter(Boolean).join(' ');
---

<section id={id} class={classes} aria-label={ariaLabel}>
  <div class="container-max">
    <slot />
  </div>
</section>
