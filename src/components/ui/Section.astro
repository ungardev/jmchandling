---
export interface Props {
  id?: string;
  class?: string;
  /**
   * Nombre accesible de la seccion. Se prefiere `ariaLabelledBy` (apunta al
   * `<h2>`) para no repetir el mismo texto en el titulo visible y en el
   * nombre de la region.
   */
  ariaLabel?: string;
  ariaLabelledBy?: string;
  background?: 'deep' | 'mist' | 'transparent' | 'white' | 'cargo-light' | 'cargo-ink';
  padY?: 'none' | 'sm' | 'md' | 'lg' | 'xl';
}

const {
  id,
  class: className = '',
  ariaLabel,
  ariaLabelledBy,
  background = 'deep',
  padY = 'lg',
} = Astro.props;

const bgClasses = {
  deep: 'bg-cargo-deep text-cargo-white',
  mist: 'bg-cargo-mist text-cargo-ink',
  transparent: 'bg-transparent',
  white: 'bg-cargo-white text-cargo-ink',
  'cargo-light': 'bg-cargo-light text-cargo-deep',
  'cargo-ink': 'bg-cargo-ink text-cargo-white',
};

const padClasses = {
  none: '',
  sm: 'py-8',
  md: 'py-12 md:py-16',
  lg: 'py-20 md:py-28',
  xl: 'py-28 md:py-40',
};

const classes = [bgClasses[background], padClasses[padY], className].filter(Boolean).join(' ');
---

<section
  id={id}
  class={classes}
  aria-label={ariaLabelledBy ? undefined : ariaLabel}
  aria-labelledby={ariaLabelledBy}
>
  <div class="container-max">
    <slot />
  </div>
</section>
