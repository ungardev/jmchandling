      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap');\n</style>\n<main class=\"min-h-screen bg-[var(--cargo-mist)] text-[var(--cargo-ink)] antialiased\" data-kid=\"1\" data-name=\"page layout container\" style=\"--cargo-deep:#0F3E51;--cargo-light:#A0DDF5;--cargo-emerald:#5BA8C7;--cargo-ink:#0A1F2B;--cargo-mist:#F5F8FA;--cargo-white:#FFFFFF;font-family:'Inter',sans-serif;\">\n    <header class=\"bg-[var(--cargo-deep)] text-[var(--cargo-white)]\" data-kid=\"1-1\" data-name=\"header container\">\n        <div class=\"mx-auto flex min-h-[78px] max-w-[1320px] items-center justify-between gap-8 px-8 xl:px-12\" data-kid=\"1-1-1\" data-name=\"header content wrapper\">\n            <a aria-label=\"JMC Servicios Especializados\" class=\"flex items-center gap-3.5\" data-kid=\"1-1-1-1\" data-name=\"brand logo link\" href=\"#inicio\">\n                <img alt=\"\" aria-hidden=\"true\" class=\"h-11 w-auto object-contain\" data-kid=\"1-1-1-1-1\" data-name=\"brand isotipo icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/assets/brand/isotipo-logo.webp\"/>\n                <img alt=\"JMC Servicios Especializados\" class=\"h-8 w-auto object-contain\" data-kid=\"1-1-1-1-2\" data-name=\"brand name text\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/assets/brand/fuente-logo.webp\"/>\n            </a>\n            <nav aria-label=\"Navegación principal\" class=\"hidden items-center gap-9 text-sm font-medium md:flex\" data-kid=\"1-1-1-2\" data-name=\"main navigation menu\">\n                <a class=\"text-[var(--cargo-white)]/90 hover:text-[var(--cargo-light)]\" data-kid=\"1-1-1-2-1\" data-name=\"navigation link inicio\" href=\"#inicio\">\n                    Inicio\n                </a>\n                <a class=\"text-[var(--cargo-white)]/75 hover:text-[var(--cargo-white)]\" data-kid=\"1-1-1-2-2\" data-name=\"navigation link alcance\" href=\"#alcance\">\n                    Alcance\n                </a>\n                <a class=\"text-[var(--cargo-white)]/75 hover:text-[var(--cargo-white)]\" data-kid=\"1-1-1-2-3\" data-name=\"navigation link empresa\" href=\"#empresa\">\n                    Empresa\n                </a>\n                <a class=\"text-[var(--cargo-white)]/75 hover:text-[var(--cargo-white)]\" data-kid=\"1-1-1-2-4\" data-name=\"navigation link contacto\" href=\"#contacto\">\n                    Contacto\n                </a>\n            </nav>\n            <div class=\"flex items-center gap-5\" data-kid=\"1-1-1-3\" data-name=\"header utility actions container\">\n                <span class=\"font-mono text-xs tracking-[0.12em] text-[var(--cargo-light)]\" data-kid=\"1-1-1-3-1\" data-name=\"language selector text\">\n                    ES\n                    <span class=\"text-[var(--cargo-white)]/40\" data-kid=\"1-1-1-3-1-1\" data-name=\"language separator slash\">\n                        /\n                    </span>\n                    EN\n                </span>\n                <a class=\"hidden rounded-sm bg-[var(--cargo-light)] px-5 py-3 text-sm font-semibold text-[var(--cargo-deep)] transition-colors hover:bg-[var(--cargo-white)] sm:inline-flex\" data-kid=\"1-1-1-3-2\" data-name=\"request information cta button\" href=\"#contacto\">\n                    Solicitar información\n                    <span aria-hidden=\"true\" class=\"ml-3\" data-kid=\"1-1-1-3-2-1\" data-name=\"cta arrow icon\">\n                        ↗\n                    </span>\n                </a>\n            </div>\n        </div>\n    </header>\n    <section class=\"bg-[var(--cargo-deep)] text-[var(--cargo-white)]\" data-kid=\"1-2\" data-name=\"hero section\" id=\"inicio\">\n        <div class=\"mx-auto grid max-w-[1320px] items-center gap-12 px-8 pb-14 pt-12 md:grid-cols-[0.91fr_1.09fr] md:gap-14 md:pb-16 md:pt-14 xl:px-12 xl:gap-20\" data-kid=\"1-2-1\" data-name=\"hero content grid\">\n            <div class=\"max-w-[610px]\" data-kid=\"1-2-1-1\" data-name=\"hero text content block\">\n                <p class=\"font-mono text-xs uppercase tracking-[0.13em] text-[var(--cargo-light)]\" data-kid=\"1-2-1-1-1\" data-name=\"location subtitle text\">\n                    Maiquetía · Venezuela\n                </p>\n                <h1 class=\"mt-6 max-w-[580px] text-balance text-5xl font-semibold leading-[1.02] tracking-[-0.045em] sm:text-6xl xl:text-[68px]\" data-kid=\"1-2-1-1-2\" data-name=\"hero main headline\">\n                    Servicios en tierra para cada operación aérea.\n                </h1>\n                <p class=\"mt-7 max-w-[520px] text-lg leading-relaxed text-[var(--cargo-white)]/80\" data-kid=\"1-2-1-1-3\" data-name=\"hero description text\">\n                    Handling, operador de base fija y equipos de apoyo terrestre en el Aeropuerto Internacional Simón Bolívar de Maiquetía.\n                </p>\n                <div class=\"mt-9 flex flex-wrap items-center gap-x-8 gap-y-4\" data-kid=\"1-2-1-1-4\" data-name=\"hero call to action group\">\n                    <a class=\"inline-flex items-center rounded-sm bg-[var(--cargo-light)] px-6 py-4 text-sm font-semibold text-[var(--cargo-deep)] transition-colors hover:bg-[var(--cargo-white)]\" data-kid=\"1-2-1-1-4-1\" data-name=\"primary cta button\" href=\"#alcance\">\n                        Consultar alcance completo\n                        <span aria-hidden=\"true\" class=\"ml-4\" data-kid=\"1-2-1-1-4-1-1\" data-name=\"primary cta arrow icon\">\n                            ↗\n                        </span>\n                    </a>\n                    <a class=\"inline-flex items-center py-3 text-sm font-semibold text-[var(--cargo-white)]/85 underline decoration-[var(--cargo-light)]/55 underline-offset-[7px] hover:text-[var(--cargo-light)]\" data-kid=\"1-2-1-1-4-2\" data-name=\"secondary cta link\" href=\"#contacto\">\n                        Enviar una solicitud\n                    </a>\n                </div>\n                <p class=\"mt-9 border-t border-[var(--cargo-white)]/20 pt-5 text-sm text-[var(--cargo-white)]/65\" data-kid=\"1-2-1-1-5\" data-name=\"operational summary text\">\n                    Atención a aeronaves, pasajeros, equipaje y carga con personal capacitado y equipos GSE.\n                </p>\n            </div>\n            <figure class=\"relative m-0\" data-kid=\"1-2-1-2\" data-name=\"hero visual figure\">\n                <div class=\"overflow-hidden rounded-sm bg-[var(--cargo-ink)]\" data-kid=\"1-2-1-2-1\" data-name=\"gse fleet image container\">\n                    <img alt=\"Equipos de apoyo terrestre de JMC en la plataforma de Maiquetía\" class=\"aspect-[1.28/1] w-full object-cover md:aspect-[1.15/1] xl:aspect-[1.2/1]\" data-kid=\"1-2-1-2-1-1\" data-name=\"gse fleet image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/assets/images/gse-fleet.webp\"/>\n                </div>\n                <figcaption class=\"mt-3 flex items-center justify-between gap-4 font-mono text-xs uppercase tracking-[0.09em] text-[var(--cargo-light)]/85\" data-kid=\"1-2-1-2-2\" data-name=\"image caption container\">\n                    <span data-kid=\"1-2-1-2-2-1\" data-name=\"image description text\">\n                        Equipo de apoyo terrestre en plataforma\n                    </span>\n                    <span data-kid=\"1-2-1-2-2-2\" data-name=\"location identifier text\">\n                        JMC · CCS\n                    </span>\n                </figcaption>\n            </figure>\n        </div>\n    </section>\n    <section aria-label=\"Trayectoria de la empresa\" class=\"border-b border-[var(--cargo-deep)]/10 bg-[var(--cargo-white)]\" data-kid=\"1-3\" data-name=\"company history section\">\n        <div class=\"mx-auto grid max-w-[1320px] gap-0 px-8 md:grid-cols-[1fr_1fr_1.4fr] xl:px-12\" data-kid=\"1-3-1\" data-name=\"history items grid\">\n            <div class=\"flex items-center gap-5 border-b border-[var(--cargo-deep)]/10 py-7 md:border-b-0 md:border-r md:py-8 md:pr-8\" data-kid=\"1-3-1-1\" data-name=\"foundation year item\">\n                <span class=\"font-mono text-4xl font-medium tracking-[-0.06em] text-[var(--cargo-deep)]\" data-kid=\"1-3-1-1-1\" data-name=\"foundation year number\">\n                    2012\n                </span>\n                <span class=\"max-w-28 text-xs leading-snug text-[var(--cargo-ink)]/70\" data-kid=\"1-3-1-1-2\" data-name=\"foundation description text\">\n                    Constitución de Servicios Especializados JMC\n                </span>\n            </div>\n            <div class=\"flex items-center gap-5 border-b border-[var(--cargo-deep)]/10 py-7 md:border-b-0 md:border-r md:px-8 md:py-8\" data-kid=\"1-3-1-2\" data-name=\"milestone year item\">\n                <span class=\"font-mono text-4xl font-medium tracking-[-0.06em] text-[var(--cargo-deep)]\" data-kid=\"1-3-1-2-1\" data-name=\"milestone year number\">\n                    2015\n                </span>\n                <span class=\"max-w-32 text-xs leading-snug text-[var(--cargo-ink)]/70\" data-kid=\"1-3-1-2-2\" data-name=\"milestone description text\">\n                    Inicio de servicios especializados en Maiquetía\n                </span>\n            </div>\n            <p class=\"flex items-center py-6 text-sm leading-relaxed text-[var(--cargo-ink)]/75 md:pl-10 md:py-8\" data-kid=\"1-3-1-3\" data-name=\"about us brief paragraph\">\n                Una empresa venezolana creada por profesionales con más de 30 años de experiencia en el sector aeronáutico.\n            </p>\n        </div>\n    </section>\n    <section class=\"bg-[var(--cargo-mist)]\" data-kid=\"1-4\" data-name=\"services reach section\" id=\"alcance\">\n        <div class=\"mx-auto max-w-[1320px] px-8 py-20 md:py-24 xl:px-12\" data-kid=\"1-4-1\" data-name=\"services content container\">\n            <div class=\"grid gap-8 border-b border-[var(--cargo-deep)]/15 pb-10 md:grid-cols-[0.72fr_1.28fr] md:items-end\" data-kid=\"1-4-1-1\" data-name=\"services header grid\">\n                <h2 class=\"max-w-[470px] text-balance text-4xl font-semibold leading-[1.05] tracking-[-0.04em] text-[var(--cargo-deep)] sm:text-5xl\" data-kid=\"1-4-1-1-1\" data-name=\"services section headline\">\n                    Tres ámbitos bajo la habilitación aeroportuaria.\n                </h2>\n                <p class=\"max-w-[610px] text-base leading-relaxed text-[var(--cargo-ink)]/75\" data-kid=\"1-4-1-1-2\" data-name=\"services section subheadline\">\n                    El alcance formal comprende equipos de apoyo terrestre en plataforma, operación de base fija y mantenimiento de GSE.\n                </p>\n            </div>\n            <div class=\"divide-y divide-[var(--cargo-deep)]/15\" data-kid=\"1-4-1-2\" data-name=\"services list container\">\n                <article class=\"grid gap-4 py-7 sm:grid-cols-[0.45fr_1.2fr_0.75fr] sm:items-start sm:gap-8 md:py-8\" data-kid=\"1-4-1-2-1\" data-name=\"platform services article\">\n                    <h3 class=\"text-xl font-semibold tracking-[-0.025em] text-[var(--cargo-deep)]\" data-kid=\"1-4-1-2-1-1\" data-name=\"platform services title\">\n                        Equipos de apoyo terrestre en plataforma\n                    </h3>\n                    <p class=\"max-w-[500px] text-sm leading-relaxed text-[var(--cargo-ink)]/75\" data-kid=\"1-4-1-2-1-2\" data-name=\"platform services description\">\n                        Atención de aeronaves de pasajeros y carga con equipos GSE en plataforma.\n                    </p>\n                    <p class=\"font-mono text-xs leading-relaxed text-[var(--cargo-deep)]\" data-kid=\"1-4-1-2-1-3\" data-name=\"platform services scope info\">\n                        Secciones 1–8\n                    </p>\n                </article>\n                <article class=\"grid gap-4 py-7 sm:grid-cols-[0.45fr_1.2fr_0.75fr] sm:items-start sm:gap-8 md:py-8\" data-kid=\"1-4-1-2-2\" data-name=\"obf services article\">\n                    <h3 class=\"text-xl font-semibold tracking-[-0.025em] text-[var(--cargo-deep)]\" data-kid=\"1-4-1-2-2-1\" data-name=\"obf services title\">\n                        Operador de Base Fija (OBF)\n                    </h3>\n                    <p class=\"max-w-[500px] text-sm leading-relaxed text-[var(--cargo-ink)]/75\" data-kid=\"1-4-1-2-2-2\" data-name=\"obf services description\">\n                        Despacho y seguimiento de aeronaves, guía de estacionamiento y atención en tierra según el alcance documentado.\n                    </p>\n                    <p class=\"font-mono text-xs leading-relaxed text-[var(--cargo-deep)]\" data-kid=\"1-4-1-2-2-3\" data-name=\"obf services scope info\">\n                        Secciones 1 · 4 · 6 · 7\n                    </p>\n                </article>\n                <article class=\"grid gap-4 py-7 sm:grid-cols-[0.45fr_1.2fr_0.75fr] sm:items-start sm:gap-8 md:py-8\" data-kid=\"1-4-1-2-3\" data-name=\"gse maintenance services article\">\n                    <h3 class=\"text-xl font-semibold tracking-[-0.025em] text-[var(--cargo-deep)]\" data-kid=\"1-4-1-2-3-1\" data-name=\"gse maintenance services title\">\n                        Mantenimiento de equipos GSE\n                    </h3>\n                    <p class=\"max-w-[500px] text-sm leading-relaxed text-[var(--cargo-ink)]/75\" data-kid=\"1-4-1-2-3-2\" data-name=\"gse maintenance services description\">\n                        Mantenimiento de los equipos de apoyo terrestre que respaldan la operación aeroportuaria.\n                    </p>\n                    <p class=\"font-mono text-xs leading-relaxed text-[var(--cargo-deep)]\" data-kid=\"1-4-1-2-3-3\" data-name=\"gse maintenance services scope info\">\n                        Servicio especializado aeroportuario\n                    </p>\n                </article>\n            </div>\n            <div class=\"mt-9\" data-kid=\"1-4-1-3\" data-name=\"view services catalogue link\">\n                <a class=\"inline-flex items-center gap-4 text-sm font-semibold text-[var(--cargo-deep)] underline decoration-[var(--cargo-emerald)] underline-offset-[7px] hover:text-[var(--cargo-emerald)]\" data-kid=\"1-4-1-3-1\" data-name=\"view catalogue link text\" href=\"#catalogo\">\n                    Ver servicios y alcance documentado\n                    <span aria-hidden=\"true\" data-kid=\"1-4-1-3-1-1\" data-name=\"catalogue arrow icon\">\n                        ↗\n                    </span>\n                </a>\n            </div>\n        </div>\n    </section>\n    <section class=\"bg-[var(--cargo-white)]\" data-kid=\"1-5\" data-name=\"company philosophy section\" id=\"empresa\">\n        <div class=\"mx-auto grid max-w-[1320px] gap-14 px-8 py-20 md:grid-cols-[0.84fr_1.16fr] md:gap-20 md:py-24 xl:px-12\" data-kid=\"1-5-1\" data-name=\"philosophy grid container\">\n            <div class=\"flex flex-col justify-between gap-8\" data-kid=\"1-5-1-1\" data-name=\"philosophy text and image\">\n                <div data-kid=\"1-5-1-1-1\" data-name=\"philosophy header block\">\n                    <h2 class=\"max-w-[380px] text-balance text-4xl font-semibold leading-[1.07] tracking-[-0.04em] text-[var(--cargo-deep)] sm:text-5xl\" data-kid=\"1-5-1-1-1-1\" data-name=\"philosophy headline\">\n                        Una empresa especializada en el trabajo de tierra.\n                    </h2>\n                    <p class=\"mt-6 max-w-[420px] text-base leading-relaxed text-[var(--cargo-ink)]/75\" data-kid=\"1-5-1-1-1-2\" data-name=\"philosophy description\">\n                        Servicios Especializados JMC acompaña las operaciones de aerolíneas en Maiquetía con personal capacitado y equipos de apoyo terrestre.\n                    </p>\n                </div>\n                <div class=\"overflow-hidden rounded-sm bg-[var(--cargo-mist)]\" data-kid=\"1-5-1-1-2\" data-name=\"maintenance image container\">\n                    <img alt=\"Personal de JMC realizando mantenimiento de equipos de apoyo terrestre\" class=\"aspect-[1.55/1] w-full object-cover\" data-kid=\"1-5-1-1-2-1\" data-name=\"maintenance image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/assets/images/gse-maintenance.webp\"/>\n                </div>\n            </div>\n            <div class=\"flex flex-col justify-center\" data-kid=\"1-5-1-2\" data-name=\"mission vision block\">\n                <div class=\"grid gap-8 border-y border-[var(--cargo-deep)]/15 py-8 md:grid-cols-2 md:gap-10 md:py-10\" data-kid=\"1-5-1-2-1\" data-name=\"mission vision grid\">\n                    <article data-kid=\"1-5-1-2-1-1\" data-name=\"mission article\">\n                        <h3 class=\"font-mono text-xs uppercase tracking-[0.1em] text-[var(--cargo-emerald)]\" data-kid=\"1-5-1-2-1-1-1\" data-name=\"mission header\">\n                            Misión\n                        </h3>\n                        <p class=\"mt-4 text-lg leading-relaxed text-[var(--cargo-deep)]\" data-kid=\"1-5-1-2-1-1-2\" data-name=\"mission text\">\n                            Ofrecer servicios aeroportuarios a la medida, con capital humano especializado, procesos innovadores y excelencia en la atención y la operación.\n                        </p>\n                    </article>\n                    <article class=\"md:border-l md:border-[var(--cargo-deep)]/15 md:pl-9\" data-kid=\"1-5-1-2-1-2\" data-name=\"vision article\">\n                        <h3 class=\"font-mono text-xs uppercase tracking-[0.1em] text-[var(--cargo-emerald)]\" data-kid=\"1-5-1-2-1-2-1\" data-name=\"vision header\">\n                            Visión\n                        </h3>\n                        <p class=\"mt-4 text-lg leading-relaxed text-[var(--cargo-deep)]\" data-kid=\"1-5-1-2-1-2-2\" data-name=\"vision text\">\n                            Consolidar el liderazgo en servicios aeroportuarios especializados en Venezuela mediante calidad, innovación y adaptación.\n                        </p>\n                    </article>\n                </div>\n                <p class=\"mt-7 font-mono text-[11px] leading-relaxed text-[var(--cargo-ink)]/55\" data-kid=\"1-5-1-2-2\" data-name=\"philosophy source disclaimer\">\n                    Síntesis de la misión y visión publicadas en la documentación organizacional de JMC.\n                </p>\n            </div>\n        </div>\n    </section>\n    <section class=\"bg-[var(--cargo-deep)] text-[var(--cargo-white)]\" data-kid=\"1-6\" data-name=\"certification section\">\n        <div class=\"mx-auto grid max-w-[1320px] gap-12 px-8 py-14 md:grid-cols-[0.8fr_1.2fr] md:items-center md:py-16 xl:px-12\" data-kid=\"1-6-1\" data-name=\"certification grid\">\n            <div data-kid=\"1-6-1-1\" data-name=\"certification description block\">\n                <h2 class=\"max-w-[430px] text-balance text-3xl font-semibold leading-tight tracking-[-0.035em] sm:text-4xl\" data-kid=\"1-6-1-1-1\" data-name=\"certification headline\">\n                    Un alcance respaldado por documentación operacional.\n                </h2>\n                <p class=\"mt-5 max-w-[450px] text-sm leading-relaxed text-[var(--cargo-white)]/75\" data-kid=\"1-6-1-1-2\" data-name=\"certification subtext\">\n                    Servicios Especializados JMC presta servicios de acuerdo con la Regulación Aeronáutica Venezolana 111 (RAV 111). Consulte el documento del explotador.\n                </p>\n                <a class=\"mt-7 inline-flex items-center gap-3 text-sm font-semibold text-[var(--cargo-light)] underline decoration-[var(--cargo-light)]/60 underline-offset-[7px] hover:text-[var(--cargo-white)]\" data-kid=\"1-6-1-1-3\" data-name=\"view certificate link\" href=\"/api/local/images/public/assets/images/cesea-cert.webp\" rel=\"noopener noreferrer\" target=\"_blank\">\n                    Consultar certificado\n                    <span aria-hidden=\"true\" data-kid=\"1-6-1-1-3-1\" data-name=\"certificate link arrow icon\">\n                        ↗\n                    </span>\n                </a>\n            </div>\n            <figure class=\"m-0 grid gap-3 sm:grid-cols-[1fr_auto] sm:items-end\" data-kid=\"1-6-1-2\" data-name=\"certificate figure\">\n                <div class=\"overflow-hidden rounded-sm border border-[var(--cargo-light)]/25 bg-[var(--cargo-mist)] p-3\" data-kid=\"1-6-1-2-1\" data-name=\"certificate image container\">\n                    <img alt=\"Certificado de Servicios Especializados JMC que acredita el cumplimiento de la RAV 111\" class=\"max-h-[258px] w-full object-contain\" data-kid=\"1-6-1-2-1-1\" data-name=\"certificate image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/assets/images/cesea-cert.webp\"/>\n                </div>\n                <figcaption class=\"font-mono text-xs uppercase leading-relaxed tracking-[0.07em] text-[var(--cargo-white)]/60\" data-kid=\"1-6-1-2-2\" data-name=\"certificate caption\">\n                    Certificado del explotador\n                    <br data-kid=\"1-6-1-2-2-1\" data-name=\"caption line break\"/>\n                    RAV 111\n                </figcaption>\n            </figure>\n        </div>\n    </section>\n    <section class=\"bg-[var(--cargo-light)] text-[var(--cargo-deep)]\" data-kid=\"1-7\" data-name=\"catalogue CTA section\" id=\"catalogo\">\n        <div class=\"mx-auto flex max-w-[1320px] flex-col gap-8 px-8 py-14 md:flex-row md:items-center md:justify-between md:py-16 xl:px-12\" data-kid=\"1-7-1\" data-name=\"catalogue CTA grid\">\n            <div data-kid=\"1-7-1-1\" data-name=\"catalogue CTA text block\">\n                <h2 class=\"max-w-[620px] text-balance text-4xl font-semibold leading-[1.05] tracking-[-0.04em] sm:text-5xl\" data-kid=\"1-7-1-1-1\" data-name=\"catalogue CTA headline\">\n                    Consulte el catálogo completo de capacidades.\n                </h2>\n                <p class=\"mt-4 max-w-[600px] text-base leading-relaxed text-[var(--cargo-deep)]/80\" data-kid=\"1-7-1-1-2\" data-name=\"catalogue CTA description\">\n                    Servicios de plataforma, OBF, cuidado de aeronaves, atención al pasajero y mantenimiento de GSE.\n                </p>\n            </div>\n            <a class=\"inline-flex shrink-0 items-center justify-center gap-5 rounded-sm bg-[var(--cargo-deep)] px-7 py-5 text-sm font-semibold text-[var(--cargo-white)] transition-colors hover:bg-[var(--cargo-ink)]\" data-kid=\"1-7-1-2\" data-name=\"catalogue CTA button\" href=\"/es/servicios\">\n                Abrir catálogo de servicios\n                <span aria-hidden=\"true\" data-kid=\"1-7-1-2-1\" data-name=\"catalogue arrow icon\">\n                    ↗\n                </span>\n            </a>\n        </div>\n    </section>\n    <footer class=\"bg-[var(--cargo-ink)] text-[var(--cargo-white)]\" data-kid=\"1-8\" data-name=\"footer\" id=\"contacto\">\n        <div class=\"mx-auto grid max-w-[1320px] gap-10 px-8 py-12 md:grid-cols-[1fr_auto] md:items-end xl:px-12\" data-kid=\"1-8-1\" data-name=\"footer contact grid\">\n            <div data-kid=\"1-8-1-1\" data-name=\"footer brand block\">\n                <a aria-label=\"Volver al inicio\" class=\"inline-flex items-center gap-3\" data-kid=\"1-8-1-1-1\" data-name=\"footer logo link\" href=\"#inicio\">\n                    <img alt=\"\" aria-hidden=\"true\" class=\"h-9 w-auto\" data-kid=\"1-8-1-1-1-1\" data-name=\"footer isotipo icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/assets/brand/isotipo-logo.webp\"/>\n                    <img alt=\"JMC Servicios Especializados\" class=\"h-7 w-auto\" data-kid=\"1-8-1-1-1-2\" data-name=\"footer brand name text\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/assets/brand/fuente-logo.webp\"/>\n                </a>\n                <p class=\"mt-5 max-w-[500px] text-sm leading-relaxed text-[var(--cargo-white)]/70\" data-kid=\"1-8-1-1-2\" data-name=\"footer company details\">\n                    Servicios Especializados JMC, C.A. · Aeropuerto Internacional Simón Bolívar de Maiquetía, Venezuela.\n                </p>\n            </div>\n            <div class=\"flex flex-col gap-3 text-sm\" data-kid=\"1-8-1-2\" data-name=\"footer contact links\">\n                <a class=\"text-[var(--cargo-light)] hover:text-[var(--cargo-white)]\" data-kid=\"1-8-1-2-1\" data-name=\"email contact link\" href=\"mailto:customer.service@jmchandling.com\">\n                    customer.service@jmchandling.com\n                </a>\n                <a class=\"text-[var(--cargo-white)]/80 hover:text-[var(--cargo-white)]\" data-kid=\"1-8-1-2-2\" data-name=\"phone contact link\" href=\"tel:+584141180806\">\n                    +58 414 118 0806\n                </a>\n            </div>\n        </div>\n        <div class=\"border-t border-[var(--cargo-white)]/10\" data-kid=\"1-8-2\" data-name=\"footer bottom bar\">\n            <div class=\"mx-auto flex max-w-[1320px] flex-col gap-3 px-8 py-5 text-xs text-[var(--cargo-white)]/45 sm:flex-row sm:items-center sm:justify-between xl:px-12\" data-kid=\"1-8-2-1\" data-name=\"footer bottom content\">\n                <span data-kid=\"1-8-2-1-1\" data-name=\"copyright text\">\n                    © 2026 Servicios Especializados JMC, C.A.\n                </span>\n                <span class=\"font-mono tracking-[0.05em]\" data-kid=\"1-8-2-1-2\" data-name=\"footer location tag\">\n                    Servicios especializados aeroportuarios · Maiquetía\n                </span>\n            </div>\n        </div>\n    </footer>\n</main>\n",
      "comments": [],
      "created": "2026-10-04T15:27:58.120578+00:00",
