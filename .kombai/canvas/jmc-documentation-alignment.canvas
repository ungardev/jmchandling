    },
    "var_bba6d54b0d19": {
      "type": "variant",
      "label": "Propuesta 1 · Evidencia | Servicios",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 6160,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap');\n</style>\n<main class=\"min-h-screen bg-[var(--cargo-mist)] font-[Inter] text-[var(--cargo-ink)]\" data-kid=\"1\" data-name=\"page layout container\" style=\"--cargo-deep:#0F3E51;--cargo-light:#A0DDF5;--cargo-emerald:#5BA8C7;--cargo-ink:#0A1F2B;--cargo-mist:#F5F8FA;--cargo-white:#FFFFFF;\">\n    <header class=\"bg-[var(--cargo-deep)] text-[var(--cargo-white)]\" data-kid=\"1-1\" data-name=\"header navigation container\">\n        <div class=\"mx-auto flex max-w-[1280px] items-center justify-between px-8 py-5 lg:px-12\" data-kid=\"1-1-1\" data-name=\"header layout container\">\n            <a aria-label=\"JMC Servicios Especializados\" class=\"inline-flex items-center\" data-kid=\"1-1-1-1\" data-name=\"brand logo link\" href=\"#top\">\n                <img alt=\"JMC Servicios Especializados\" class=\"h-12 w-auto object-contain\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/assets/brand/logo-complete-white-1024.webp\"/>\n            </a>\n            <nav aria-label=\"Navegación principal\" class=\"hidden items-center gap-9 text-sm text-[var(--cargo-white)]/85 md:flex\" data-kid=\"1-1-1-2\" data-name=\"navigation menu\">\n                <a class=\"hover:text-[var(--cargo-light)]\" data-kid=\"1-1-1-2-1\" data-name=\"navigation link scope\" href=\"#alcance\">\n                    Alcance habilitado\n                </a>\n                <a class=\"hover:text-[var(--cargo-light)]\" data-kid=\"1-1-1-2-2\" data-name=\"navigation link equipment\" href=\"#equipos\">\n                    Equipos GSE\n                </a>\n                <a class=\"hover:text-[var(--cargo-light)]\" data-kid=\"1-1-1-2-3\" data-name=\"navigation link support\" href=\"#respaldo\">\n                    Respaldo\n                </a>\n            </nav>\n            <div class=\"flex items-center gap-2 font-mono text-xs font-semibold tracking-[0.12em]\" data-kid=\"1-1-1-3\" data-name=\"language switcher\">\n                <span class=\"text-[var(--cargo-light)]\" data-kid=\"1-1-1-3-1\" data-name=\"language current indicator\">\n                    ES\n                </span>\n                <span class=\"text-white/35\" data-kid=\"1-1-1-3-2\" data-name=\"language separator\">\n                    /\n                </span>\n                <span class=\"text-white/65\" data-kid=\"1-1-1-3-3\" data-name=\"language alternate\">\n                    EN\n                </span>\n            </div>\n        </div>\n    </header>\n    <section class=\"bg-[var(--cargo-deep)] text-[var(--cargo-white)]\" data-kid=\"1-2\" data-name=\"hero section\" id=\"top\">\n        <div class=\"mx-auto grid max-w-[1280px] gap-12 px-8 pb-14 pt-16 lg:grid-cols-[0.92fr_1.08fr] lg:items-center lg:px-12 lg:pb-20 lg:pt-20\" data-kid=\"1-2-1\" data-name=\"hero section grid container\">\n            <div class=\"max-w-[610px]\" data-kid=\"1-2-1-1\" data-name=\"hero text content\">\n                <p class=\"mb-5 font-mono text-[13px] uppercase tracking-[0.15em] text-[var(--cargo-light)]\" data-kid=\"1-2-1-1-1\" data-name=\"hero pre-headline location\">\n                    Operación en tierra · Maiquetía, Venezuela\n                </p>\n                <h1 class=\"text-balance text-[46px] font-semibold leading-[1.04] tracking-[-0.045em] sm:text-[58px] lg:text-[66px]\" data-kid=\"1-2-1-1-2\" data-name=\"hero headline\">\n                    Servicios aeroportuarios según su\n                    <span class=\"text-[var(--cargo-light)]\" data-kid=\"1-2-1-1-2-1\" data-name=\"hero headline highlighted text\">\n                        alcance habilitado.\n                    </span>\n                </h1>\n                <p class=\"mt-7 max-w-[540px] text-lg leading-8 text-white/80\" data-kid=\"1-2-1-1-3\" data-name=\"hero description\">\n                    Asistencia a aeronaves de pasajeros y carga, atención al pasajero y mantenimiento de equipos de apoyo terrestre.\n                </p>\n                <div class=\"mt-9 flex flex-wrap gap-5\" data-kid=\"1-2-1-1-4\" data-name=\"hero cta group\">\n                    <a class=\"inline-flex items-center gap-3 bg-[var(--cargo-emerald)] px-6 py-4 text-sm font-semibold text-[var(--cargo-ink)] transition-colors hover:bg-[var(--cargo-light)]\" data-kid=\"1-2-1-1-4-1\" data-name=\"primary cta button\" href=\"#alcance\">\n                        Revisar alcance habilitado\n                        <span aria-hidden=\"true\" data-kid=\"1-2-1-1-4-1-1\" data-name=\"down arrow icon\">\n                            ↓\n                        </span>\n                    </a>\n                    <a class=\"inline-flex items-center gap-2 px-2 py-4 text-sm font-semibold text-[var(--cargo-white)] underline decoration-[var(--cargo-light)]/65 underline-offset-4 hover:text-[var(--cargo-light)]\" data-kid=\"1-2-1-1-4-2\" data-name=\"secondary cta button\" href=\"#solicitud\">\n                        Solicitar una operación\n                        <span aria-hidden=\"true\" data-kid=\"1-2-1-1-4-2-1\" data-name=\"arrow up-right icon\">\n                            ↗\n                        </span>\n                    </a>\n                </div>\n            </div>\n            <figure class=\"relative min-h-[360px] overflow-hidden bg-[var(--cargo-ink)] lg:min-h-[445px]\" data-kid=\"1-2-1-2\" data-name=\"hero image showcase\">\n                <img alt=\"Equipos de apoyo terrestre de JMC en zona operativa\" class=\"absolute inset-0 h-full w-full object-cover\" data-kid=\"1-2-1-2-1\" data-name=\"hero background image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/assets/images/gse-fleet.webp\"/>\n                <div class=\"absolute inset-0 bg-gradient-to-t from-[var(--cargo-ink)]/65 via-transparent to-transparent\" data-kid=\"1-2-1-2-2\" data-name=\"hero image overlay gradient\">\n                </div>\n                <figcaption class=\"absolute bottom-0 left-0 right-0 flex items-end justify-between gap-5 p-6 text-[13px] text-white\" data-kid=\"1-2-1-2-3\" data-name=\"hero image caption group\">\n                    <span class=\"max-w-sm leading-5\" data-kid=\"1-2-1-2-3-1\" data-name=\"hero image caption text\">\n                        Equipos de apoyo terrestre en plataforma\n                    </span>\n                    <span class=\"shrink-0 font-mono text-xs tracking-wider text-[var(--cargo-light)]\" data-kid=\"1-2-1-2-3-2\" data-name=\"hero image location code\">\n                        JMC · CCS\n                    </span>\n                </figcaption>\n            </figure>\n        </div>\n    </section>\n    <section aria-label=\"Historia de la empresa\" class=\"border-b border-[var(--cargo-deep)]/15 bg-[var(--cargo-white)]\" data-kid=\"1-3\" data-name=\"history statistics section\">\n        <div class=\"mx-auto grid max-w-[1280px] gap-0 px-8 sm:grid-cols-2 lg:px-12\" data-kid=\"1-3-1\" data-name=\"statistics grid container\">\n            <div class=\"flex items-center gap-5 border-b border-[var(--cargo-deep)]/15 py-8 sm:border-b-0 sm:border-r sm:pr-10 lg:py-10\" data-kid=\"1-3-1-1\" data-name=\"foundation year statistics\">\n                <p class=\"font-mono text-[38px] font-medium tracking-[-0.05em] text-[var(--cargo-deep)]\" data-kid=\"1-3-1-1-1\" data-name=\"foundation year value\">\n                    2012\n                </p>\n                <p class=\"max-w-[175px] text-sm leading-5 text-[var(--cargo-ink)]/70\" data-kid=\"1-3-1-1-2\" data-name=\"foundation label\">\n                    Constitución de Servicios Especializados JMC, C.A.\n                </p>\n            </div>\n            <div class=\"flex items-center gap-5 py-8 sm:pl-10 lg:py-10\" data-kid=\"1-3-1-2\" data-name=\"maiquetia service year statistics\">\n                <p class=\"font-mono text-[38px] font-medium tracking-[-0.05em] text-[var(--cargo-deep)]\" data-kid=\"1-3-1-2-1\" data-name=\"maiquetia service year value\">\n                    2015\n                </p>\n                <p class=\"max-w-[220px] text-sm leading-5 text-[var(--cargo-ink)]/70\" data-kid=\"1-3-1-2-2\" data-name=\"maiquetia service year label\">\n                    Inicio de servicios en Maiquetía\n                </p>\n            </div>\n        </div>\n    </section>\n    <section class=\"scroll-mt-20 bg-[var(--cargo-mist)] py-20 lg:py-28\" data-kid=\"1-4\" data-name=\"scope section\" id=\"alcance\">\n        <div class=\"mx-auto max-w-[1280px] px-8 lg:px-12\" data-kid=\"1-4-1\" data-name=\"scope container\">\n            <div class=\"max-w-[730px]\" data-kid=\"1-4-1-1\" data-name=\"scope heading group\">\n                <h2 class=\"text-4xl font-semibold leading-tight tracking-[-0.04em] text-[var(--cargo-deep)] sm:text-5xl\" data-kid=\"1-4-1-1-1\" data-name=\"scope section heading\">\n                    Alcance del certificado\n                </h2>\n                <p class=\"mt-5 text-base leading-7 text-[var(--cargo-ink)]/75\" data-kid=\"1-4-1-1-2\" data-name=\"scope section description\">\n                    Tres áreas de servicio descritas en el capítulo operativo. La referencia CESEA-021 corresponde a la grafía de ese documento; el folleto presenta una variante.\n                </p>\n            </div>\n            <div class=\"mt-14 border-y border-[var(--cargo-deep)]/20\" data-kid=\"1-4-1-2\" data-name=\"scope articles container\">\n                <article class=\"grid gap-4 border-b border-[var(--cargo-deep)]/15 py-7 md:grid-cols-[80px_300px_1fr] md:gap-8 lg:py-9\" data-kid=\"1-4-1-2-1\" data-name=\"scope article one\">\n                    <p class=\"font-mono text-sm text-[var(--cargo-emerald)]\" data-kid=\"1-4-1-2-1-1\" data-name=\"article number one\">\n                        01\n                    </p>\n                    <h3 class=\"text-xl font-semibold leading-snug text-[var(--cargo-deep)]\" data-kid=\"1-4-1-2-1-2\" data-name=\"article title one\">\n                        Equipos de Apoyo Terrestre en Plataforma\n                    </h3>\n                    <p class=\"max-w-[650px] text-[15px] leading-7 text-[var(--cargo-ink)]/80\" data-kid=\"1-4-1-2-1-3\" data-name=\"article description one\">\n                        Equipos para atender aeronaves de pasajeros y carga, junto con servicios de limpieza interior y exterior, desinfección y desinsectación de aeronaves.\n                    </p>\n                </article>\n                <article class=\"grid gap-4 border-b border-[var(--cargo-deep)]/15 py-7 md:grid-cols-[80px_300px_1fr] md:gap-8 lg:py-9\" data-kid=\"1-4-1-2-2\" data-name=\"scope article two\">\n                    <p class=\"font-mono text-sm text-[var(--cargo-emerald)]\" data-kid=\"1-4-1-2-2-1\" data-name=\"article number two\">\n                        02\n                    </p>\n                    <h3 class=\"text-xl font-semibold leading-snug text-[var(--cargo-deep)]\" data-kid=\"1-4-1-2-2-2\" data-name=\"article title two\">\n                        Operador de Base Fija (OBF)\n                    </h3>\n                    <p class=\"max-w-[650px] text-[15px] leading-7 text-[var(--cargo-ink)]/80\" data-kid=\"1-4-1-2-2-3\" data-name=\"article description two\">\n                        Despacho y seguimiento de vuelo, guía de estacionamiento, tráfico de pasajeros para operaciones 121 y 135, y servicios especiales de asistencia.\n                    </p>\n                </article>\n                <article class=\"grid gap-4 py-7 md:grid-cols-[80px_300px_1fr] md:gap-8 lg:py-9\" data-kid=\"1-4-1-2-3\" data-name=\"scope article three\">\n                    <p class=\"font-mono text-sm text-[var(--cargo-emerald)]\" data-kid=\"1-4-1-2-3-1\" data-name=\"article number three\">\n                        03\n                    </p>\n                    <h3 class=\"text-xl font-semibold leading-snug text-[var(--cargo-deep)]\" data-kid=\"1-4-1-2-3-2\" data-name=\"article title three\">\n                        Mantenimiento de equipos GSE\n                    </h3>\n                    <p class=\"max-w-[650px] text-[15px] leading-7 text-[var(--cargo-ink)]/80\" data-kid=\"1-4-1-2-3-3\" data-name=\"article description three\">\n                        Mantenimiento de los equipos de apoyo terrestre de la operación.\n                    </p>\n                </article>\n            </div>\n            <p class=\"mt-6 font-mono text-xs uppercase tracking-[0.1em] text-[var(--cargo-deep)]/55\" data-kid=\"1-4-1-3\" data-name=\"regulatory reference footer\">\n                Referencia del capítulo operativo · CESEA-021 · INAC · RAV 111\n            </p>\n        </div>\n    </section>\n    <section aria-labelledby=\"services-title\" class=\"bg-[var(--cargo-white)] py-20 lg:py-24\" data-kid=\"1-5\" data-name=\"detailed services section\">\n        <div class=\"mx-auto max-w-[1280px] px-8 lg:px-12\" data-kid=\"1-5-1\" data-name=\"detailed services container\">\n            <div class=\"mb-10 grid gap-5 lg:grid-cols-[1fr_0.72fr] lg:items-end\" data-kid=\"1-5-1-1\" data-name=\"services header group\">\n                <h2 class=\"max-w-[720px] text-4xl font-semibold leading-tight tracking-[-0.04em] text-[var(--cargo-deep)] sm:text-5xl\" data-kid=\"1-5-1-1-1\" data-name=\"services section heading\" id=\"services-title\">\n                    Servicios dentro de cada área autorizada\n                </h2>\n                <p class=\"max-w-[520px] text-[15px] leading-7 text-[var(--cargo-ink)]/75\" data-kid=\"1-5-1-1-2\" data-name=\"services section description\">\n                    Las actividades se agrupan por su alcance operativo para que sea sencillo localizar el soporte requerido.\n                </p>\n            </div>\n            <div class=\"grid gap-12 lg:grid-cols-[0.74fr_1.26fr] lg:gap-16\" data-kid=\"1-5-1-2\" data-name=\"services content grid\">\n                <figure class=\"self-start lg:sticky lg:top-8\" data-kid=\"1-5-1-2-1\" data-name=\"services feature image\">\n                    <div class=\"relative aspect-[4/5] overflow-hidden bg-[var(--cargo-deep)]\" data-kid=\"1-5-1-2-1-1\" data-name=\"services feature image container\">\n                        <img alt=\"Personal realizando labores de cuidado de equipos aeroportuarios\" class=\"absolute inset-0 h-full w-full object-cover\" data-kid=\"1-5-1-2-1-1-1\" data-name=\"services feature image source\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/assets/images/equipment-cleaning.webp\"/>\n                    </div>\n                    <figcaption class=\"mt-3 text-sm leading-5 text-[var(--cargo-ink)]/65\" data-kid=\"1-5-1-2-1-2\" data-name=\"services feature caption\">\n                        Limpieza y cuidado en el entorno aeroportuario\n                    </figcaption>\n                </figure>\n                <div class=\"min-w-0\" data-kid=\"1-5-1-2-2\" data-name=\"services detailed list\">\n                    <section class=\"border-t-2 border-[var(--cargo-emerald)] pt-6 pb-9\" data-kid=\"1-5-1-2-2-1\" data-name=\"service category one\">\n                        <h3 class=\"max-w-[700px] text-[26px] font-semibold leading-tight tracking-[-0.035em] text-[var(--cargo-deep)]\" data-kid=\"1-5-1-2-2-1-1\" data-name=\"service category heading one\">\n                            Equipos de apoyo terrestre y cuidado de aeronaves\n                        </h3>\n                        <p class=\"mt-3 max-w-[700px] text-[15px] leading-7 text-[var(--cargo-ink)]/75\" data-kid=\"1-5-1-2-2-1-2\" data-name=\"service category description one\">\n                            Atención en plataforma a aeronaves de pasajeros y carga, más los servicios de cuidado descritos en el alcance operativo.\n                        </p>\n                        <ul class=\"mt-6 grid gap-x-8 gap-y-3 border-t border-[var(--cargo-deep)]/15 pt-5 text-[15px] leading-6 sm:grid-cols-2\" data-kid=\"1-5-1-2-2-1-3\" data-name=\"service items list one\">\n                            <li data-kid=\"1-5-1-2-2-1-3-1\" data-name=\"service item one\">\n                                Equipos de apoyo terrestre para aeronaves de pasajeros y carga\n                            </li>\n                            <li data-kid=\"1-5-1-2-2-1-3-2\" data-name=\"service item two\">\n                                Limpieza interior de aeronaves\n                            </li>\n                            <li data-kid=\"1-5-1-2-2-1-3-3\" data-name=\"service item three\">\n                                Limpieza exterior de aeronaves\n                            </li>\n                            <li data-kid=\"1-5-1-2-2-1-3-4\" data-name=\"service item four\">\n                                Desinfección y desinsectación de aeronaves\n                            </li>\n                        </ul>\n                        <a class=\"mt-6 inline-flex items-center gap-2 text-sm font-semibold text-[var(--cargo-deep)] underline decoration-[var(--cargo-emerald)] underline-offset-4\" data-kid=\"1-5-1-2-2-1-4\" data-name=\"service category link one\" href=\"#equipos\">\n                            Ver funciones de equipos GSE\n                            <span aria-hidden=\"true\" data-kid=\"1-5-1-2-2-1-4-1\" data-name=\"service link arrow one\">\n                                ↓\n                            </span>\n                        </a>\n                    </section>\n                    <section class=\"border-t border-[var(--cargo-deep)]/20 py-8\" data-kid=\"1-5-1-2-2-2\" data-name=\"service category two\">\n                        <h3 class=\"text-[26px] font-semibold leading-tight tracking-[-0.035em] text-[var(--cargo-deep)]\" data-kid=\"1-5-1-2-2-2-1\" data-name=\"service category heading two\">\n                            Operación de base fija y atención al pasajero\n                        </h3>\n                        <ul class=\"mt-5 space-y-3 text-[15px] leading-6 text-[var(--cargo-ink)]/85\" data-kid=\"1-5-1-2-2-2-2\" data-name=\"service items list two\">\n                            <li class=\"border-b border-[var(--cargo-deep)]/10 pb-3\" data-kid=\"1-5-1-2-2-2-2-1\" data-name=\"service list item one\">\n                                Despacho y seguimiento de vuelo para operaciones 121 y 135\n                            </li>\n                            <li class=\"border-b border-[var(--cargo-deep)]/10 pb-3\" data-kid=\"1-5-1-2-2-2-2-2\" data-name=\"service list item two\">\n                                Guía de estacionamiento de aeronaves\n                            </li>\n                            <li class=\"border-b border-[var(--cargo-deep)]/10 pb-3\" data-kid=\"1-5-1-2-2-2-2-3\" data-name=\"service list item three\">\n                                Tráfico de pasajeros para operaciones 121 y 135\n                            </li>\n                            <li data-kid=\"1-5-1-2-2-2-2-4\" data-name=\"service list item four\">\n                                Asistencia especial: pasajeros con discapacidad, sillas de ruedas y menores sin acompañante\n                            </li>\n                        </ul>\n                        <div class=\"mt-6 border-t border-[var(--cargo-deep)]/15 pt-5\" data-kid=\"1-5-1-2-2-2-3\" data-name=\"other services group\">\n                            <p class=\"text-sm font-semibold text-[var(--cargo-deep)]\" data-kid=\"1-5-1-2-2-2-3-1\" data-name=\"other services label\">\n                                Otros servicios descritos en el folleto\n                            </p>\n                            <p class=\"mt-2 text-sm leading-6 text-[var(--cargo-ink)]/70\" data-kid=\"1-5-1-2-2-2-3-2\" data-name=\"other services description\">\n                                Coordinación de catering y salón VIP, permisos de aterrizaje y sobrevuelo, asistencia a tripulaciones, aeropuertos alternos, combustible, servicios GSE / ASU / ACU y traslado de aeronaves.\n                            </p>\n                        </div>\n                    </section>\n                    <section class=\"border-t border-[var(--cargo-deep)]/20 py-8\" data-kid=\"1-5-1-2-2-3\" data-name=\"service category three\">\n                        <h3 class=\"text-[26px] font-semibold leading-tight tracking-[-0.035em] text-[var(--cargo-deep)]\" data-kid=\"1-5-1-2-2-3-1\" data-name=\"service category heading three\">\n                            Mantenimiento GSE\n                        </h3>\n                        <p class=\"mt-3 max-w-[690px] text-[15px] leading-7 text-[var(--cargo-ink)]/75\" data-kid=\"1-5-1-2-2-3-2\" data-name=\"service category description three\">\n                            Mantenimiento preventivo y correctivo para los equipos de apoyo terrestre.\n                        </p>\n                    </section>\n                </div>\n            </div>\n        </div>\n    </section>\n    <section class=\"scroll-mt-16 bg-[var(--cargo-deep)] py-20 text-[var(--cargo-white)] lg:py-24\" data-kid=\"1-6\" data-name=\"equipment function section\" id=\"equipos\">\n        <div class=\"mx-auto max-w-[1280px] px-8 lg:px-12\" data-kid=\"1-6-1\" data-name=\"equipment container\">\n            <div class=\"grid gap-7 border-b border-white/20 pb-9 lg:grid-cols-[1fr_0.7fr] lg:items-end\" data-kid=\"1-6-1-1\" data-name=\"equipment heading group\">\n                <h2 class=\"max-w-[700px] text-4xl font-semibold leading-tight tracking-[-0.04em] sm:text-5xl\" data-kid=\"1-6-1-1-1\" data-name=\"equipment section heading\">\n                    Seis equipos; seis funciones concretas.\n                </h2>\n                <p class=\"max-w-[500px] text-[15px] leading-7 text-white/75\" data-kid=\"1-6-1-1-2\" data-name=\"equipment section description\">\n                    Descripción técnica según el documento de funciones de equipos de plataforma.\n                </p>\n            </div>\n            <div class=\"mt-8 grid gap-10 lg:grid-cols-[0.7fr_1.3fr] lg:gap-14\" data-kid=\"1-6-1-2\" data-name=\"equipment details grid\">\n                <figure class=\"self-start\" data-kid=\"1-6-1-2-1\" data-name=\"equipment showcase\">\n                    <div class=\"overflow-hidden bg-[var(--cargo-ink)]\" data-kid=\"1-6-1-2-1-1\" data-name=\"equipment image wrapper\">\n                        <img alt=\"Flota de equipos de apoyo terrestre JMC\" class=\"h-auto w-full object-cover\" data-kid=\"1-6-1-2-1-1-1\" data-name=\"equipment image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/assets/images/gse-fleet.webp\"/>\n                    </div>\n                    <figcaption class=\"mt-3 text-[13px] leading-5 text-white/65\" data-kid=\"1-6-1-2-1-2\" data-name=\"equipment image caption\">\n                        Flota de equipos de apoyo terrestre\n                    </figcaption>\n                </figure>\n                <dl class=\"divide-y divide-white/15 border-y border-white/20\" data-kid=\"1-6-1-2-2\" data-name=\"equipment definition list\">\n                    <div class=\"grid gap-2 py-5 sm:grid-cols-[190px_1fr] sm:gap-6\" data-kid=\"1-6-1-2-2-1\" data-name=\"equipment definition item one\">\n                        <dt class=\"text-base font-semibold text-[var(--cargo-light)]\" data-kid=\"1-6-1-2-2-1-1\" data-name=\"equipment term one\">\n                            Carrucha\n                        </dt>\n                        <dd class=\"text-[14px] leading-6 text-white/80\" data-kid=\"1-6-1-2-2-1-2\" data-name=\"equipment description one\">\n                            Carro sin motor para transportar equipaje, correo o carga suelta; se acopla en tren para ser remolcado.\n                        </dd>\n                    </div>\n                    <div class=\"grid gap-2 py-5 sm:grid-cols-[190px_1fr] sm:gap-6\" data-kid=\"1-6-1-2-2-2\" data-name=\"equipment definition item two\">\n                        <dt class=\"text-base font-semibold text-[var(--cargo-light)]\" data-kid=\"1-6-1-2-2-2-1\" data-name=\"equipment term two\">\n                            Tractor remolcador\n                        </dt>\n                        <dd class=\"text-[14px] leading-6 text-white/80\" data-kid=\"1-6-1-2-2-2-2\" data-name=\"equipment description two\">\n                            Vehículo de perfil bajo y gran tracción que remolca carruchas y otros equipos de apoyo.\n                        </dd>\n                    </div>\n                    <div class=\"grid gap-2 py-5 sm:grid-cols-[190px_1fr] sm:gap-6\" data-kid=\"1-6-1-2-2-3\" data-name=\"equipment definition item three\">\n                        <dt class=\"text-base font-semibold text-[var(--cargo-light)]\" data-kid=\"1-6-1-2-2-3-1\" data-name=\"equipment term three\">\n                            Carro de aguas residuales\n                        </dt>\n                        <dd class=\"text-[14px] leading-6 text-white/80\" data-kid=\"1-6-1-2-2-3-2\" data-name=\"equipment description three\">\n                            Vacía y drena los tanques sanitarios de la aeronave; luego repone agua limpia y líquido desinfectante.\n                        </dd>\n                    </div>\n                    <div class=\"grid gap-2 py-5 sm:grid-cols-[190px_1fr] sm:gap-6\" data-kid=\"1-6-1-2-2-4\" data-name=\"equipment definition item four\">\n                        <dt class=\"text-base font-semibold text-[var(--cargo-light)]\" data-kid=\"1-6-1-2-2-4-1\" data-name=\"equipment term four\">\n                            Cinta transportadora\n                        </dt>\n                        <dd class=\"text-[14px] leading-6 text-white/80\" data-kid=\"1-6-1-2-2-4-2\" data-name=\"equipment description four\">\n                            Banda ajustable hasta la puerta de carga para subir y bajar maletas o carga a granel; ayuda a prevenir lesiones durante la manipulación.\n                        </dd>\n                    </div>\n                    <div class=\"grid gap-2 py-5 sm:grid-cols-[190px_1fr] sm:gap-6\" data-kid=\"1-6-1-2-2-5\" data-name=\"equipment definition item five\">\n                        <dt class=\"text-base font-semibold text-[var(--cargo-light)]\" data-kid=\"1-6-1-2-2-5-1\" data-name=\"equipment term five\">\n                            GPU · Ground Power Unit\n                        </dt>\n                        <dd class=\"text-[14px] leading-6 text-white/80\" data-kid=\"1-6-1-2-2-5-2\" data-name=\"equipment description five\">\n                            Suministra energía eléctrica a la aeronave estacionada con los motores apagados, sin consumir combustible de la aeronave.\n                        </dd>\n                    </div>\n                    <div class=\"grid gap-2 py-5 sm:grid-cols-[190px_1fr] sm:gap-6\" data-kid=\"1-6-1-2-2-6\" data-name=\"equipment definition item six\">\n                        <dt class=\"text-base font-semibold text-[var(--cargo-light)]\" data-kid=\"1-6-1-2-2-6-1\" data-name=\"equipment term six\">\n                            ASU · Air Start Unit\n                        </dt>\n                        <dd class=\"text-[14px] leading-6 text-white/80\" data-kid=\"1-6-1-2-2-6-2\" data-name=\"equipment description six\">\n                            Entrega aire comprimido a alta presión para asistir el arranque de los motores, especialmente si el APU está inoperativo o apagado.\n                        </dd>\n                    </div>\n                </dl>\n            </div>\n        </div>\n    </section>\n    <section class=\"scroll-mt-16 bg-[var(--cargo-mist)] py-20 lg:py-24\" data-kid=\"1-7\" data-name=\"certification section\" id=\"respaldo\">\n        <div class=\"mx-auto grid max-w-[1280px] gap-12 px-8 lg:grid-cols-[0.85fr_1.15fr] lg:items-center lg:gap-16\" data-kid=\"1-7-1\" data-name=\"certification container\">\n            <div data-kid=\"1-7-1-1\" data-name=\"certification text content\">\n                <h2 class=\"text-4xl font-semibold leading-tight tracking-[-0.04em] text-[var(--cargo-deep)] sm:text-5xl\" data-kid=\"1-7-1-1-1\" data-name=\"certification heading\">\n                    Autorización y respaldo documental\n                </h2>\n                <p class=\"mt-5 max-w-[550px] text-[15px] leading-7 text-[var(--cargo-ink)]/75\" data-kid=\"1-7-1-1-2\" data-name=\"certification description primary\">\n                    El capítulo operativo describe servicios bajo la Regulación Aeronáutica Venezolana 111 y el Certificado de Explotador de Servicios Especializados Aeroportuarios emitido por INAC.\n                </p>\n                <p class=\"mt-4 max-w-[550px] text-sm leading-6 text-[var(--cargo-ink)]/65\" data-kid=\"1-7-1-1-3\" data-name=\"certification description secondary\">\n                    Este capítulo emplea la referencia CESEA-021. El folleto presenta otra grafía del número; la diferencia queda pendiente de validación documental.\n                </p>\n                <a class=\"mt-7 inline-flex items-center gap-3 bg-[var(--cargo-deep)] px-6 py-4 text-sm font-semibold text-white transition-colors hover:bg-[var(--cargo-ink)]\" data-kid=\"1-7-1-1-4\" data-name=\"consultation cta button\" href=\"#solicitud\">\n                    Consultar por un servicio\n                    <span aria-hidden=\"true\" data-kid=\"1-7-1-1-4-1\" data-name=\"consultation arrow icon\">\n                        ↗\n                    </span>\n                </a>\n            </div>\n            <figure class=\"bg-white p-4 shadow-[0_18px_45px_-28px_rgba(10,31,43,0.35)] sm:p-6\" data-kid=\"1-7-1-2\" data-name=\"certification image showcase\">\n                <img alt=\"Fragmento del certificado de Servicios Especializados JMC emitido bajo RAV 111\" class=\"h-auto max-h-[370px] w-full object-contain object-top\" data-kid=\"1-7-1-2-1\" data-name=\"certification certificate image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/assets/images/cesea-cert.webp\"/>\n                <figcaption class=\"mt-4 border-t border-[var(--cargo-deep)]/15 pt-4 text-sm leading-5 text-[var(--cargo-ink)]/65\" data-kid=\"1-7-1-2-2\" data-name=\"certification image caption\">\n                    Certificado de Explotador de Servicios Especializados Aeroportuarios · RAV 111 · INAC\n                </figcaption>\n            </figure>\n        </div>\n    </section>\n    <section class=\"bg-[var(--cargo-light)] py-14 text-[var(--cargo-deep)] lg:py-16\" data-kid=\"1-8\" data-name=\"contact call-to-action section\" id=\"solicitud\">\n        <div class=\"mx-auto flex max-w-[1280px] flex-col gap-7 px-8 sm:flex-row sm:items-center sm:justify-between lg:px-12\" data-kid=\"1-8-1\" data-name=\"contact cta container\">\n            <div class=\"max-w-[760px]\" data-kid=\"1-8-1-1\" data-name=\"contact cta text group\">\n                <h2 class=\"text-3xl font-semibold leading-tight tracking-[-0.035em] sm:text-4xl\" data-kid=\"1-8-1-1-1\" data-name=\"contact cta heading\">\n                    ¿Qué servicio requiere su operación?\n                </h2>\n                <p class=\"mt-3 max-w-[650px] text-[15px] leading-6 text-[var(--cargo-ink)]/75\" data-kid=\"1-8-1-1-2\" data-name=\"contact cta description\">\n                    Comparta el tipo de aeronave, estación y servicios solicitados para orientar su consulta.\n                </p>\n            </div>\n            <a class=\"inline-flex shrink-0 items-center gap-4 bg-[var(--cargo-deep)] px-6 py-4 text-sm font-semibold text-white transition-colors hover:bg-[var(--cargo-ink)]\" data-kid=\"1-8-1-2\" data-name=\"contact cta button\" href=\"mailto:customer.service@jmchandling.com\">\n                Enviar solicitud\n                <span aria-hidden=\"true\" data-kid=\"1-8-1-2-1\" data-name=\"contact cta arrow icon\">\n                    ↗\n                </span>\n            </a>\n        </div>\n    </section>\n    <footer class=\"bg-[var(--cargo-deep)] text-white\" data-kid=\"1-9\" data-name=\"footer section\">\n        <div class=\"mx-auto grid max-w-[1280px] gap-10 px-8 py-12 lg:grid-cols-[0.8fr_1.2fr] lg:px-12\" data-kid=\"1-9-1\" data-name=\"footer main container\">\n            <div data-kid=\"1-9-1-1\" data-name=\"footer brand group\">\n                <img alt=\"JMC Servicios Especializados\" class=\"h-12 w-auto object-contain\" data-kid=\"1-9-1-1-1\" data-name=\"footer logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/assets/brand/logo-complete-white-1024.webp\"/>\n                <p class=\"mt-5 max-w-[370px] text-sm leading-6 text-white/70\" data-kid=\"1-9-1-1-2\" data-name=\"footer description\">\n                    Servicios especializados aeroportuarios · Maiquetía, Venezuela\n                </p>\n            </div>\n            <div class=\"grid gap-7 sm:grid-cols-2\" data-kid=\"1-9-1-2\" data-name=\"footer links container\">\n                <div data-kid=\"1-9-1-2-1\" data-name=\"footer contact link group\">\n                    <p class=\"text-sm font-semibold text-[var(--cargo-light)]\" data-kid=\"1-9-1-2-1-1\" data-name=\"footer contact heading\">\n                        Contacto comercial\n                    </p>\n                    <a class=\"mt-3 block text-sm text-white/85 underline decoration-white/35 underline-offset-4\" data-kid=\"1-9-1-2-1-2\" data-name=\"footer email link\" href=\"mailto:customer.service@jmchandling.com\">\n                        customer.service@jmchandling.com\n                    </a>\n                </div>\n                <div data-kid=\"1-9-1-2-2\" data-name=\"footer phone support group\">\n                    <p class=\"text-sm font-semibold text-[var(--cargo-light)]\" data-kid=\"1-9-1-2-2-1\" data-name=\"footer phone heading\">\n                        Líneas de atención\n                    </p>\n                    <p class=\"mt-3 text-sm text-white/85\" data-kid=\"1-9-1-2-2-2\" data-name=\"footer phone one\">\n                        Venezuela · +58 414 118 0806\n                    </p>\n                    <p class=\"mt-2 text-sm text-white/85\" data-kid=\"1-9-1-2-2-3\" data-name=\"footer phone two\">\n                        USA · +1 954 470 4217\n                    </p>\n                </div>\n            </div>\n        </div>\n        <div class=\"border-t border-white/15\" data-kid=\"1-9-2\" data-name=\"footer copyright bar\">\n            <div class=\"mx-auto flex max-w-[1280px] flex-col gap-2 px-8 py-5 text-xs text-white/50 sm:flex-row sm:items-center sm:justify-between lg:px-12\" data-kid=\"1-9-2-1\" data-name=\"footer copyright container\">\n                <p data-kid=\"1-9-2-1-1\" data-name=\"copyright business name\">\n                    Servicios Especializados JMC, C.A.\n                </p>\n                <p data-kid=\"1-9-2-1-2\" data-name=\"copyright location text\">\n                    Maiquetía · Venezuela\n                </p>\n            </div>\n        </div>\n    </footer>\n</main>\n",
