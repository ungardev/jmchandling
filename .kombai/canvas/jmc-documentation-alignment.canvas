    "var_4170f1e7144e": {
      "type": "variant",
      "label": "Propuesta 2 · Por tarea | Servicios",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap');\n</style>\n<main class=\"min-h-screen bg-[var(--cargo-mist)] font-sans text-[var(--cargo-ink)]\" data-kid=\"1\" style=\"--cargo-deep:#0F3E51;--cargo-light:#A0DDF5;--cargo-emerald:#5BA8C7;--cargo-ink:#0A1F2B;--cargo-mist:#F5F8FA;--cargo-white:#FFFFFF;font-family:Inter,system-ui,sans-serif\">\n    <header class=\"bg-[var(--cargo-deep)] text-[var(--cargo-white)]\" data-kid=\"1-1\">\n        <nav aria-label=\"Navegación principal\" class=\"mx-auto flex max-w-[1320px] items-center justify-between gap-8 px-7 py-5 lg:px-12\" data-kid=\"1-1-1\">\n            <a aria-label=\"JMC Servicios Especializados\" class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\" href=\"#inicio\">\n                <img alt=\"\" aria-hidden=\"true\" class=\"h-10 w-auto object-contain\" data-kid=\"1-1-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/assets/brand/isotipo-logo.webp\"/>\n                <img alt=\"JMC Servicios Especializados\" class=\"hidden h-8 w-auto object-contain sm:block\" data-kid=\"1-1-1-1-2\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/assets/brand/fuente-logo.webp\"/>\n            </a>\n            <div class=\"hidden items-center gap-8 text-sm font-medium md:flex\" data-kid=\"1-1-1-2\">\n                <a class=\"text-[var(--cargo-light)]\" data-kid=\"1-1-1-2-1\" href=\"#familias\">\n                    Servicios\n                </a>\n                <a class=\"text-white/80 hover:text-white\" data-kid=\"1-1-1-2-2\" href=\"#equipos\">\n                    Equipos\n                </a>\n                <a class=\"text-white/80 hover:text-white\" data-kid=\"1-1-1-2-3\" href=\"#alcance\">\n                    Alcance\n                </a>\n                <a class=\"text-white/80 hover:text-white\" data-kid=\"1-1-1-2-4\" href=\"#contacto\">\n                    Contacto\n                </a>\n            </div>\n            <div class=\"flex items-center gap-5\" data-kid=\"1-1-1-3\">\n                <div aria-label=\"Idioma\" class=\"flex items-center gap-2 font-mono text-xs uppercase tracking-[.12em]\" data-kid=\"1-1-1-3-1\">\n                    <span class=\"text-[var(--cargo-white)]\" data-kid=\"1-1-1-3-1-1\">\n                        ES\n                    </span>\n                    <span class=\"text-white/40\" data-kid=\"1-1-1-3-1-2\">\n                        /\n                    </span>\n                    <button aria-pressed=\"false\" class=\"text-white/50\" data-kid=\"1-1-1-3-1-3\" type=\"button\">\n                        EN\n                    </button>\n                </div>\n                <a class=\"hidden border border-[var(--cargo-light)]/55 px-4 py-2.5 text-sm font-semibold text-white hover:bg-white/10 sm:inline-flex\" data-kid=\"1-1-1-3-2\" href=\"#contacto\">\n                    Solicitar un servicio\n                    <span aria-hidden=\"true\" class=\"ml-3 text-[var(--cargo-light)]\" data-kid=\"1-1-1-3-2-1\">\n                        ↗\n                    </span>\n                </a>\n                <button aria-label=\"Abrir menú\" class=\"inline-flex h-10 w-10 items-center justify-center border border-white/30 text-white md:hidden\" data-kid=\"1-1-1-3-3\" type=\"button\">\n                    <span aria-hidden=\"true\" class=\"text-xl\" data-kid=\"1-1-1-3-3-1\">\n                        ☰\n                    </span>\n                </button>\n            </div>\n        </nav>\n    </header>\n    <section class=\"bg-[var(--cargo-deep)] text-[var(--cargo-white)]\" data-kid=\"1-2\" id=\"inicio\">\n        <div class=\"mx-auto grid max-w-[1320px] items-center gap-12 px-7 pb-12 pt-10 md:grid-cols-[.9fr_1.1fr] lg:gap-20 lg:px-12 lg:pb-16 lg:pt-14\" data-kid=\"1-2-1\">\n            <div class=\"max-w-[620px]\" data-kid=\"1-2-1-1\">\n                <p class=\"font-mono text-xs uppercase tracking-[.17em] text-[var(--cargo-light)]\" data-kid=\"1-2-1-1-1\">\n                    JMC · Maiquetía · Servicios aeroportuarios\n                </p>\n                <h1 class=\"mt-6 text-5xl font-semibold leading-[1.02] tracking-[-.055em] text-white sm:text-6xl lg:text-[4.55rem]\" data-kid=\"1-2-1-1-2\">\n                    ¿Qué necesita resolver en plataforma?\n                </h1>\n                <p class=\"mt-7 max-w-xl text-lg leading-8 text-white/80\" data-kid=\"1-2-1-1-3\">\n                    Consulte los servicios documentados para la operación de aeronaves, pasajeros, equipaje y carga.\n                </p>\n                <div class=\"mt-9 flex flex-wrap items-center gap-x-7 gap-y-4\" data-kid=\"1-2-1-1-4\">\n                    <a class=\"inline-flex items-center bg-[var(--cargo-emerald)] px-5 py-3.5 text-sm font-semibold text-[var(--cargo-ink)] hover:bg-[var(--cargo-light)]\" data-kid=\"1-2-1-1-4-1\" href=\"#familias\">\n                        Ver servicios y alcance\n                        <span aria-hidden=\"true\" class=\"ml-4\" data-kid=\"1-2-1-1-4-1-1\">\n                            ↘\n                        </span>\n                    </a>\n                    <a class=\"text-sm font-semibold text-white underline decoration-white/35 underline-offset-8 hover:decoration-white\" data-kid=\"1-2-1-1-4-2\" href=\"#contacto\">\n                        Enviar detalles de la operación\n                        <span aria-hidden=\"true\" class=\"ml-1\" data-kid=\"1-2-1-1-4-2-1\">\n                            ↗\n                        </span>\n                    </a>\n                </div>\n            </div>\n            <figure class=\"relative min-h-[340px] overflow-hidden bg-[var(--cargo-ink)] md:min-h-[430px]\" data-kid=\"1-2-1-2\">\n                <img alt=\"Equipos de apoyo terrestre de JMC en la plataforma\" class=\"absolute inset-0 h-full w-full object-cover object-center\" data-kid=\"1-2-1-2-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/assets/images/gse-fleet.webp\"/>\n                <figcaption class=\"absolute bottom-0 left-0 right-0 flex items-center justify-between border-t border-white/30 bg-[var(--cargo-deep)]/90 px-5 py-3.5 font-mono text-[11px] uppercase tracking-[.13em] text-white/85\" data-kid=\"1-2-1-2-2\">\n                    <span data-kid=\"1-2-1-2-2-1\">\n                        Equipos de apoyo terrestre\n                    </span>\n                    <span data-kid=\"1-2-1-2-2-2\">\n                        Maiquetía · CCS\n                    </span>\n                </figcaption>\n            </figure>\n        </div>\n        <div class=\"border-t border-white/15\" data-kid=\"1-2-2\">\n            <div class=\"mx-auto grid max-w-[1320px] grid-cols-1 px-7 sm:grid-cols-2 lg:px-12\" data-kid=\"1-2-2-1\">\n                <div class=\"flex items-center gap-5 border-b border-white/15 py-5 sm:border-b-0 sm:border-r sm:py-6\" data-kid=\"1-2-2-1-1\">\n                    <span class=\"font-mono text-3xl font-medium tracking-[-.05em] text-[var(--cargo-light)]\" data-kid=\"1-2-2-1-1-1\">\n                        2012\n                    </span>\n                    <span class=\"max-w-[230px] text-sm leading-5 text-white/75\" data-kid=\"1-2-2-1-1-2\">\n                        Año de constitución de Servicios Especializados JMC, C.A.\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-5 py-5 sm:pl-8 sm:py-6\" data-kid=\"1-2-2-1-2\">\n                    <span class=\"font-mono text-3xl font-medium tracking-[-.05em] text-[var(--cargo-light)]\" data-kid=\"1-2-2-1-2-1\">\n                        2015\n                    </span>\n                    <span class=\"max-w-[270px] text-sm leading-5 text-white/75\" data-kid=\"1-2-2-1-2-2\">\n                        Inicio de prestación de servicios en Maiquetía, según el capítulo organizacional.\n                    </span>\n                </div>\n            </div>\n        </div>\n    </section>\n    <section class=\"bg-[var(--cargo-white)] px-7 py-16 lg:px-12 lg:py-24\" data-kid=\"1-3\" id=\"familias\">\n        <div class=\"mx-auto max-w-[1320px]\" data-kid=\"1-3-1\">\n            <div class=\"grid gap-5 border-b border-[var(--cargo-deep)]/20 pb-8 md:grid-cols-[.8fr_1.2fr] md:items-end\" data-kid=\"1-3-1-1\">\n                <h2 class=\"max-w-[520px] text-3xl font-semibold leading-tight tracking-[-.04em] text-[var(--cargo-deep)] sm:text-4xl\" data-kid=\"1-3-1-1-1\">\n                    Encuentre el servicio por tarea\n                </h2>\n                <p class=\"max-w-[570px] text-base leading-7 text-[var(--cargo-ink)]/70\" data-kid=\"1-3-1-1-2\">\n                    Cada grupo enlaza a su alcance y a los servicios descritos. Las funciones de los seis equipos GSE están reunidas más abajo.\n                </p>\n            </div>\n            <div class=\"mt-2 divide-y divide-[var(--cargo-deep)]/15\" data-kid=\"1-3-1-2\">\n                <a class=\"group grid gap-3 py-6 transition-colors hover:bg-[var(--cargo-mist)]/70 md:grid-cols-[minmax(260px,.82fr)_1.18fr_40px] md:items-center md:gap-8 md:px-3\" data-kid=\"1-3-1-2-1\" href=\"#gse\">\n                    <h3 class=\"text-xl font-semibold tracking-[-.025em] text-[var(--cargo-deep)] group-hover:text-[var(--cargo-ink)]\" data-kid=\"1-3-1-2-1-1\">\n                        Atender la aeronave en rampa\n                    </h3>\n                    <p class=\"max-w-2xl text-sm leading-6 text-[var(--cargo-ink)]/70\" data-kid=\"1-3-1-2-1-2\">\n                        Equipos de apoyo terrestre para aeronaves de pasajeros y carga: movimiento, energía, carga y apoyo en plataforma.\n                    </p>\n                    <span aria-hidden=\"true\" class=\"font-mono text-xl text-[var(--cargo-emerald)]\" data-kid=\"1-3-1-2-1-3\">\n                        ↘\n                    </span>\n                </a>\n                <a class=\"group grid gap-3 py-6 transition-colors hover:bg-[var(--cargo-mist)]/70 md:grid-cols-[minmax(260px,.82fr)_1.18fr_40px] md:items-center md:gap-8 md:px-3\" data-kid=\"1-3-1-2-2\" href=\"#cuidado\">\n                    <h3 class=\"text-xl font-semibold tracking-[-.025em] text-[var(--cargo-deep)] group-hover:text-[var(--cargo-ink)]\" data-kid=\"1-3-1-2-2-1\">\n                        Limpiar o tratar la aeronave\n                    </h3>\n                    <p class=\"max-w-2xl text-sm leading-6 text-[var(--cargo-ink)]/70\" data-kid=\"1-3-1-2-2-2\">\n                        Limpieza interior y exterior, desinfección y desinsectación descritas para la aeronave.\n                    </p>\n                    <span aria-hidden=\"true\" class=\"font-mono text-xl text-[var(--cargo-emerald)]\" data-kid=\"1-3-1-2-2-3\">\n                        ↘\n                    </span>\n                </a>\n                <a class=\"group grid gap-3 py-6 transition-colors hover:bg-[var(--cargo-mist)]/70 md:grid-cols-[minmax(260px,.82fr)_1.18fr_40px] md:items-center md:gap-8 md:px-3\" data-kid=\"1-3-1-2-3\" href=\"#obf\">\n                    <h3 class=\"text-xl font-semibold tracking-[-.025em] text-[var(--cargo-deep)] group-hover:text-[var(--cargo-ink)]\" data-kid=\"1-3-1-2-3-1\">\n                        Coordinar despacho y estacionamiento\n                    </h3>\n                    <p class=\"max-w-2xl text-sm leading-6 text-[var(--cargo-ink)]/70\" data-kid=\"1-3-1-2-3-2\">\n                        Operador de Base Fija (OBF): despacho y seguimiento de vuelo, guía de estacionamiento y coordinación en tierra.\n                    </p>\n                    <span aria-hidden=\"true\" class=\"font-mono text-xl text-[var(--cargo-emerald)]\" data-kid=\"1-3-1-2-3-3\">\n                        ↘\n                    </span>\n                </a>\n                <a class=\"group grid gap-3 py-6 transition-colors hover:bg-[var(--cargo-mist)]/70 md:grid-cols-[minmax(260px,.82fr)_1.18fr_40px] md:items-center md:gap-8 md:px-3\" data-kid=\"1-3-1-2-4\" href=\"#pasajeros\">\n                    <h3 class=\"text-xl font-semibold tracking-[-.025em] text-[var(--cargo-deep)] group-hover:text-[var(--cargo-ink)]\" data-kid=\"1-3-1-2-4-1\">\n                        Atender pasajeros y solicitudes especiales\n                    </h3>\n                    <p class=\"max-w-2xl text-sm leading-6 text-[var(--cargo-ink)]/70\" data-kid=\"1-3-1-2-4-2\">\n                        Tráfico para operaciones 121 y 135; asistencia PRM, menores sin acompañante y servicios complementarios descritos.\n                    </p>\n                    <span aria-hidden=\"true\" class=\"font-mono text-xl text-[var(--cargo-emerald)]\" data-kid=\"1-3-1-2-4-3\">\n                        ↘\n                    </span>\n                </a>\n                <a class=\"group grid gap-3 py-6 transition-colors hover:bg-[var(--cargo-mist)]/70 md:grid-cols-[minmax(260px,.82fr)_1.18fr_40px] md:items-center md:gap-8 md:px-3\" data-kid=\"1-3-1-2-5\" href=\"#mantenimiento\">\n                    <h3 class=\"text-xl font-semibold tracking-[-.025em] text-[var(--cargo-deep)] group-hover:text-[var(--cargo-ink)]\" data-kid=\"1-3-1-2-5-1\">\n                        Mantener equipos de apoyo terrestre\n                    </h3>\n                    <p class=\"max-w-2xl text-sm leading-6 text-[var(--cargo-ink)]/70\" data-kid=\"1-3-1-2-5-2\">\n                        Soporte preventivo y correctivo para equipos GSE.\n                    </p>\n                    <span aria-hidden=\"true\" class=\"font-mono text-xl text-[var(--cargo-emerald)]\" data-kid=\"1-3-1-2-5-3\">\n                        ↘\n                    </span>\n                </a>\n            </div>\n        </div>\n    </section>\n    <section class=\"bg-[var(--cargo-mist)] px-7 py-16 lg:px-12 lg:py-24\" data-kid=\"1-4\">\n        <div class=\"mx-auto max-w-[1320px]\" data-kid=\"1-4-1\">\n            <div class=\"mb-10 flex flex-wrap items-end justify-between gap-6 border-b border-[var(--cargo-deep)]/20 pb-7\" data-kid=\"1-4-1-1\">\n                <div data-kid=\"1-4-1-1-1\">\n                    <h2 class=\"text-3xl font-semibold leading-tight tracking-[-.04em] text-[var(--cargo-deep)] sm:text-4xl\" data-kid=\"1-4-1-1-1-1\">\n                        Alcance y servicios\n                    </h2>\n                    <p class=\"mt-3 max-w-2xl text-base leading-7 text-[var(--cargo-ink)]/70\" data-kid=\"1-4-1-1-1-2\">\n                        Alcance descrito en los documentos de JMC. La prestación concreta se consulta según cada operación.\n                    </p>\n                </div>\n                <a class=\"shrink-0 text-sm font-semibold text-[var(--cargo-deep)] underline decoration-[var(--cargo-emerald)] underline-offset-8\" data-kid=\"1-4-1-1-2\" href=\"#equipos\">\n                    Ir a funciones GSE\n                    <span aria-hidden=\"true\" data-kid=\"1-4-1-1-2-1\">\n                        ↘\n                    </span>\n                </a>\n            </div>\n            <article class=\"scroll-mt-8 border-t-2 border-[var(--cargo-deep)] py-9 lg:py-12\" data-kid=\"1-4-1-2\" id=\"gse\">\n                <div class=\"grid gap-8 lg:grid-cols-[.83fr_1.17fr] lg:gap-16\" data-kid=\"1-4-1-2-1\">\n                    <div data-kid=\"1-4-1-2-1-1\">\n                        <p class=\"font-mono text-xs uppercase tracking-[.14em] text-[var(--cargo-deep)]/65\" data-kid=\"1-4-1-2-1-1-1\">\n                            Equipos de apoyo terrestre · GSE\n                        </p>\n                        <h3 class=\"mt-3 max-w-lg text-3xl font-semibold leading-tight tracking-[-.04em] text-[var(--cargo-deep)] sm:text-4xl\" data-kid=\"1-4-1-2-1-1-2\">\n                            Atención de aeronaves de pasajeros y carga\n                        </h3>\n                        <p class=\"mt-4 max-w-lg text-base leading-7 text-[var(--cargo-ink)]/75\" data-kid=\"1-4-1-2-1-1-3\">\n                            El capítulo organizacional describe los equipos de apoyo terrestre para la atención de aeronaves, pasajeros, personal, equipaje y carga, en plataforma.\n                        </p>\n                        <p class=\"mt-5 border-l border-[var(--cargo-emerald)] pl-4 text-sm leading-6 text-[var(--cargo-ink)]/70\" data-kid=\"1-4-1-2-1-1-4\">\n                            Categoría documentada: Equipos de Apoyo Terrestre en Plataforma · Secciones 1–8.\n                        </p>\n                        <a class=\"mt-7 inline-flex items-center gap-2 text-sm font-semibold text-[var(--cargo-deep)] underline decoration-[var(--cargo-emerald)] underline-offset-8\" data-kid=\"1-4-1-2-1-1-5\" href=\"#equipos\">\n                            Consultar qué hace cada equipo\n                            <span aria-hidden=\"true\" data-kid=\"1-4-1-2-1-1-5-1\">\n                                ↘\n                            </span>\n                        </a>\n                        <a class=\"mt-4 inline-flex items-center gap-2 bg-[var(--cargo-emerald)] px-4 py-3 text-sm font-semibold text-[var(--cargo-ink)]\" data-kid=\"1-4-1-2-1-1-6\" data-name=\"primary request service button\" href=\"/es/cotizacion?service=ramp-gse\">\n                            Solicitar este servicio\n                            <span aria-hidden=\"true\" data-kid=\"1-4-1-2-1-1-6-1\" data-name=\"cta arrow icon\">\n                                ↗\n                            </span>\n                        </a>\n                    </div>\n                    <div class=\"grid gap-0 self-start border-t border-[var(--cargo-deep)]/20 sm:grid-cols-2 sm:gap-x-9\" data-kid=\"1-4-1-2-1-2\">\n                        <div class=\"border-b border-[var(--cargo-deep)]/15 py-5\" data-kid=\"1-4-1-2-1-2-1\">\n                            <h4 class=\"font-semibold text-[var(--cargo-deep)]\" data-kid=\"1-4-1-2-1-2-1-1\">\n                                Pushback y towbarless\n                            </h4>\n                            <p class=\"mt-2 text-sm leading-6 text-[var(--cargo-ink)]/70\" data-kid=\"1-4-1-2-1-2-1-2\">\n                                Equipos de apoyo de plataforma para mover aeronaves.\n                            </p>\n                        </div>\n                        <div class=\"border-b border-[var(--cargo-deep)]/15 py-5\" data-kid=\"1-4-1-2-1-2-2\">\n                            <h4 class=\"font-semibold text-[var(--cargo-deep)]\" data-kid=\"1-4-1-2-1-2-2-1\">\n                                GPU y ASU\n                            </h4>\n                            <p class=\"mt-2 text-sm leading-6 text-[var(--cargo-ink)]/70\" data-kid=\"1-4-1-2-1-2-2-2\">\n                                Unidades de energía eléctrica en tierra y asistencia neumática de arranque.\n                            </p>\n                        </div>\n                        <div class=\"border-b border-[var(--cargo-deep)]/15 py-5\" data-kid=\"1-4-1-2-1-2-3\">\n                            <h4 class=\"font-semibold text-[var(--cargo-deep)]\" data-kid=\"1-4-1-2-1-2-3-1\">\n                                Contenedores y pallets ULD\n                            </h4>\n                            <p class=\"mt-2 text-sm leading-6 text-[var(--cargo-ink)]/70\" data-kid=\"1-4-1-2-1-2-3-2\">\n                                Apoyo de manejo para unidades de carga aérea.\n                            </p>\n                        </div>\n                        <div class=\"border-b border-[var(--cargo-deep)]/15 py-5\" data-kid=\"1-4-1-2-1-2-4\">\n                            <h4 class=\"font-semibold text-[var(--cargo-deep)]\" data-kid=\"1-4-1-2-1-2-4-1\">\n                                Banda transportadora de equipaje\n                            </h4>\n                            <p class=\"mt-2 text-sm leading-6 text-[var(--cargo-ink)]/70\" data-kid=\"1-4-1-2-1-2-4-2\">\n                                Acceso ajustable a la bodega para subir y bajar equipaje y carga suelta.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </article>\n            <article class=\"scroll-mt-8 border-t-2 border-[var(--cargo-deep)] py-9 lg:py-12\" data-kid=\"1-4-1-3\" id=\"cuidado\">\n                <div class=\"grid gap-9 lg:grid-cols-[.83fr_1.17fr] lg:gap-16\" data-kid=\"1-4-1-3-1\">\n                    <div data-kid=\"1-4-1-3-1-1\">\n                        <p class=\"font-mono text-xs uppercase tracking-[.14em] text-[var(--cargo-deep)]/65\" data-kid=\"1-4-1-3-1-1-1\">\n                            Cuidado de aeronaves\n                        </p>\n                        <h3 class=\"mt-3 max-w-lg text-3xl font-semibold leading-tight tracking-[-.04em] text-[var(--cargo-deep)] sm:text-4xl\" data-kid=\"1-4-1-3-1-1-2\">\n                            Limpiar la cabina, el exterior o tratar la aeronave\n                        </h3>\n                        <p class=\"mt-4 max-w-lg text-base leading-7 text-[var(--cargo-ink)]/75\" data-kid=\"1-4-1-3-1-1-3\">\n                            La documentación incluye limpieza interior y exterior, desinfección y desinsectación de aeronaves.\n                        </p>\n                        <figure class=\"mt-7 overflow-hidden bg-[var(--cargo-deep)]\" data-kid=\"1-4-1-3-1-1-4\">\n                            <img alt=\"Personal de JMC realizando labores de limpieza de equipos aeroportuarios\" class=\"h-56 w-full object-cover sm:h-64\" data-kid=\"1-4-1-3-1-1-4-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/assets/images/equipment-cleaning.webp\"/>\n                            <figcaption class=\"bg-[var(--cargo-deep)] px-4 py-3 font-mono text-[10px] uppercase tracking-[.1em] text-white/80\" data-kid=\"1-4-1-3-1-1-4-2\">\n                                Registro visual de operaciones JMC\n                            </figcaption>\n                        </figure>\n                    </div>\n                    <div class=\"divide-y divide-[var(--cargo-deep)]/15 border-y border-[var(--cargo-deep)]/20\" data-kid=\"1-4-1-3-1-2\">\n                        <section class=\"py-5\" data-kid=\"1-4-1-3-1-2-1\">\n                            <h4 class=\"text-xl font-semibold text-[var(--cargo-deep)]\" data-kid=\"1-4-1-3-1-2-1-1\">\n                                Limpieza interior\n                            </h4>\n                            <p class=\"mt-2 text-sm leading-6 text-[var(--cargo-ink)]/70\" data-kid=\"1-4-1-3-1-2-1-2\">\n                                Cabina, asientos, moquetas, baños y cocina; control de residuos conforme a la normativa.\n                            </p>\n                            <p class=\"mt-3 text-xs leading-5 text-[var(--cargo-ink)]/60\" data-kid=\"1-4-1-3-1-2-1-3\">\n                                Asientos y moquetas · basura y reciclaje · baños y cocina · residuos\n                            </p>\n                        </section>\n                        <section class=\"py-5\" data-kid=\"1-4-1-3-1-2-2\">\n                            <h4 class=\"text-xl font-semibold text-[var(--cargo-deep)]\" data-kid=\"1-4-1-3-1-2-2-1\">\n                                Limpieza exterior\n                            </h4>\n                            <p class=\"mt-2 text-sm leading-6 text-[var(--cargo-ink)]/70\" data-kid=\"1-4-1-3-1-2-2-2\">\n                                Lavado de fuselaje, alas y tren de aterrizaje con productos biodegradables; inspección visual posterior.\n                            </p>\n                            <p class=\"mt-3 text-xs leading-5 text-[var(--cargo-ink)]/60\" data-kid=\"1-4-1-3-1-2-2-3\">\n                                Lavado descrito como certificado en el folleto · protección anticorrosiva\n                            </p>\n                        </section>\n                        <section class=\"py-5\" data-kid=\"1-4-1-3-1-2-3\">\n                            <h4 class=\"text-xl font-semibold text-[var(--cargo-deep)]\" data-kid=\"1-4-1-3-1-2-3-1\">\n                                Desinfección y desinsectación\n                            </h4>\n                            <p class=\"mt-2 text-sm leading-6 text-[var(--cargo-ink)]/70\" data-kid=\"1-4-1-3-1-2-3-2\">\n                                Tratamiento de cabina y zona de carga. El folleto refiere cumplimiento OMS/OACI e INAC.\n                            </p>\n                            <p class=\"mt-3 text-xs leading-5 text-[var(--cargo-ink)]/60\" data-kid=\"1-4-1-3-1-2-3-3\">\n                                Productos aprobados por las autoridades · certificación de zona tratada descrita en el folleto\n                            </p>\n                        </section>\n                        <a class=\"mt-5 inline-flex items-center gap-2 bg-[var(--cargo-emerald)] px-4 py-3 text-sm font-semibold text-[var(--cargo-ink)]\" data-kid=\"1-4-1-3-1-2-4\" data-name=\"request aircraft care service button\" href=\"/es/cotizacion?service=aircraft-care\">\n                            Solicitar cuidado de aeronaves\n                            <span aria-hidden=\"true\" data-kid=\"1-4-1-3-1-2-4-1\">\n                                ↗\n                            </span>\n                        </a>\n                    </div>\n                </div>\n            </article>\n            <article class=\"scroll-mt-8 border-t-2 border-[var(--cargo-deep)] py-9 lg:py-12\" data-kid=\"1-4-1-4\" id=\"obf\">\n                <div class=\"grid gap-8 lg:grid-cols-[.83fr_1.17fr] lg:gap-16\" data-kid=\"1-4-1-4-1\">\n                    <div data-kid=\"1-4-1-4-1-1\">\n                        <p class=\"font-mono text-xs uppercase tracking-[.14em] text-[var(--cargo-deep)]/65\" data-kid=\"1-4-1-4-1-1-1\">\n                            Operador de Base Fija · OBF\n                        </p>\n                        <h3 class=\"mt-3 max-w-lg text-3xl font-semibold leading-tight tracking-[-.04em] text-[var(--cargo-deep)] sm:text-4xl\" data-kid=\"1-4-1-4-1-1-2\">\n                            Coordinar despacho, seguimiento y estacionamiento\n                        </h3>\n                        <p class=\"mt-4 max-w-lg text-base leading-7 text-[var(--cargo-ink)]/75\" data-kid=\"1-4-1-4-1-1-3\">\n                            Servicios complementarios a explotadores aéreos descritos bajo la categoría de Operador de Base Fija.\n                        </p>\n                        <p class=\"mt-5 border-l border-[var(--cargo-emerald)] pl-4 text-sm leading-6 text-[var(--cargo-ink)]/70\" data-kid=\"1-4-1-4-1-1-4\">\n                            Secciones indicadas en el capítulo: 1, 4, 6 y 7.\n                        </p>\n                    </div>\n                    <div class=\"grid gap-x-10 border-t border-[var(--cargo-deep)]/20 sm:grid-cols-2\" data-kid=\"1-4-1-4-1-2\">\n                        <div class=\"border-b border-[var(--cargo-deep)]/15 py-5\" data-kid=\"1-4-1-4-1-2-1\">\n                            <h4 class=\"font-semibold text-[var(--cargo-deep)]\" data-kid=\"1-4-1-4-1-2-1-1\">\n                                Despacho y seguimiento de vuelo\n                            </h4>\n                            <p class=\"mt-2 text-sm leading-6 text-[var(--cargo-ink)]/70\" data-kid=\"1-4-1-4-1-2-1-2\">\n                                Para operaciones 121 y 135.\n                            </p>\n                        </div>\n                        <div class=\"border-b border-[var(--cargo-deep)]/15 py-5\" data-kid=\"1-4-1-4-1-2-2\">\n                            <h4 class=\"font-semibold text-[var(--cargo-deep)]\" data-kid=\"1-4-1-4-1-2-2-1\">\n                                Guía de estacionamiento\n                            </h4>\n                            <p class=\"mt-2 text-sm leading-6 text-[var(--cargo-ink)]/70\" data-kid=\"1-4-1-4-1-2-2-2\">\n                                Orientación de estacionamiento de aeronaves.\n                            </p>\n                        </div>\n                        <div class=\"border-b border-[var(--cargo-deep)]/15 py-5\" data-kid=\"1-4-1-4-1-2-3\">\n                            <h4 class=\"font-semibold text-[var(--cargo-deep)]\" data-kid=\"1-4-1-4-1-2-3-1\">\n                                Coordinación de rampa\n                            </h4>\n                            <p class=\"mt-2 text-sm leading-6 text-[var(--cargo-ink)]/70\" data-kid=\"1-4-1-4-1-2-3-2\">\n                                Coordinación de procesos en plataforma, según el folleto.\n                            </p>\n                        </div>\n                        <div class=\"border-b border-[var(--cargo-deep)]/15 py-5\" data-kid=\"1-4-1-4-1-2-4\">\n                            <h4 class=\"font-semibold text-[var(--cargo-deep)]\" data-kid=\"1-4-1-4-1-2-4-1\">\n                                Comunicación ATS / AOC\n                            </h4>\n                            <p class=\"mt-2 text-sm leading-6 text-[var(--cargo-ink)]/70\" data-kid=\"1-4-1-4-1-2-4-2\">\n                                Servicio mencionado en el catálogo del folleto.\n                            </p>\n                        </div>\n                        <a class=\"mt-5 inline-flex items-center gap-2 bg-[var(--cargo-emerald)] px-4 py-3 text-sm font-semibold text-[var(--cargo-ink)]\" data-kid=\"1-4-1-4-1-2-5\" href=\"/es/cotizacion?service=fbo-operations\">\n                            Solicitar coordinación en tierra\n                            <span aria-hidden=\"true\" data-kid=\"1-4-1-4-1-2-5-1\">\n                                ↗\n                            </span>\n                        </a>\n                    </div>\n                </div>\n            </article>\n            <article class=\"scroll-mt-8 border-t-2 border-[var(--cargo-deep)] py-9 lg:py-12\" data-kid=\"1-4-1-5\" id=\"pasajeros\">\n                <div class=\"grid gap-8 lg:grid-cols-[.83fr_1.17fr] lg:gap-16\" data-kid=\"1-4-1-5-1\">\n                    <div data-kid=\"1-4-1-5-1-1\">\n                        <p class=\"font-mono text-xs uppercase tracking-[.14em] text-[var(--cargo-deep)]/65\" data-kid=\"1-4-1-5-1-1-1\">\n                            Pasajeros y servicios especiales\n                        </p>\n                        <h3 class=\"mt-3 max-w-lg text-3xl font-semibold leading-tight tracking-[-.04em] text-[var(--cargo-deep)] sm:text-4xl\" data-kid=\"1-4-1-5-1-1-2\">\n                            Atender pasajeros y requerimientos especiales\n                        </h3>\n                        <p class=\"mt-4 max-w-lg text-base leading-7 text-[var(--cargo-ink)]/75\" data-kid=\"1-4-1-5-1-1-3\">\n                            Atención de pasajeros para operaciones 121 y 135, junto con servicios especiales descritos en los documentos.\n                        </p>\n                    </div>\n                    <div class=\"space-y-8\" data-kid=\"1-4-1-5-1-2\">\n                        <section data-kid=\"1-4-1-5-1-2-1\">\n                            <h4 class=\"text-xl font-semibold text-[var(--cargo-deep)]\" data-kid=\"1-4-1-5-1-2-1-1\">\n                                Tráfico de pasajeros\n                            </h4>\n                            <p class=\"mt-3 text-sm leading-6 text-[var(--cargo-ink)]/70\" data-kid=\"1-4-1-5-1-2-1-2\">\n                                Check-in y facturación · embarque y desembarque · asistencia PRM · menores sin acompañante (UM).\n                            </p>\n                        </section>\n                        <section class=\"border-t border-[var(--cargo-deep)]/20 pt-6\" data-kid=\"1-4-1-5-1-2-2\">\n                            <h4 class=\"text-xl font-semibold text-[var(--cargo-deep)]\" data-kid=\"1-4-1-5-1-2-2-1\">\n                                Servicios especiales descritos\n                            </h4>\n                            <p class=\"mt-3 text-sm leading-6 text-[var(--cargo-ink)]/70\" data-kid=\"1-4-1-5-1-2-2-2\">\n                                Sillas de ruedas y asistencia PRM · menores sin acompañante · animales de servicio · VIP y fast track.\n                            </p>\n                            <p class=\"mt-4 text-sm leading-6 text-[var(--cargo-ink)]/65\" data-kid=\"1-4-1-5-1-2-2-3\">\n                                El folleto también relaciona coordinación de catering, salón VIP, permisos de aterrizaje y sobrevuelos, asistencia a tripulaciones, aeropuertos alternos, combustible, GSE / ASU / ACU y traslado de aeronaves.\n                            </p>\n                        </section>\n                        <a class=\"mt-5 inline-flex items-center gap-2 bg-[var(--cargo-emerald)] px-4 py-3 text-sm font-semibold text-[var(--cargo-ink)]\" data-kid=\"1-4-1-5-1-2-3\" href=\"/es/cotizacion?service=passenger-services\">\n                            Solicitar atención a pasajeros\n                            <span aria-hidden=\"true\" data-kid=\"1-4-1-5-1-2-3-1\">\n                                ↗\n                            </span>\n                        </a>\n                    </div>\n                </div>\n            </article>\n            <article class=\"scroll-mt-8 border-t-2 border-[var(--cargo-deep)] py-9 lg:py-12\" data-kid=\"1-4-1-6\" id=\"mantenimiento\">\n                <div class=\"grid gap-8 lg:grid-cols-[.83fr_1.17fr] lg:gap-16\" data-kid=\"1-4-1-6-1\">\n                    <div data-kid=\"1-4-1-6-1-1\">\n                        <p class=\"font-mono text-xs uppercase tracking-[.14em] text-[var(--cargo-deep)]/65\" data-kid=\"1-4-1-6-1-1-1\">\n                            Mantenimiento GSE\n                        </p>\n                        <h3 class=\"mt-3 max-w-lg text-3xl font-semibold leading-tight tracking-[-.04em] text-[var(--cargo-deep)] sm:text-4xl\" data-kid=\"1-4-1-6-1-1-2\">\n                            Conservar los equipos de apoyo terrestre\n                        </h3>\n                        <p class=\"mt-4 max-w-lg text-base leading-7 text-[var(--cargo-ink)]/75\" data-kid=\"1-4-1-6-1-1-3\">\n                            El capítulo organizacional incluye el mantenimiento de equipos de apoyo terrestre; el folleto describe soporte preventivo y correctivo.\n                        </p>\n                    </div>\n                    <div class=\"grid gap-7 sm:grid-cols-[.9fr_1.1fr] sm:items-center\" data-kid=\"1-4-1-6-1-2\">\n                        <figure class=\"overflow-hidden bg-[var(--cargo-deep)]\" data-kid=\"1-4-1-6-1-2-1\">\n                            <img alt=\"Mantenimiento de un equipo de apoyo terrestre de JMC\" class=\"h-52 w-full object-cover sm:h-64\" data-kid=\"1-4-1-6-1-2-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/assets/images/gse-maintenance.webp\"/>\n                        </figure>\n                        <div data-kid=\"1-4-1-6-1-2-2\">\n                            <p class=\"border-t border-[var(--cargo-deep)]/20 py-4 text-sm leading-6 text-[var(--cargo-ink)]/75\" data-kid=\"1-4-1-6-1-2-2-1\">\n                                Mantenimiento preventivo\n                            </p>\n                            <p class=\"border-t border-[var(--cargo-deep)]/20 py-4 text-sm leading-6 text-[var(--cargo-ink)]/75\" data-kid=\"1-4-1-6-1-2-2-2\">\n                                Reparación de componentes\n                            </p>\n                            <p class=\"border-t border-[var(--cargo-deep)]/20 py-4 text-sm leading-6 text-[var(--cargo-ink)]/75\" data-kid=\"1-4-1-6-1-2-2-3\">\n                                Certificación de equipos críticos, según el folleto\n                            </p>\n                            <p class=\"border-t border-b border-[var(--cargo-deep)]/20 py-4 text-sm leading-6 text-[var(--cargo-ink)]/75\" data-kid=\"1-4-1-6-1-2-2-4\">\n                                Servicio en estación\n                            </p>\n                        </div>\n                    </div>\n                    <a class=\"mt-5 inline-flex w-fit items-center justify-self-start gap-2 bg-[var(--cargo-emerald)] px-4 py-3 text-sm font-semibold text-[var(--cargo-ink)] sm:col-start-2\" data-kid=\"1-4-1-6-1-3\" href=\"/es/cotizacion?service=gse-maintenance\">\n                        Consultar mantenimiento GSE\n                        <span aria-hidden=\"true\" data-kid=\"1-4-1-6-1-3-1\">\n                            ↗\n                        </span>\n                    </a>\n                </div>\n            </article>\n        </div>\n    </section>\n    <section class=\"bg-[var(--cargo-deep)] px-7 py-16 text-white lg:px-12 lg:py-24\" data-kid=\"1-5\" id=\"equipos\">\n        <div class=\"mx-auto max-w-[1320px]\" data-kid=\"1-5-1\">\n            <div class=\"grid gap-6 border-b border-white/20 pb-8 md:grid-cols-[.78fr_1.22fr] md:items-end\" data-kid=\"1-5-1-1\">\n                <h2 class=\"max-w-xl text-3xl font-semibold leading-tight tracking-[-.04em] sm:text-4xl\" data-kid=\"1-5-1-1-1\">\n                    Funciones de los equipos de plataforma\n                </h2>\n                <p class=\"max-w-2xl text-base leading-7 text-white/75\" data-kid=\"1-5-1-1-2\">\n                    Seis equipos, descritos por su función operativa. Definiciones basadas en el documento de funciones de equipos aeroportuarios.\n                </p>\n            </div>\n            <div class=\"mt-8 grid gap-x-12 gap-y-0 sm:grid-cols-2 xl:grid-cols-4\" data-kid=\"1-5-1-2\">\n                <section class=\"border-t border-[var(--cargo-light)]/40 py-6\" data-kid=\"1-5-1-2-1\">\n                    <p class=\"font-mono text-xs uppercase tracking-[.13em] text-[var(--cargo-light)]\" data-kid=\"1-5-1-2-1-1\">\n                        Remolque y movimiento\n                    </p>\n                    <div class=\"mt-5 border-b border-white/15 pb-5\" data-kid=\"1-5-1-2-1-2\">\n                        <h3 class=\"text-xl font-semibold\" data-kid=\"1-5-1-2-1-2-1\">\n                            Carrucha\n                        </h3>\n                        <p class=\"mt-2 text-sm leading-6 text-white/70\" data-kid=\"1-5-1-2-1-2-2\">\n                            Equipo sin motor para equipaje, correo o carga suelta. Se enganchan formando un tren remolcado entre terminal y aeronave.\n                        </p>\n                    </div>\n                    <div class=\"pt-5\" data-kid=\"1-5-1-2-1-3\">\n                        <h3 class=\"text-xl font-semibold\" data-kid=\"1-5-1-2-1-3-1\">\n                            Tractor remolcador\n                        </h3>\n                        <p class=\"mt-2 text-sm leading-6 text-white/70\" data-kid=\"1-5-1-2-1-3-2\">\n                            Vehículo motorizado, bajo y de gran tracción, que remolca carruchas y otros equipos pequeños hasta la plataforma.\n                        </p>\n                    </div>\n                </section>\n                <section class=\"border-t border-[var(--cargo-light)]/40 py-6\" data-kid=\"1-5-1-2-2\">\n                    <p class=\"font-mono text-xs uppercase tracking-[.13em] text-[var(--cargo-light)]\" data-kid=\"1-5-1-2-2-1\">\n                        Carga y equipaje\n                    </p>\n                    <div class=\"mt-5\" data-kid=\"1-5-1-2-2-2\">\n                        <h3 class=\"text-xl font-semibold\" data-kid=\"1-5-1-2-2-2-1\">\n                            Cinta transportadora\n                        </h3>\n                        <p class=\"mt-2 text-sm leading-6 text-white/70\" data-kid=\"1-5-1-2-2-2-2\">\n                            Banda elevable a la puerta de bodega que facilita la carga y descarga manual de maletas y carga a granel, previniendo lesiones.\n                        </p>\n                    </div>\n                </section>\n                <section class=\"border-t border-[var(--cargo-light)]/40 py-6\" data-kid=\"1-5-1-2-3\">\n                    <p class=\"font-mono text-xs uppercase tracking-[.13em] text-[var(--cargo-light)]\" data-kid=\"1-5-1-2-3-1\">\n                        Energía y arranque\n                    </p>\n                    <div class=\"mt-5 border-b border-white/15 pb-5\" data-kid=\"1-5-1-2-3-2\">\n                        <h3 class=\"text-xl font-semibold\" data-kid=\"1-5-1-2-3-2-1\">\n                            GPU · Ground Power Unit\n                        </h3>\n                        <p class=\"mt-2 text-sm leading-6 text-white/70\" data-kid=\"1-5-1-2-3-2-2\">\n                            Proporciona energía eléctrica con la aeronave estacionada y los motores apagados, sin consumir combustible del avión ni encender el APU.\n                        </p>\n                    </div>\n                    <div class=\"pt-5\" data-kid=\"1-5-1-2-3-3\">\n                        <h3 class=\"text-xl font-semibold\" data-kid=\"1-5-1-2-3-3-1\">\n                            ASU · Air Start Unit\n                        </h3>\n                        <p class=\"mt-2 text-sm leading-6 text-white/70\" data-kid=\"1-5-1-2-3-3-2\">\n                            Suministra aire comprimido a alta presión para ayudar a arrancar los motores, en particular cuando el APU está apagado o inoperativo.\n                        </p>\n                    </div>\n                </section>\n                <section class=\"border-t border-[var(--cargo-light)]/40 py-6\" data-kid=\"1-5-1-2-4\">\n                    <p class=\"font-mono text-xs uppercase tracking-[.13em] text-[var(--cargo-light)]\" data-kid=\"1-5-1-2-4-1\">\n                        Servicio de aeronave\n                    </p>\n                    <div class=\"mt-5\" data-kid=\"1-5-1-2-4-2\">\n                        <h3 class=\"text-xl font-semibold\" data-kid=\"1-5-1-2-4-2-1\">\n                            Carro de aguas residuales\n                        </h3>\n                        <p class=\"mt-2 text-sm leading-6 text-white/70\" data-kid=\"1-5-1-2-4-2-2\">\n                            Drena los residuos de los sanitarios y recarga el sistema con agua limpia y líquido desinfectante y desodorizante.\n                        </p>\n                    </div>\n                </section>\n            </div>\n            <p class=\"mt-8 border-t border-white/15 pt-5 text-sm leading-6 text-white/60\" data-kid=\"1-5-1-3\">\n                Las descripciones explican la función de los equipos; no representan disponibilidad de una unidad para cada operación.\n            </p>\n        </div>\n    </section>\n    <section class=\"bg-[var(--cargo-white)] px-7 py-14 lg:px-12 lg:py-20\" data-kid=\"1-6\" id=\"alcance\">\n        <div class=\"mx-auto grid max-w-[1320px] gap-10 md:grid-cols-[.7fr_1.3fr] md:items-start\" data-kid=\"1-6-1\">\n            <div data-kid=\"1-6-1-1\">\n                <h2 class=\"text-2xl font-semibold leading-tight tracking-[-.035em] text-[var(--cargo-deep)] sm:text-3xl\" data-kid=\"1-6-1-1-1\">\n                    Alcance descrito en la documentación\n                </h2>\n                <p class=\"mt-3 text-sm leading-6 text-[var(--cargo-ink)]/65\" data-kid=\"1-6-1-1-2\">\n                    Información organizacional de Servicios Especializados JMC.\n                </p>\n            </div>\n            <div data-kid=\"1-6-1-2\">\n                <p class=\"max-w-3xl text-base leading-7 text-[var(--cargo-ink)]/80\" data-kid=\"1-6-1-2-1\">\n                    El capítulo organizacional describe servicios prestados de acuerdo con la Regulación Aeronáutica Venezolana 111 (RAV 111) y nombra al INAC como autoridad emisora del certificado de explotador. Esta síntesis presenta únicamente las categorías y servicios que aparecen en la documentación consultada.\n                </p>\n                <p class=\"mt-5 text-sm leading-6 text-[var(--cargo-ink)]/60\" data-kid=\"1-6-1-2-2\">\n                    El número del certificado no se reproduce aquí: los materiales revisados usan grafías distintas y requieren cotejo antes de normalizarse.\n                </p>\n            </div>\n        </div>\n    </section>\n    <section class=\"bg-[var(--cargo-mist)] px-7 py-14 lg:px-12 lg:py-20\" data-kid=\"1-7\" id=\"contacto\">\n        <div class=\"mx-auto flex max-w-[1320px] flex-col gap-7 border-t border-[var(--cargo-deep)]/20 pt-8 md:flex-row md:items-end md:justify-between\" data-kid=\"1-7-1\">\n            <div class=\"max-w-3xl\" data-kid=\"1-7-1-1\">\n                <h2 class=\"text-3xl font-semibold leading-tight tracking-[-.04em] text-[var(--cargo-deep)] sm:text-4xl\" data-kid=\"1-7-1-1-1\">\n                    Comparta los detalles de la operación\n                </h2>\n                <p class=\"mt-4 max-w-2xl text-base leading-7 text-[var(--cargo-ink)]/70\" data-kid=\"1-7-1-1-2\">\n                    Indique tipo de aeronave, estación, frecuencia y servicios requeridos para orientar su solicitud.\n                </p>\n            </div>\n            <a class=\"inline-flex shrink-0 items-center justify-between gap-8 bg-[var(--cargo-emerald)] px-5 py-4 text-sm font-semibold text-[var(--cargo-ink)] hover:bg-[var(--cargo-light)]\" data-kid=\"1-7-1-2\" data-name=\"request contact page link\" href=\"/es/cotizacion\">\n                Enviar una solicitud\n                <span aria-hidden=\"true\" class=\"text-xl\" data-kid=\"1-7-1-2-1\">\n                    ↗\n                </span>\n            </a>\n        </div>\n        <div class=\"mx-auto mt-9 grid max-w-[1320px] gap-6 border-t border-[var(--cargo-deep)]/15 pt-6 sm:grid-cols-2 lg:grid-cols-4\" data-kid=\"1-7-2\">\n            <div data-kid=\"1-7-2-1\">\n                <p class=\"font-mono text-[10px] uppercase tracking-[.13em] text-[var(--cargo-deep)]/55\" data-kid=\"1-7-2-1-1\">\n                    Correo\n                </p>\n                <p class=\"mt-2 text-sm font-medium text-[var(--cargo-deep)]\" data-kid=\"1-7-2-1-2\">\n                    customer.service@jmchandling.com\n                </p>\n            </div>\n            <div data-kid=\"1-7-2-2\">\n                <p class=\"font-mono text-[10px] uppercase tracking-[.13em] text-[var(--cargo-deep)]/55\" data-kid=\"1-7-2-2-1\">\n                    Venezuela\n                </p>\n                <p class=\"mt-2 text-sm font-medium text-[var(--cargo-deep)]\" data-kid=\"1-7-2-2-2\">\n                    +58 414 118 0806\n                </p>\n            </div>\n            <div data-kid=\"1-7-2-3\">\n                <p class=\"font-mono text-[10px] uppercase tracking-[.13em] text-[var(--cargo-deep)]/55\" data-kid=\"1-7-2-3-1\">\n                    USA\n                </p>\n                <p class=\"mt-2 text-sm font-medium text-[var(--cargo-deep)]\" data-kid=\"1-7-2-3-2\">\n                    +1 954 470 4217\n                </p>\n            </div>\n            <div data-kid=\"1-7-2-4\">\n                <p class=\"font-mono text-[10px] uppercase tracking-[.13em] text-[var(--cargo-deep)]/55\" data-kid=\"1-7-2-4-1\">\n                    Oficina principal\n                </p>\n                <p class=\"mt-2 text-sm leading-5 text-[var(--cargo-deep)]\" data-kid=\"1-7-2-4-2\">\n                    Aeropuerto Internacional Simón Bolívar · Maiquetía, Venezuela\n                </p>\n            </div>\n        </div>\n    </section>\n    <footer class=\"bg-[var(--cargo-deep)] px-7 py-10 text-white lg:px-12\" data-kid=\"1-8\">\n        <div class=\"mx-auto flex max-w-[1320px] flex-col gap-8 sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-8-1\">\n            <div class=\"flex items-center gap-4\" data-kid=\"1-8-1-1\">\n                <img alt=\"\" aria-hidden=\"true\" class=\"h-9 w-auto\" data-kid=\"1-8-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/assets/brand/isotipo-logo.webp\"/>\n                <img alt=\"JMC Servicios Especializados\" class=\"h-7 w-auto\" data-kid=\"1-8-1-1-2\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/assets/brand/fuente-logo.webp\"/>\n            </div>\n            <p class=\"text-xs leading-5 text-white/65\" data-kid=\"1-8-1-2\">\n                Servicios Especializados JMC, C.A. · Maiquetía, Venezuela\n            </p>\n            <p class=\"font-mono text-[10px] uppercase tracking-[.1em] text-[var(--cargo-light)]/75\" data-kid=\"1-8-1-3\">\n                Servicios aeroportuarios · RAV 111\n            </p>\n        </div>\n    </footer>\n</main>\n",
