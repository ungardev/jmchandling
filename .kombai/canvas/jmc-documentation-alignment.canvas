        "h": 0
      },
      "html": "<div class=\"min-h-screen bg-[var(--cargo-mist)] font-sans text-[var(--cargo-ink)]\" data-kid=\"1\" style=\"--cargo-deep:#0F3E51;--cargo-light:#A0DDF5;--cargo-emerald:#5BA8C7;--cargo-ink:#0A1F2B;--cargo-mist:#F5F8FA;--cargo-white:#FFFFFF;font-family:'Inter',system-ui,sans-serif;\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap');\n        @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n    </style>\n    <header class=\"sticky top-0 z-20 border-b border-white/15 bg-[var(--cargo-deep)] text-[var(--cargo-white)]\" data-kid=\"1-1\">\n        <nav aria-label=\"Navegación principal\" class=\"mx-auto flex h-[76px] max-w-[1320px] items-center justify-between px-6 md:px-10\" data-kid=\"1-1-1\">\n            <a aria-label=\"JMC Servicios Especializados, inicio\" class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\" href=\"/es/\">\n                <img alt=\"\" class=\"h-10 w-auto object-contain\" data-kid=\"1-1-1-1-1\" data-name=\"company isotipo logo\" decoding=\"async\" height=\"96\" loading=\"lazy\" src=\"/api/local/images/public/assets/brand/isotipo-logo.webp\" width=\"114\"/>\n                <img alt=\"\" class=\"hidden h-8 w-auto sm:block\" data-kid=\"1-1-1-1-2\" data-name=\"company typography logo\" decoding=\"async\" height=\"111\" loading=\"lazy\" src=\"/api/local/images/public/assets/brand/fuente-logo.webp\" width=\"320\"/>\n            </a>\n            <div class=\"hidden items-center gap-9 text-[14px] font-medium md:flex\" data-kid=\"1-1-1-2\">\n                <a class=\"text-white/70\" data-kid=\"1-1-1-2-1\" href=\"/es/\">\n                    Inicio\n                </a>\n                <a class=\"border-b border-[var(--cargo-light)] py-2 text-white\" data-kid=\"1-1-1-2-2\" href=\"/es/servicios\">\n                    Servicios\n                </a>\n                <a class=\"text-white/70\" data-kid=\"1-1-1-2-3\" href=\"/es/contacto\">\n                    Contacto\n                </a>\n            </div>\n            <div class=\"flex items-center gap-5\" data-kid=\"1-1-1-3\">\n                <div class=\"font-mono text-[12px] font-medium tracking-[0.08em]\" data-kid=\"1-1-1-3-1\">\n                    <span class=\"text-[var(--cargo-light)]\" data-kid=\"1-1-1-3-1-1\">\n                        ES\n                    </span>\n                    <span class=\"px-1.5 text-white/40\" data-kid=\"1-1-1-3-1-2\">\n                        /\n                    </span>\n                    <span class=\"text-white/55\" data-kid=\"1-1-1-3-1-3\">\n                        EN\n                    </span>\n                </div>\n                <a class=\"hidden bg-[var(--cargo-light)] px-4 py-2.5 text-[13px] font-semibold text-[var(--cargo-deep)] md:inline-flex\" data-kid=\"1-1-1-3-2\" data-name=\"request service call-to-action button\" href=\"/es/cotizacion\">\n                    Enviar solicitud\n                    <span aria-hidden=\"true\" class=\"ml-3\" data-kid=\"1-1-1-3-2-1\">\n                        ↗\n                    </span>\n                </a>\n                <span aria-hidden=\"true\" class=\"flex h-10 w-10 items-center justify-center border border-white/30 text-[18px] text-white md:hidden\" data-kid=\"1-1-1-3-3\" data-name=\"navigation menu hamburger toggle button\">\n                    <i class=\"ti ti-menu-2\" data-kid=\"1-1-1-3-3-1\" data-name=\"hamburger menu icon\">\n                    </i>\n                </span>\n            </div>\n        </nav>\n    </header>\n    <main data-kid=\"1-2\">\n        <section class=\"bg-[var(--cargo-deep)] text-white\" data-kid=\"1-2-1\">\n            <div class=\"mx-auto grid max-w-[1320px] items-center gap-12 px-6 pb-12 pt-12 md:grid-cols-[0.9fr_1.1fr] md:px-10 md:pb-14 md:pt-16\" data-kid=\"1-2-1-1\">\n                <div class=\"max-w-[570px]\" data-kid=\"1-2-1-1-1\">\n                    <h1 class=\"text-[44px] font-semibold leading-[1.03] tracking-[-0.045em] sm:text-[54px] lg:text-[62px]\" data-kid=\"1-2-1-1-1-2\">\n                        Servicios de apoyo\n                        <br class=\"hidden lg:block\" data-kid=\"1-2-1-1-1-2-1\"/>\n                        a la operación\n                        <br class=\"hidden lg:block\" data-kid=\"1-2-1-1-1-2-2\"/>\n                        aeroportuaria.\n                    </h1>\n                    <p class=\"mt-6 max-w-[510px] text-[17px] leading-[1.65] text-white/90\" data-kid=\"1-2-1-1-1-3\">\n                        Servicios especializados aeroportuarios en Maiquetía para aeronaves de pasajeros y carga.\n                    </p>\n                    <p class=\"mt-3 max-w-[510px] text-[14px] leading-[1.7] text-white/70\" data-kid=\"1-2-1-1-1-3-2\">\n                        La documentación organizacional describe el apoyo con equipos en plataforma, el Operador de Base Fija y el mantenimiento de equipos terrestres.\n                    </p>\n                    <a class=\"mt-8 inline-flex min-h-[50px] items-center bg-[var(--cargo-light)] px-5 text-[14px] font-semibold text-[var(--cargo-deep)]\" data-kid=\"1-2-1-1-1-4\" href=\"/es/cotizacion\">\n                        Enviar solicitud\n                        <span aria-hidden=\"true\" class=\"ml-7 text-[18px]\" data-kid=\"1-2-1-1-1-4-1\">\n                            ↗\n                        </span>\n                    </a>\n                </div>\n                <figure class=\"relative\" data-kid=\"1-2-1-1-2\">\n                    <img alt=\"Equipos de apoyo terrestre JMC en instalaciones aeroportuarias\" class=\"h-[300px] w-full object-cover sm:h-[360px] md:h-[390px]\" data-kid=\"1-2-1-1-2-1\" decoding=\"async\" height=\"720\" loading=\"lazy\" src=\"/api/local/images/public/assets/images/gse-fleet.webp\" width=\"1280\"/>\n                    <figcaption class=\"absolute bottom-0 left-0 bg-[var(--cargo-ink)]/90 px-4 py-3 font-mono text-[11px] uppercase tracking-[0.12em] text-white/80\" data-kid=\"1-2-1-1-2-2\">\n                        Equipos JMC · operación en plataforma\n                    </figcaption>\n                </figure>\n            </div>\n            <div class=\"border-t border-white/15 bg-[var(--cargo-ink)]/35\" data-kid=\"1-2-1-2\">\n                <div class=\"mx-auto grid max-w-[1320px] gap-0 px-6 py-5 sm:grid-cols-2 md:px-10\" data-kid=\"1-2-1-2-1\">\n                    <p class=\"flex items-baseline gap-3 border-b border-white/15 pb-4 sm:border-b-0 sm:border-r sm:pb-0 sm:pr-8\" data-kid=\"1-2-1-2-1-1\">\n                        <span class=\"font-mono text-[24px] font-medium tracking-[-0.04em] text-white\" data-kid=\"1-2-1-2-1-1-1\">\n                            2012\n                        </span>\n                        <span class=\"text-[13px] text-white/70\" data-kid=\"1-2-1-2-1-1-2\">\n                            Año de constitución\n                        </span>\n                    </p>\n                    <p class=\"flex items-baseline gap-3 pt-4 sm:pl-8 sm:pt-0\" data-kid=\"1-2-1-2-1-2\">\n                        <span class=\"font-mono text-[24px] font-medium tracking-[-0.04em] text-white\" data-kid=\"1-2-1-2-1-2-1\">\n                            2015\n                        </span>\n                        <span class=\"text-[13px] text-white/70\" data-kid=\"1-2-1-2-1-2-2\">\n                            Inicio de servicios en Maiquetía\n                        </span>\n                    </p>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"scope-title\" class=\"mx-auto max-w-[1320px] px-6 py-14 md:px-10 md:py-[76px]\" data-kid=\"1-2-2\">\n            <div class=\"max-w-[780px]\" data-kid=\"1-2-2-1\">\n                <h2 class=\"text-[34px] font-semibold leading-[1.08] tracking-[-0.04em] text-[var(--cargo-deep)] sm:text-[42px]\" data-kid=\"1-2-2-1-1\" id=\"scope-title\">\n                    Alcances y servicios\n                </h2>\n                <p class=\"mt-4 text-[16px] leading-[1.7] text-[var(--cargo-ink)]/75\" data-kid=\"1-2-2-1-2\" data-name=\"section description text\">\n                    La fuente organizacional describe tres ámbitos: equipos de apoyo terrestre en plataforma, Operador de Base Fija y mantenimiento de equipos de apoyo terrestre.\n                </p>\n            </div>\n            <div class=\"mt-9 grid border-y border-[var(--cargo-deep)]/20 sm:grid-cols-3\" data-kid=\"1-2-2-2\">\n                <a class=\"group flex min-h-[106px] items-center justify-between gap-4 border-b border-[var(--cargo-deep)]/15 px-1 py-5 sm:border-b-0 sm:border-r sm:pr-7\" data-kid=\"1-2-2-2-1\" href=\"#equipos-plataforma\">\n                    <span data-kid=\"1-2-2-2-1-1\" data-name=\"feature card title container\">\n                        <span class=\"mt-1.5 block text-[16px] font-semibold leading-snug text-[var(--cargo-deep)]\" data-kid=\"1-2-2-2-1-1-2\">\n                            Equipos de apoyo terrestre\n                        </span>\n                    </span>\n                    <span aria-hidden=\"true\" class=\"text-[20px] text-[var(--cargo-emerald)] group-hover:translate-y-1\" data-kid=\"1-2-2-2-1-2\">\n                        ↓\n                    </span>\n                </a>\n                <a class=\"group flex min-h-[106px] items-center justify-between gap-4 border-b border-[var(--cargo-deep)]/15 px-1 py-5 sm:border-b-0 sm:border-r sm:px-7\" data-kid=\"1-2-2-2-2\" href=\"#operador-base-fija\">\n                    <span data-kid=\"1-2-2-2-2-1\" data-name=\"feature card title container\">\n                        <span class=\"mt-1.5 block text-[16px] font-semibold leading-snug text-[var(--cargo-deep)]\" data-kid=\"1-2-2-2-2-1-2\">\n                            Operador de Base Fija\n                        </span>\n                    </span>\n                    <span aria-hidden=\"true\" class=\"text-[20px] text-[var(--cargo-emerald)] group-hover:translate-y-1\" data-kid=\"1-2-2-2-2-2\">\n                        ↓\n                    </span>\n                </a>\n                <a class=\"group flex min-h-[106px] items-center justify-between gap-4 px-1 py-5 sm:pl-7\" data-kid=\"1-2-2-2-3\" href=\"#mantenimiento-gse\">\n                    <span data-kid=\"1-2-2-2-3-1\" data-name=\"feature card title container\">\n                        <span class=\"mt-1.5 block text-[16px] font-semibold leading-snug text-[var(--cargo-deep)]\" data-kid=\"1-2-2-2-3-1-2\">\n                            Mantenimiento de equipos\n                        </span>\n                    </span>\n                    <span aria-hidden=\"true\" class=\"text-[20px] text-[var(--cargo-emerald)] group-hover:translate-y-1\" data-kid=\"1-2-2-2-3-2\">\n                        ↓\n                    </span>\n                </a>\n            </div>\n        </section>\n        <section aria-labelledby=\"gse-title\" class=\"scroll-mt-24 bg-white\" data-kid=\"1-2-3\" id=\"equipos-plataforma\">\n            <div class=\"mx-auto grid max-w-[1320px] gap-10 px-6 py-14 md:grid-cols-[0.72fr_1.28fr] md:px-10 md:py-[72px]\" data-kid=\"1-2-3-1\">\n                <div data-kid=\"1-2-3-1-1\">\n                    <h2 class=\"mt-4 text-[32px] font-semibold leading-[1.1] tracking-[-0.04em] text-[var(--cargo-deep)] sm:text-[39px]\" data-kid=\"1-2-3-1-1-2\" id=\"gse-title\">\n                        Equipos de Apoyo Terrestre en plataforma\n                    </h2>\n                    <p class=\"mt-4 text-[15px] leading-[1.7] text-[var(--cargo-ink)]/75\" data-kid=\"1-2-3-1-1-3\">\n                        Secciones 1–8. Apoyo con equipos terrestres a explotadores de aeronaves de pasajeros y de carga.\n                    </p>\n                    <a class=\"mt-6 inline-flex items-center gap-3 text-[14px] font-semibold text-[var(--cargo-deep)] underline decoration-[var(--cargo-emerald)] decoration-2 underline-offset-4\" data-kid=\"1-2-3-1-1-4\" href=\"/es/cotizacion?service=ramp-gse\">\n                        Solicitar apoyo GSE\n                        <span aria-hidden=\"true\" data-kid=\"1-2-3-1-1-4-1\">\n                            ↗\n                        </span>\n                    </a>\n                </div>\n                <div class=\"border-t border-[var(--cargo-deep)]/20\" data-kid=\"1-2-3-1-2\">\n                    <div class=\"grid gap-x-10 sm:grid-cols-2\" data-kid=\"1-2-3-1-2-1\">\n                        <article class=\"border-b border-[var(--cargo-deep)]/15 py-5 sm:pr-3\" data-kid=\"1-2-3-1-2-1-1\">\n                            <h3 class=\"text-[16px] font-semibold text-[var(--cargo-deep)]\" data-kid=\"1-2-3-1-2-1-1-1\" data-name=\"service card title\">\n                                Atención en plataforma\n                            </h3>\n                            <p class=\"mt-1.5 text-[14px] leading-[1.65] text-[var(--cargo-ink)]/75\" data-kid=\"1-2-3-1-2-1-1-2\">\n                                Atención en plataforma a aeronaves de pasajeros y carga.\n                            </p>\n                        </article>\n                        <article class=\"border-b border-[var(--cargo-deep)]/15 py-5\" data-kid=\"1-2-3-1-2-1-2\">\n                            <h3 class=\"text-[16px] font-semibold text-[var(--cargo-deep)]\" data-kid=\"1-2-3-1-2-1-2-1\">\n                                Limpieza interior\n                            </h3>\n                            <p class=\"mt-1.5 text-[14px] leading-[1.65] text-[var(--cargo-ink)]/75\" data-kid=\"1-2-3-1-2-1-2-2\">\n                                Cabina, asientos, moquetas, baños y cocina; incluye control de residuos conforme a la normativa.\n                            </p>\n                        </article>\n                        <article class=\"border-b border-[var(--cargo-deep)]/15 py-5 sm:pr-3\" data-kid=\"1-2-3-1-2-1-3\">\n                            <h3 class=\"text-[16px] font-semibold text-[var(--cargo-deep)]\" data-kid=\"1-2-3-1-2-1-3-1\">\n                                Limpieza exterior\n                            </h3>\n                            <p class=\"mt-1.5 text-[14px] leading-[1.65] text-[var(--cargo-ink)]/75\" data-kid=\"1-2-3-1-2-1-3-2\">\n                                Lavado certificado de fuselaje, alas y tren de aterrizaje con productos biodegradables.\n                            </p>\n                        </article>\n                        <article class=\"border-b border-[var(--cargo-deep)]/15 py-5\" data-kid=\"1-2-3-1-2-1-4\">\n                            <h3 class=\"text-[16px] font-semibold text-[var(--cargo-deep)]\" data-kid=\"1-2-3-1-2-1-4-1\">\n                                Desinfección y desinsectación\n                            </h3>\n                            <p class=\"mt-1.5 text-[14px] leading-[1.65] text-[var(--cargo-ink)]/75\" data-kid=\"1-2-3-1-2-1-4-2\">\n                                Tratamiento de cabina y carga; desinfección y desinsectación dentro del marco descrito en el folleto.\n                            </p>\n                        </article>\n                    </div>\n                    <p class=\"mt-4 text-[12px] leading-relaxed text-[var(--cargo-ink)]/65\" data-kid=\"1-2-3-1-2-2\" data-name=\"additional equipment note text\">\n                        El folleto también menciona pushback y towbarless, GPU y ASU, ULD, y banda transportadora de equipaje.\n                    </p>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"obf-title\" class=\"scroll-mt-24 bg-[var(--cargo-mist)]\" data-kid=\"1-2-4\" id=\"operador-base-fija\">\n            <div class=\"mx-auto grid max-w-[1320px] gap-10 px-6 py-14 md:grid-cols-[0.72fr_1.28fr] md:px-10 md:py-[72px]\" data-kid=\"1-2-4-1\">\n                <div data-kid=\"1-2-4-1-1\">\n                    <h2 class=\"mt-4 text-[32px] font-semibold leading-[1.1] tracking-[-0.04em] text-[var(--cargo-deep)] sm:text-[39px]\" data-kid=\"1-2-4-1-1-2\" id=\"obf-title\">\n                        Operador de Base Fija (OBF)\n                    </h2>\n                    <p class=\"mt-4 text-[15px] leading-[1.7] text-[var(--cargo-ink)]/75\" data-kid=\"1-2-4-1-1-3\">\n                        Secciones 1, 4, 6 y 7. La documentación describe servicios complementarios para explotadores aéreos.\n                    </p>\n                    <a class=\"mt-6 inline-flex items-center gap-3 text-[14px] font-semibold text-[var(--cargo-deep)] underline decoration-[var(--cargo-emerald)] decoration-2 underline-offset-4\" data-kid=\"1-2-4-1-1-4\" href=\"/es/cotizacion?service=fbo-operations\">\n                        Solicitar apoyo OBF\n                        <span aria-hidden=\"true\" data-kid=\"1-2-4-1-1-4-1\">\n                            ↗\n                        </span>\n                    </a>\n                </div>\n                <div class=\"border-t border-[var(--cargo-deep)]/20\" data-kid=\"1-2-4-1-2\">\n                    <article class=\"grid gap-2 border-b border-[var(--cargo-deep)]/15 py-5 sm:grid-cols-[210px_1fr]\" data-kid=\"1-2-4-1-2-1\">\n                        <h3 class=\"text-[15px] font-semibold text-[var(--cargo-deep)]\" data-kid=\"1-2-4-1-2-1-1\">\n                            Despacho y seguimiento\n                        </h3>\n                        <p class=\"text-[14px] leading-[1.7] text-[var(--cargo-ink)]/75\" data-kid=\"1-2-4-1-2-1-2\">\n                            Despacho de aeronaves y seguimiento de vuelo para operaciones 121 y 135.\n                        </p>\n                    </article>\n                    <article class=\"grid gap-2 border-b border-[var(--cargo-deep)]/15 py-5 sm:grid-cols-[210px_1fr]\" data-kid=\"1-2-4-1-2-2\">\n                        <h3 class=\"text-[15px] font-semibold text-[var(--cargo-deep)]\" data-kid=\"1-2-4-1-2-2-1\">\n                            Guía de estacionamiento\n                        </h3>\n                        <p class=\"text-[14px] leading-[1.7] text-[var(--cargo-ink)]/75\" data-kid=\"1-2-4-1-2-2-2\">\n                            Guía de estacionamiento de aeronaves en general.\n                        </p>\n                    </article>\n                    <article class=\"grid gap-2 border-b border-[var(--cargo-deep)]/15 py-5 sm:grid-cols-[210px_1fr]\" data-kid=\"1-2-4-1-2-3\">\n                        <h3 class=\"text-[15px] font-semibold text-[var(--cargo-deep)]\" data-kid=\"1-2-4-1-2-3-1\">\n                            Tráfico de pasajeros\n                        </h3>\n                        <p class=\"text-[14px] leading-[1.7] text-[var(--cargo-ink)]/75\" data-kid=\"1-2-4-1-2-3-2\">\n                            Atención 121 / 135, con check-in, facturación, embarque y desembarque, asistencia PRM y menores sin acompañante.\n                        </p>\n                    </article>\n                    <article class=\"grid gap-2 border-b border-[var(--cargo-deep)]/15 py-5 sm:grid-cols-[210px_1fr]\" data-kid=\"1-2-4-1-2-4\">\n                        <h3 class=\"text-[15px] font-semibold text-[var(--cargo-deep)]\" data-kid=\"1-2-4-1-2-4-1\">\n                            Servicios especiales\n                        </h3>\n                        <p class=\"text-[14px] leading-[1.7] text-[var(--cargo-ink)]/75\" data-kid=\"1-2-4-1-2-4-2\">\n                            Asistencia PRM y silla de ruedas, menores sin acompañante, animales de servicio, VIP y fast track.\n                        </p>\n                    </article>\n                    <div class=\"border-b border-[var(--cargo-deep)]/15 py-5\" data-kid=\"1-2-4-1-2-5\">\n                        <h3 class=\"text-[14px] font-semibold text-[var(--cargo-deep)]\" data-kid=\"1-2-4-1-2-5-1\">\n                            Otros servicios citados en el folleto\n                        </h3>\n                        <p class=\"mt-2 text-[13px] leading-[1.7] text-[var(--cargo-ink)]/75\" data-kid=\"1-2-4-1-2-5-2\">\n                            Coordinación de catering y salón VIP · permisos de aterrizaje y sobrevuelo · apoyo a tripulaciones y aeropuertos alternos · combustible · GSE / ASU / ACU · traslado de aeronaves.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"maintenance-title\" class=\"scroll-mt-24 bg-white\" data-kid=\"1-2-5\" id=\"mantenimiento-gse\">\n            <div class=\"mx-auto grid max-w-[1320px] gap-10 px-6 py-14 md:grid-cols-[0.72fr_1.28fr] md:px-10 md:py-[72px]\" data-kid=\"1-2-5-1\">\n                <div data-kid=\"1-2-5-1-1\">\n                    <h2 class=\"mt-4 text-[32px] font-semibold leading-[1.1] tracking-[-0.04em] text-[var(--cargo-deep)] sm:text-[39px]\" data-kid=\"1-2-5-1-1-2\" id=\"maintenance-title\">\n                        Mantenimiento de equipos de apoyo terrestre\n                    </h2>\n                    <p class=\"mt-4 text-[15px] leading-[1.7] text-[var(--cargo-ink)]/75\" data-kid=\"1-2-5-1-1-3\">\n                        El folleto describe mantenimiento preventivo, reparación de componentes, certificación de equipos críticos y servicio en estación.\n                    </p>\n                    <a class=\"mt-6 inline-flex items-center gap-3 text-[14px] font-semibold text-[var(--cargo-deep)] underline decoration-[var(--cargo-emerald)] decoration-2 underline-offset-4\" data-kid=\"1-2-5-1-1-4\" href=\"/es/cotizacion?service=gse-maintenance\">\n                        Consultar mantenimiento GSE\n                        <span aria-hidden=\"true\" data-kid=\"1-2-5-1-1-4-1\">\n                            ↗\n                        </span>\n                    </a>\n                </div>\n                <figure class=\"grid min-w-0 grid-cols-[1.1fr_0.9fr] items-center gap-5 border-t border-[var(--cargo-deep)]/20 pt-5 sm:gap-8\" data-kid=\"1-2-5-1-2\">\n                    <img alt=\"Personal JMC trabajando en un equipo de apoyo terrestre\" class=\"h-[220px] w-full object-cover sm:h-[280px]\" data-kid=\"1-2-5-1-2-1\" decoding=\"async\" height=\"720\" loading=\"lazy\" src=\"/api/local/images/public/assets/images/gse-maintenance.webp\" width=\"720\"/>\n                    <figcaption class=\"max-w-[270px] text-[14px] leading-[1.7] text-[var(--cargo-ink)]/70\" data-kid=\"1-2-5-1-2-2\">\n                        Mantenimiento de equipos de apoyo terrestre. Imagen de operaciones JMC.\n                    </figcaption>\n                </figure>\n            </div>\n        </section>\n        <section aria-labelledby=\"equipment-title\" class=\"bg-[var(--cargo-deep)] text-white\" data-kid=\"1-2-6\">\n            <div class=\"mx-auto max-w-[1320px] px-6 py-14 md:px-10 md:py-[76px]\" data-kid=\"1-2-6-1\">\n                <div class=\"grid gap-6 border-b border-white/20 pb-8 md:grid-cols-[0.8fr_1.2fr] md:items-end\" data-kid=\"1-2-6-1-1\">\n                    <h2 class=\"max-w-[440px] text-[34px] font-semibold leading-[1.08] tracking-[-0.04em] sm:text-[42px]\" data-kid=\"1-2-6-1-1-1\" id=\"equipment-title\">\n                        Funciones de los equipos de plataforma\n                    </h2>\n                    <p class=\"max-w-[620px] text-[15px] leading-[1.7] text-white/75\" data-kid=\"1-2-6-1-1-2\">\n                        Referencia técnica de los seis equipos descritos en el documento de funciones aeroportuarias.\n                    </p>\n                </div>\n                <div class=\"mt-2 grid gap-x-12 md:grid-cols-2\" data-kid=\"1-2-6-1-2\">\n                    <article class=\"border-b border-white/15 py-5\" data-kid=\"1-2-6-1-2-1\">\n                        <h3 class=\"text-[16px] font-semibold text-[var(--cargo-light)]\" data-kid=\"1-2-6-1-2-1-1\">\n                            Carrucha · carro de equipaje\n                        </h3>\n                        <p class=\"mt-2 text-[14px] leading-[1.7] text-white/80\" data-kid=\"1-2-6-1-2-1-2\">\n                            Equipo sin motor para transportar equipaje, correo o carga suelta. Puede unirse a otras carruchas y formar un tren remolcado entre la terminal y la aeronave.\n                        </p>\n                    </article>\n                    <article class=\"border-b border-white/15 py-5\" data-kid=\"1-2-6-1-2-2\">\n                        <h3 class=\"text-[16px] font-semibold text-[var(--cargo-light)]\" data-kid=\"1-2-6-1-2-2-1\">\n                            Tractor remolcador de equipaje\n                        </h3>\n                        <p class=\"mt-2 text-[14px] leading-[1.7] text-white/80\" data-kid=\"1-2-6-1-2-2-2\">\n                            Vehículo motorizado, bajo y de gran tracción, que remolca carruchas y otros equipos pequeños hacia la plataforma.\n                        </p>\n                    </article>\n                    <article class=\"border-b border-white/15 py-5\" data-kid=\"1-2-6-1-2-3\">\n                        <h3 class=\"text-[16px] font-semibold text-[var(--cargo-light)]\" data-kid=\"1-2-6-1-2-3-1\">\n                            Carro de aguas residuales\n                        </h3>\n                        <p class=\"mt-2 text-[14px] leading-[1.7] text-white/80\" data-kid=\"1-2-6-1-2-3-2\">\n                            Atiende el servicio sanitario de la aeronave: vacía y drena los tanques de residuos y recarga el sistema con agua limpia y líquido desinfectante y desodorizante.\n                        </p>\n                    </article>\n                    <article class=\"border-b border-white/15 py-5\" data-kid=\"1-2-6-1-2-4\">\n                        <h3 class=\"text-[16px] font-semibold text-[var(--cargo-light)]\" data-kid=\"1-2-6-1-2-4-1\">\n                            Cinta transportadora de equipaje\n                        </h3>\n                        <p class=\"mt-2 text-[14px] leading-[1.7] text-white/80\" data-kid=\"1-2-6-1-2-4-2\">\n                            Banda elevable y ajustable hasta la puerta de la bodega, que facilita la carga y descarga manual de maletas y carga a granel y ayuda a prevenir lesiones.\n                        </p>\n                    </article>\n                    <article class=\"border-b border-white/15 py-5\" data-kid=\"1-2-6-1-2-5\">\n                        <h3 class=\"text-[16px] font-semibold text-[var(--cargo-light)]\" data-kid=\"1-2-6-1-2-5-1\">\n                            GPU · Ground Power Unit\n                        </h3>\n                        <p class=\"mt-2 text-[14px] leading-[1.7] text-white/80\" data-kid=\"1-2-6-1-2-5-2\">\n                            Unidad que suministra energía eléctrica a la aeronave estacionada con los motores apagados, manteniendo sus sistemas eléctricos sin consumir combustible de la aeronave ni encender el APU.\n                        </p>\n                    </article>\n                    <article class=\"border-b border-white/15 py-5\" data-kid=\"1-2-6-1-2-6\">\n                        <h3 class=\"text-[16px] font-semibold text-[var(--cargo-light)]\" data-kid=\"1-2-6-1-2-6-1\">\n                            ASU · Air Start Unit\n                        </h3>\n                        <p class=\"mt-2 text-[14px] leading-[1.7] text-white/80\" data-kid=\"1-2-6-1-2-6-2\">\n                            Unidad que suministra aire comprimido a alta presión para ayudar a arrancar los motores principales, especialmente cuando el APU no está disponible o permanece apagado.\n                        </p>\n                    </article>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"authorization-title\" class=\"bg-[var(--cargo-mist)]\" data-kid=\"1-2-7\">\n            <div class=\"mx-auto grid max-w-[1320px] gap-10 px-6 py-14 md:grid-cols-[1fr_1fr] md:items-center md:px-10 md:py-[68px]\" data-kid=\"1-2-7-1\">\n                <div data-kid=\"1-2-7-1-1\">\n                    <h2 class=\"text-[30px] font-semibold leading-[1.12] tracking-[-0.035em] text-[var(--cargo-deep)] sm:text-[36px]\" data-kid=\"1-2-7-1-1-1\" id=\"authorization-title\">\n                        Alcance, RAV 111 y autoridad aeronáutica\n                    </h2>\n                    <p class=\"mt-4 max-w-[560px] text-[15px] leading-[1.75] text-[var(--cargo-ink)]/75\" data-kid=\"1-2-7-1-1-2\">\n                        El capítulo organizacional describe la prestación de servicios bajo la Regulación Aeronáutica Venezolana 111 y el Certificado de Explotador de Servicios Especializados Aeroportuarios emitido por INAC.\n                    </p>\n                    <p class=\"mt-4 max-w-[560px] text-[12px] leading-[1.65] text-[var(--cargo-ink)]/65\" data-kid=\"1-2-7-1-1-3\">\n                        El folleto presenta dos grafías del número de certificado —CESA 021 y CESEA 021—; cotejar la denominación con el documento oficial antes de publicarla como identificador.\n                    </p>\n                </div>\n                <figure class=\"border border-[var(--cargo-deep)]/15 bg-white p-3 sm:p-5\" data-kid=\"1-2-7-1-2\">\n                    <img alt=\"Extracto del documento de explotador de Servicios Especializados JMC emitido por INAC; imagen en escala de grises\" class=\"h-[190px] w-full object-cover object-top sm:h-[240px]\" data-kid=\"1-2-7-1-2-1\" decoding=\"async\" height=\"600\" loading=\"lazy\" src=\"/api/local/images/public/assets/images/cesea-cert.webp\" width=\"800\"/>\n                    <figcaption class=\"flex flex-wrap items-center justify-between gap-3 pt-3 text-[12px] text-[var(--cargo-ink)]/70\" data-kid=\"1-2-7-1-2-2\">\n                        <span data-kid=\"1-2-7-1-2-2-1\" data-name=\"certificate document preview label\">\n                            Documento de INAC · vista previa\n                        </span>\n                        <a class=\"inline-flex items-center gap-2 font-semibold text-[var(--cargo-deep)] underline decoration-[var(--cargo-emerald)] underline-offset-4\" data-kid=\"1-2-7-1-2-2-2\" data-name=\"view full certificate link\" href=\"/assets/images/cesea-cert.webp\" rel=\"noopener noreferrer\" target=\"_blank\">\n                            Abrir extracto completo\n                            <span aria-hidden=\"true\" data-kid=\"1-2-7-1-2-2-2-1\" data-name=\"external link arrow icon\">\n                                ↗\n                            </span>\n                        </a>\n                    </figcaption>\n                </figure>\n            </div>\n        </section>\n        <section aria-label=\"Solicitud operativa\" class=\"bg-white\" data-kid=\"1-2-8\">\n            <div class=\"mx-auto flex max-w-[1320px] flex-col justify-between gap-7 px-6 py-12 md:flex-row md:items-center md:px-10 md:py-[54px]\" data-kid=\"1-2-8-1\">\n                <div data-kid=\"1-2-8-1-1\">\n                    <h2 class=\"text-[28px] font-semibold tracking-[-0.035em] text-[var(--cargo-deep)]\" data-kid=\"1-2-8-1-1-1\">\n                        ¿Necesitas consultar una operación?\n                    </h2>\n                    <p class=\"mt-2 max-w-[620px] text-[14px] leading-[1.7] text-[var(--cargo-ink)]/70\" data-kid=\"1-2-8-1-1-2\">\n                        Comparte el servicio, tipo de aeronave y los detalles de la operación para que JMC pueda revisar tu solicitud.\n                    </p>\n                </div>\n                <a class=\"inline-flex min-h-[50px] shrink-0 items-center justify-between gap-10 bg-[var(--cargo-emerald)] px-5 text-[14px] font-semibold text-[var(--cargo-ink)]\" data-kid=\"1-2-8-1-2\" href=\"/es/cotizacion\">\n                    Enviar detalles\n                    <span aria-hidden=\"true\" class=\"text-[18px]\" data-kid=\"1-2-8-1-2-1\">\n                        ↗\n                    </span>\n                </a>\n            </div>\n        </section>\n    </main>\n    <footer class=\"bg-[var(--cargo-deep)] text-white\" data-kid=\"1-3\">\n        <div class=\"mx-auto grid max-w-[1320px] gap-9 px-6 py-10 md:grid-cols-[1.2fr_0.8fr_1fr] md:px-10\" data-kid=\"1-3-1\">\n            <div class=\"flex items-start gap-4\" data-kid=\"1-3-1-1\">\n                <div class=\"flex shrink-0 items-center gap-3\" data-kid=\"1-3-1-1-3\" data-name=\"footer company logo container\">\n                    <img alt=\"\" class=\"h-10 w-auto object-contain\" data-kid=\"1-3-1-1-1\" data-name=\"footer company isotipo logo\" decoding=\"async\" height=\"96\" loading=\"lazy\" src=\"/api/local/images/public/assets/brand/isotipo-logo.webp\" width=\"114\"/>\n                    <img alt=\"\" class=\"h-8 w-auto object-contain\" data-kid=\"1-3-1-1-1-2\" data-name=\"footer company typography logo\" decoding=\"async\" height=\"111\" loading=\"lazy\" src=\"/api/local/images/public/assets/brand/fuente-logo.webp\" width=\"320\"/>\n                </div>\n                <p class=\"max-w-[280px] pt-1 text-[13px] leading-[1.65] text-white/75\" data-kid=\"1-3-1-1-2\">\n                    Servicios especializados aeroportuarios · Maiquetía, Venezuela.\n                </p>\n            </div>\n            <div class=\"text-[13px] leading-[1.8] text-white/75\" data-kid=\"1-3-1-2\">\n                <span class=\"block font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--cargo-light)]\" data-kid=\"1-3-1-2-1\">\n                    Contacto\n                </span>\n                <span class=\"mt-2 block\" data-kid=\"1-3-1-2-2\">\n                    customer.service@jmchandling.com\n                </span>\n                <span data-kid=\"1-3-1-2-3\">\n                    +58 414 118 0806 · +1 954 470 4217\n                </span>\n            </div>\n            <div class=\"text-[13px] leading-[1.8] text-white/65 md:text-right\" data-kid=\"1-3-1-3\">\n                <span class=\"block\" data-kid=\"1-3-1-3-1\">\n                    © 2026 Servicios Especializados JMC, C.A.\n                </span>\n                <span data-kid=\"1-3-1-3-2\">\n                    RAV 111 · Contenido sujeto a la documentación consultada\n                </span>\n            </div>\n        </div>\n    </footer>\n</div>\n",
      "comments": [],
      "created": "2026-10-04T15:28:26.576721+00:00",
      "modified": "2026-10-04T15:39:26.781889+00:00",
