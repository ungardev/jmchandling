      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap');\n:root{--cargo-deep:#0F3E51;--cargo-light:#A0DDF5;--cargo-emerald:#5BA8C7;--cargo-ink:#0A1F2B;--cargo-mist:#F5F8FA;--cargo-white:#FFFFFF}\n</style>\n<div class=\"min-h-screen bg-[var(--cargo-mist)] text-[var(--cargo-ink)]\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:Inter,system-ui,sans-serif\">\n    <header class=\"sticky top-0 z-30 border-b border-white/15 bg-[var(--cargo-deep)] text-white\" data-kid=\"1-1\" data-name=\"header container\">\n        <div class=\"mx-auto flex max-w-[1320px] items-center justify-between gap-8 px-6 py-4 lg:px-10\" data-kid=\"1-1-1\" data-name=\"navigation wrapper\">\n            <a aria-label=\"JMC Handling, inicio\" class=\"flex shrink-0 items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"brand logo link\" href=\"/es/\">\n                <img alt=\"\" aria-hidden=\"true\" class=\"h-10 w-auto object-contain\" data-kid=\"1-1-1-1-1\" data-name=\"brand isotipo image\" decoding=\"async\" height=\"96\" loading=\"lazy\" src=\"/api/local/images/public/assets/brand/isotipo-logo.webp\" width=\"114\"/>\n                <img alt=\"Servicios Especializados JMC\" class=\"hidden h-8 w-auto object-contain sm:block\" data-kid=\"1-1-1-1-2\" data-name=\"brand text image\" decoding=\"async\" height=\"111\" loading=\"lazy\" src=\"/api/local/images/public/assets/brand/fuente-logo.webp\" width=\"320\"/>\n            </a>\n            <nav aria-label=\"Navegación principal\" class=\"hidden items-center gap-8 text-sm font-medium text-white/80 lg:flex\" data-kid=\"1-1-1-2\" data-name=\"main navigation menu\">\n                <a class=\"transition-colors hover:text-white\" data-kid=\"1-1-1-2-1\" data-name=\"navigation link capabilities\" href=\"#capacidades\">\n                    Capacidades\n                </a>\n                <a class=\"transition-colors hover:text-white\" data-kid=\"1-1-1-2-2\" data-name=\"navigation link about\" href=\"#empresa\">\n                    La empresa\n                </a>\n                <a class=\"transition-colors hover:text-white\" data-kid=\"1-1-1-2-3\" data-name=\"navigation link equipment\" href=\"#equipos\">\n                    Equipos GSE\n                </a>\n                <a class=\"transition-colors hover:text-white\" data-kid=\"1-1-1-2-4\" data-name=\"navigation link contact\" href=\"/es/contacto\">\n                    Contacto\n                </a>\n            </nav>\n            <div class=\"flex items-center gap-4\" data-kid=\"1-1-1-3\" data-name=\"language and cta wrapper\">\n                <a aria-current=\"page\" class=\"font-mono text-xs font-semibold tracking-[.08em] text-[var(--cargo-light)]\" data-kid=\"1-1-1-3-1\" data-name=\"language selector spanish\" href=\"/es/\" lang=\"es\">\n                    ES\n                </a>\n                <span aria-hidden=\"true\" class=\"text-white/35\" data-kid=\"1-1-1-3-2\" data-name=\"language separator\">\n                    /\n                </span>\n                <a class=\"font-mono text-xs font-semibold tracking-[.08em] text-white/65 transition-colors hover:text-white\" data-kid=\"1-1-1-3-3\" data-name=\"language selector english\" href=\"/en/\" lang=\"en\">\n                    EN\n                </a>\n                <a class=\"hidden border border-[var(--cargo-light)]/60 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-white/10 sm:inline-flex\" data-kid=\"1-1-1-3-4\" data-name=\"primary cta button\" href=\"/es/cotizacion\">\n                    Enviar requerimiento\n                    <span aria-hidden=\"true\" class=\"ml-3 text-[var(--cargo-light)]\" data-kid=\"1-1-1-3-4-1\" data-name=\"external link arrow icon\">\n                        ↗\n                    </span>\n                </a>\n            </div>\n        </div>\n    </header>\n    <main data-kid=\"1-2\" data-name=\"main content area\">\n        <section class=\"bg-[var(--cargo-deep)] text-white\" data-kid=\"1-2-1\" data-name=\"hero section\">\n            <div class=\"mx-auto grid max-w-[1320px] items-center gap-10 px-6 pb-12 pt-14 md:grid-cols-[.92fr_1.08fr] md:gap-12 md:py-16 lg:px-10\" data-kid=\"1-2-1-1\" data-name=\"hero content grid\">\n                <div class=\"max-w-[580px]\" data-kid=\"1-2-1-1-1\" data-name=\"hero copy block\">\n                    <p class=\"mb-6 font-mono text-xs uppercase tracking-[.16em] text-[var(--cargo-light)]\" data-kid=\"1-2-1-1-1-1\" data-name=\"hero pre-headline\">\n                        Servicios Especializados JMC, C.A.\n                    </p>\n                    <h1 class=\"max-w-[600px] text-balance text-5xl font-semibold leading-[1.02] tracking-[-.045em] sm:text-6xl xl:text-[4.5rem]\" data-kid=\"1-2-1-1-1-2\" data-name=\"hero main headline\">\n                        Apoyo en tierra para operar en Maiquetía.\n                    </h1>\n                    <p class=\"mt-6 max-w-xl text-lg leading-relaxed text-white/80\" data-kid=\"1-2-1-1-1-3\" data-name=\"hero description text\">\n                        Servicios aeroportuarios para aeronaves, pasajeros, equipaje y carga. Explore el tipo de asistencia que necesita su operación.\n                    </p>\n                    <p class=\"mt-4 max-w-xl text-sm italic leading-relaxed text-white/65\" data-kid=\"1-2-1-1-1-4\" data-name=\"hero testimonial quote\">\n                        “El éxito de todo vuelo depende, esencialmente, de la excelencia en tierra.”\n                    </p>\n                    <div class=\"mt-8 flex flex-wrap items-center gap-5\" data-kid=\"1-2-1-1-1-5\" data-name=\"hero action button group\">\n                        <a class=\"inline-flex items-center gap-3 bg-[var(--cargo-emerald)] px-5 py-3.5 text-sm font-semibold text-[var(--cargo-ink)] transition-colors hover:bg-[var(--cargo-light)]\" data-kid=\"1-2-1-1-1-5-1\" data-name=\"hero primary cta\" href=\"#capacidades\">\n                            Encontrar asistencia\n                            <span aria-hidden=\"true\" data-kid=\"1-2-1-1-1-5-1-1\" data-name=\"down arrow icon\">\n                                ↓\n                            </span>\n                        </a>\n                        <a class=\"inline-flex items-center gap-2 text-sm font-semibold text-white underline decoration-white/35 underline-offset-4 transition-colors hover:text-[var(--cargo-light)]\" data-kid=\"1-2-1-1-1-5-2\" data-name=\"hero secondary cta\" href=\"/es/servicios\">\n                            Ver el catálogo completo\n                            <span aria-hidden=\"true\" data-kid=\"1-2-1-1-1-5-2-1\" data-name=\"external link arrow icon\">\n                                ↗\n                            </span>\n                        </a>\n                    </div>\n                    <div class=\"mt-9 flex items-center gap-3 border-t border-white/15 pt-5 text-sm text-white/65\" data-kid=\"1-2-1-1-1-6\" data-name=\"hero airport location badge\">\n                        <span aria-hidden=\"true\" class=\"h-2 w-2 shrink-0 rounded-full bg-[var(--cargo-emerald)]\" data-kid=\"1-2-1-1-1-6-1\" data-name=\"status indicator dot\">\n                        </span>\n                        Aeropuerto Internacional Simón Bolívar · Maiquetía, CCS\n                    </div>\n                </div>\n                <figure class=\"relative min-h-[360px] overflow-hidden bg-[var(--cargo-ink)] md:min-h-[460px]\" data-kid=\"1-2-1-1-2\" data-name=\"hero image container\">\n                    <img alt=\"Equipos de apoyo terrestre JMC estacionados en plataforma\" class=\"absolute inset-0 h-full w-full object-cover\" data-kid=\"1-2-1-1-2-1\" data-name=\"hero fleet image\" decoding=\"async\" height=\"720\" loading=\"lazy\" src=\"/api/local/images/public/assets/images/gse-fleet.webp\" width=\"1280\"/>\n                    <div aria-hidden=\"true\" class=\"absolute inset-0 bg-gradient-to-t from-[var(--cargo-ink)]/70 via-transparent to-transparent\" data-kid=\"1-2-1-1-2-2\" data-name=\"hero image gradient overlay\">\n                    </div>\n                    <figcaption class=\"absolute inset-x-0 bottom-0 flex flex-wrap items-end justify-between gap-4 border-t border-white/20 px-5 py-4 text-xs text-white/85 sm:px-7\" data-kid=\"1-2-1-1-2-3\" data-name=\"hero image caption bar\">\n                        <span data-kid=\"1-2-1-1-2-3-1\" data-name=\"hero image description\">\n                            Equipos de apoyo terrestre en estación\n                        </span>\n                        <span class=\"font-mono uppercase tracking-[.1em] text-[var(--cargo-light)]\" data-kid=\"1-2-1-1-2-3-2\" data-name=\"hero operation tag\">\n                            Operación en plataforma · CCS\n                        </span>\n                    </figcaption>\n                </figure>\n            </div>\n        </section>\n        <section aria-label=\"Datos de la empresa\" class=\"border-b border-[var(--cargo-deep)]/10 bg-white\" data-kid=\"1-2-2\" data-name=\"company history data section\">\n            <dl class=\"mx-auto grid max-w-[1320px] grid-cols-1 divide-y divide-[var(--cargo-deep)]/15 px-6 sm:grid-cols-2 sm:divide-y-0 lg:grid-cols-[.7fr_1.3fr] lg:px-10\" data-kid=\"1-2-2-1\" data-name=\"data list grid\">\n                <div class=\"flex items-center gap-5 py-6 sm:pr-10\" data-kid=\"1-2-2-1-1\" data-name=\"company milestone founded year block\">\n                    <dt class=\"font-mono text-3xl font-semibold tracking-[-.05em] text-[var(--cargo-deep)] sm:text-4xl\" data-kid=\"1-2-2-1-1-1\" data-name=\"milestone year\">\n                        2012\n                    </dt>\n                    <dd class=\"max-w-[175px] text-sm leading-snug text-[var(--cargo-ink)]/70\" data-kid=\"1-2-2-1-1-2\" data-name=\"milestone description\">\n                        Constitución de Servicios Especializados JMC\n                    </dd>\n                </div>\n                <div class=\"flex items-center gap-5 border-[var(--cargo-deep)]/15 py-6 sm:border-l sm:pl-10 lg:pl-12\" data-kid=\"1-2-2-1-2\" data-name=\"company milestone operational year block\">\n                    <dt class=\"shrink-0 font-mono text-3xl font-semibold tracking-[-.05em] text-[var(--cargo-deep)] sm:text-4xl\" data-kid=\"1-2-2-1-2-1\" data-name=\"milestone year\">\n                        2015\n                    </dt>\n                    <dd class=\"max-w-[300px] text-sm leading-snug text-[var(--cargo-ink)]/70\" data-kid=\"1-2-2-1-2-2\" data-name=\"milestone description\">\n                        Inicio de prestación de servicios aeroportuarios en Maiquetía\n                    </dd>\n                </div>\n            </dl>\n        </section>\n        <section aria-labelledby=\"task-heading\" class=\"scroll-mt-24 bg-[var(--cargo-mist)] py-16 md:py-20\" data-kid=\"1-2-3\" data-name=\"capabilities section\" id=\"capacidades\">\n            <div class=\"mx-auto max-w-[1320px] px-6 lg:px-10\" data-kid=\"1-2-3-1\" data-name=\"capabilities section container\">\n                <div class=\"mb-8 flex flex-col justify-between gap-5 border-b border-[var(--cargo-deep)]/20 pb-6 md:flex-row md:items-end\" data-kid=\"1-2-3-1-1\" data-name=\"capabilities header container\">\n                    <div class=\"max-w-2xl\" data-kid=\"1-2-3-1-1-1\" data-name=\"capabilities headline block\">\n                        <h2 class=\"text-balance text-3xl font-semibold tracking-[-.04em] text-[var(--cargo-deep)] sm:text-4xl\" data-kid=\"1-2-3-1-1-1-1\" data-name=\"capabilities section title\" id=\"task-heading\">\n                            ¿Qué apoyo requiere su operación?\n                        </h2>\n                        <p class=\"mt-3 max-w-xl text-base leading-relaxed text-[var(--cargo-ink)]/75\" data-kid=\"1-2-3-1-1-1-2\" data-name=\"capabilities description\">\n                            Seleccione una necesidad para consultar el alcance, las tareas incluidas y los datos que conviene especificar al solicitar el servicio.\n                        </p>\n                    </div>\n                    <a class=\"inline-flex shrink-0 items-center gap-3 text-sm font-semibold text-[var(--cargo-deep)] underline decoration-[var(--cargo-emerald)]/70 underline-offset-4 transition-colors hover:text-[var(--cargo-emerald)]\" data-kid=\"1-2-3-1-1-2\" data-name=\"catalog link\" href=\"/es/servicios\">\n                        Abrir catálogo completo\n                        <span aria-hidden=\"true\" data-kid=\"1-2-3-1-1-2-1\" data-name=\"external link arrow icon\">\n                            ↗\n                        </span>\n                    </a>\n                </div>\n                <div class=\"grid items-start gap-9 lg:grid-cols-[minmax(0,1.12fr)_minmax(340px,.88fr)] lg:gap-14\" data-kid=\"1-2-3-1-2\" data-name=\"services grid\">\n                    <div class=\"divide-y divide-[var(--cargo-deep)]/15 border-y border-[var(--cargo-deep)]/15\" data-kid=\"1-2-3-1-2-1\" data-name=\"services list column\">\n                        <article class=\"py-6 sm:py-7\" data-kid=\"1-2-3-1-2-1-1\" data-name=\"ramp service item\">\n                            <div class=\"grid gap-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-start\" data-kid=\"1-2-3-1-2-1-1-1\" data-name=\"service content block\">\n                                <div data-kid=\"1-2-3-1-2-1-1-1-1\" data-name=\"service title\">\n                                    <h3 class=\"text-xl font-semibold tracking-[-.025em] text-[var(--cargo-deep)]\" data-kid=\"1-2-3-1-2-1-1-1-1-1\">\n                                        Plataforma y equipos GSE\n                                    </h3>\n                                    <p class=\"mt-2 max-w-2xl text-sm leading-relaxed text-[var(--cargo-ink)]/75\" data-kid=\"1-2-3-1-2-1-1-1-1-2\">\n                                        Asistencia a aeronaves de pasajeros y carga con equipos de apoyo en tierra: movimiento, energía, aire y manejo de equipaje o carga.\n                                    </p>\n                                    <p class=\"mt-3 text-xs leading-relaxed text-[var(--cargo-ink)]/60\" data-kid=\"1-2-3-1-2-1-1-1-1-3\">\n                                        Pushback y towbarless · GPU y ASU · contenedores y pallets ULD · cinta transportadora\n                                    </p>\n                                </div>\n                                <a class=\"inline-flex items-center gap-2 text-sm font-semibold text-[var(--cargo-deep)] underline decoration-[var(--cargo-emerald)] underline-offset-4 transition-colors hover:text-[var(--cargo-emerald)]\" data-kid=\"1-2-3-1-2-1-1-1-2\" data-name=\"service description\" href=\"/es/cotizacion?service=ramp-gse\">\n                                    Solicitar apoyo GSE\n                                    <span aria-hidden=\"true\" data-kid=\"1-2-3-1-2-1-1-1-2-1\">\n                                        ↗\n                                    </span>\n                                </a>\n                            </div>\n                        </article>\n                        <article class=\"py-6 sm:py-7\" data-kid=\"1-2-3-1-2-1-2\" data-name=\"aircraft care service item\">\n                            <div class=\"grid gap-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-start\" data-kid=\"1-2-3-1-2-1-2-1\" data-name=\"service content block\">\n                                <div data-kid=\"1-2-3-1-2-1-2-1-1\" data-name=\"service title\">\n                                    <h3 class=\"text-xl font-semibold tracking-[-.025em] text-[var(--cargo-deep)]\" data-kid=\"1-2-3-1-2-1-2-1-1-1\" data-name=\"service description\">\n                                        Cuidado de aeronaves\n                                    </h3>\n                                    <p class=\"mt-2 max-w-2xl text-sm leading-relaxed text-[var(--cargo-ink)]/75\" data-kid=\"1-2-3-1-2-1-2-1-1-2\">\n                                        Limpieza interior y exterior, desinfección y desinsectación de aeronaves.\n                                    </p>\n                                </div>\n                                <a class=\"inline-flex items-center gap-2 text-sm font-semibold text-[var(--cargo-deep)] underline decoration-[var(--cargo-emerald)] underline-offset-4 transition-colors hover:text-[var(--cargo-emerald)]\" data-kid=\"1-2-3-1-2-1-2-1-2\" data-name=\"service cta\" href=\"/es/cotizacion?service=aircraft-care\">\n                                    Consultar cuidado\n                                    <span aria-hidden=\"true\" data-kid=\"1-2-3-1-2-1-2-1-2-1\" data-name=\"external link arrow icon\">\n                                        ↗\n                                    </span>\n                                </a>\n                            </div>\n                        </article>\n                        <article class=\"py-6 sm:py-7\" data-kid=\"1-2-3-1-2-1-3\" data-name=\"obf operations service item\">\n                            <div class=\"grid gap-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-start\" data-kid=\"1-2-3-1-2-1-3-1\" data-name=\"service content block\">\n                                <div data-kid=\"1-2-3-1-2-1-3-1-1\" data-name=\"service title\">\n                                    <h3 class=\"text-xl font-semibold tracking-[-.025em] text-[var(--cargo-deep)]\" data-kid=\"1-2-3-1-2-1-3-1-1-1\" data-name=\"service description\">\n                                        OBF y operación\n                                    </h3>\n                                    <p class=\"mt-2 max-w-2xl text-sm leading-relaxed text-[var(--cargo-ink)]/75\" data-kid=\"1-2-3-1-2-1-3-1-1-2\">\n                                        Despacho y seguimiento de vuelo para operaciones 121/135, guía de estacionamiento y coordinación en rampa.\n                                    </p>\n                                </div>\n                                <a class=\"inline-flex items-center gap-2 text-sm font-semibold text-[var(--cargo-deep)] underline decoration-[var(--cargo-emerald)] underline-offset-4 transition-colors hover:text-[var(--cargo-emerald)]\" data-kid=\"1-2-3-1-2-1-3-1-2\" data-name=\"service cta\" href=\"/es/cotizacion?service=fbo-operations\">\n                                    Consultar OBF\n                                    <span aria-hidden=\"true\" data-kid=\"1-2-3-1-2-1-3-1-2-1\" data-name=\"external link arrow icon\">\n                                        ↗\n                                    </span>\n                                </a>\n                            </div>\n                        </article>\n                        <article class=\"py-6 sm:py-7\" data-kid=\"1-2-3-1-2-1-4\" data-name=\"passenger service item\">\n                            <div class=\"grid gap-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-start\" data-kid=\"1-2-3-1-2-1-4-1\" data-name=\"service content block\">\n                                <div data-kid=\"1-2-3-1-2-1-4-1-1\" data-name=\"service title\">\n                                    <h3 class=\"text-xl font-semibold tracking-[-.025em] text-[var(--cargo-deep)]\" data-kid=\"1-2-3-1-2-1-4-1-1-1\" data-name=\"service description\">\n                                        Pasajeros y servicios especiales\n                                    </h3>\n                                    <p class=\"mt-2 max-w-2xl text-sm leading-relaxed text-[var(--cargo-ink)]/75\" data-kid=\"1-2-3-1-2-1-4-1-1-2\">\n                                        Tráfico de pasajeros 121/135, asistencia PRM y a menores sin acompañante; coordinación de requerimientos complementarios para la operación.\n                                    </p>\n                                </div>\n                                <a class=\"inline-flex items-center gap-2 text-sm font-semibold text-[var(--cargo-deep)] underline decoration-[var(--cargo-emerald)] underline-offset-4 transition-colors hover:text-[var(--cargo-emerald)]\" data-kid=\"1-2-3-1-2-1-4-1-2\" data-name=\"service cta\" href=\"/es/cotizacion?service=passenger-services\">\n                                    Consultar asistencia\n                                    <span aria-hidden=\"true\" data-kid=\"1-2-3-1-2-1-4-1-2-1\" data-name=\"external link arrow icon\">\n                                        ↗\n                                    </span>\n                                </a>\n                            </div>\n                        </article>\n                        <article class=\"py-6 sm:py-7\" data-kid=\"1-2-3-1-2-1-5\" data-name=\"maintenance service item\">\n                            <div class=\"grid gap-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-start\" data-kid=\"1-2-3-1-2-1-5-1\" data-name=\"service content block\">\n                                <div data-kid=\"1-2-3-1-2-1-5-1-1\" data-name=\"service title\">\n                                    <h3 class=\"text-xl font-semibold tracking-[-.025em] text-[var(--cargo-deep)]\" data-kid=\"1-2-3-1-2-1-5-1-1-1\" data-name=\"service description\">\n                                        Mantenimiento GSE\n                                    </h3>\n                                    <p class=\"mt-2 max-w-2xl text-sm leading-relaxed text-[var(--cargo-ink)]/75\" data-kid=\"1-2-3-1-2-1-5-1-1-2\">\n                                        Soporte preventivo y correctivo, reparación de componentes y servicio en estación.\n                                    </p>\n                                </div>\n                                <a class=\"inline-flex items-center gap-2 text-sm font-semibold text-[var(--cargo-deep)] underline decoration-[var(--cargo-emerald)] underline-offset-4 transition-colors hover:text-[var(--cargo-emerald)]\" data-kid=\"1-2-3-1-2-1-5-1-2\" data-name=\"service cta\" href=\"/es/cotizacion?service=gse-maintenance\">\n                                    Consultar mantenimiento\n                                    <span aria-hidden=\"true\" data-kid=\"1-2-3-1-2-1-5-1-2-1\" data-name=\"external link arrow icon\">\n                                        ↗\n                                    </span>\n                                </a>\n                            </div>\n                        </article>\n                    </div>\n                    <aside class=\"border-l-2 border-[var(--cargo-emerald)] pl-6 sm:pl-8\" data-kid=\"1-2-3-1-2-2\" data-name=\"special services aside\">\n                        <h3 class=\"max-w-md text-xl font-semibold leading-snug tracking-[-.025em] text-[var(--cargo-deep)]\" data-kid=\"1-2-3-1-2-2-1\" data-name=\"aside headline\">\n                            Servicios especiales: coordinación según el requerimiento de cada operación.\n                        </h3>\n                        <p class=\"mt-4 text-sm leading-relaxed text-[var(--cargo-ink)]/75\" data-kid=\"1-2-3-1-2-2-2\" data-name=\"aside description\">\n                            El folleto incluye atención de animales de servicio, VIP y fast track; coordinación de catering y salón VIP; permisos de aterrizaje y sobrevuelos; apoyo a tripulaciones, aeropuertos alternos y abastecimiento de combustible; servicios GSE / ASU / ACU y traslado de aeronaves.\n                        </p>\n                        <a class=\"mt-5 inline-flex items-center gap-2 text-sm font-semibold text-[var(--cargo-deep)] underline decoration-[var(--cargo-emerald)] underline-offset-4 hover:text-[var(--cargo-emerald)]\" data-kid=\"1-2-3-1-2-2-3\" data-name=\"aside link\" href=\"/es/servicios#passenger-services\">\n                            Ver alcance de servicios especiales\n                            <span aria-hidden=\"true\" data-kid=\"1-2-3-1-2-2-3-1\" data-name=\"external link arrow icon\">\n                                ↗\n                            </span>\n                        </a>\n                    </aside>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"equipment-heading\" class=\"scroll-mt-24 bg-white py-16 md:py-20\" data-kid=\"1-2-4\" data-name=\"equipment functions section\" id=\"equipos\">\n            <div class=\"mx-auto max-w-[1320px] px-6 lg:px-10\" data-kid=\"1-2-4-1\" data-name=\"equipment container\">\n                <div class=\"grid gap-6 border-b border-[var(--cargo-deep)]/20 pb-7 md:grid-cols-[.75fr_1.25fr] md:items-end\" data-kid=\"1-2-4-1-1\" data-name=\"equipment header block\">\n                    <h2 class=\"max-w-md text-3xl font-semibold tracking-[-.04em] text-[var(--cargo-deep)] sm:text-4xl\" data-kid=\"1-2-4-1-1-1\" data-name=\"section title\" id=\"equipment-heading\">\n                        Funciones de los equipos de plataforma\n                    </h2>\n                    <p class=\"max-w-2xl text-base leading-relaxed text-[var(--cargo-ink)]/70\" data-kid=\"1-2-4-1-1-2\" data-name=\"section description\">\n                        Seis equipos descritos en la guía operacional. Cada función explica qué aporta al movimiento seguro de una aeronave en rampa.\n                    </p>\n                </div>\n                <dl class=\"mt-2 divide-y divide-[var(--cargo-deep)]/15\" data-kid=\"1-2-4-1-2\" data-name=\"equipment definition list\">\n                    <div class=\"grid gap-2 py-5 sm:grid-cols-[minmax(220px,.44fr)_1fr] sm:gap-8\" data-kid=\"1-2-4-1-2-1\" data-name=\"equipment definition item\">\n                        <dt class=\"font-semibold text-[var(--cargo-deep)]\" data-kid=\"1-2-4-1-2-1-1\" data-name=\"equipment name\">\n                            Carrucha · carro de equipaje\n                        </dt>\n                        <dd class=\"text-sm leading-relaxed text-[var(--cargo-ink)]/75\" data-kid=\"1-2-4-1-2-1-2\" data-name=\"equipment description\">\n                            Equipo sin motor para transportar equipaje, correo o carga suelta; varias carruchas se unen en un tren remolcado entre la terminal y la aeronave.\n                        </dd>\n                    </div>\n                    <div class=\"grid gap-2 py-5 sm:grid-cols-[minmax(220px,.44fr)_1fr] sm:gap-8\" data-kid=\"1-2-4-1-2-2\" data-name=\"equipment definition item\">\n                        <dt class=\"font-semibold text-[var(--cargo-deep)]\" data-kid=\"1-2-4-1-2-2-1\" data-name=\"equipment name\">\n                            Tractor remolcador de equipaje\n                        </dt>\n                        <dd class=\"text-sm leading-relaxed text-[var(--cargo-ink)]/75\" data-kid=\"1-2-4-1-2-2-2\" data-name=\"equipment description\">\n                            Vehículo de perfil bajo y gran tracción utilizado para remolcar carruchas y otros equipos de apoyo hasta la aeronave.\n                        </dd>\n                    </div>\n                    <div class=\"grid gap-2 py-5 sm:grid-cols-[minmax(220px,.44fr)_1fr] sm:gap-8\" data-kid=\"1-2-4-1-2-3\" data-name=\"equipment definition item\">\n                        <dt class=\"font-semibold text-[var(--cargo-deep)]\" data-kid=\"1-2-4-1-2-3-1\" data-name=\"equipment name\">\n                            Carro de aguas residuales\n                        </dt>\n                        <dd class=\"text-sm leading-relaxed text-[var(--cargo-ink)]/75\" data-kid=\"1-2-4-1-2-3-2\" data-name=\"equipment description\">\n                            Vacía y drena los tanques del sistema sanitario de la aeronave; luego recarga con agua limpia y líquido desinfectante/desodorizante.\n                        </dd>\n                    </div>\n                    <div class=\"grid gap-2 py-5 sm:grid-cols-[minmax(220px,.44fr)_1fr] sm:gap-8\" data-kid=\"1-2-4-1-2-4\" data-name=\"equipment definition item\">\n                        <dt class=\"font-semibold text-[var(--cargo-deep)]\" data-kid=\"1-2-4-1-2-4-1\" data-name=\"equipment name\">\n                            Cinta transportadora de equipaje\n                        </dt>\n                        <dd class=\"text-sm leading-relaxed text-[var(--cargo-ink)]/75\" data-kid=\"1-2-4-1-2-4-2\" data-name=\"equipment description\">\n                            Eleva la cinta hasta la puerta de la bodega para facilitar la carga y descarga manual de maletas y carga a granel.\n                        </dd>\n                    </div>\n                    <div class=\"grid gap-2 py-5 sm:grid-cols-[minmax(220px,.44fr)_1fr] sm:gap-8\" data-kid=\"1-2-4-1-2-5\" data-name=\"equipment definition item\">\n                        <dt class=\"font-semibold text-[var(--cargo-deep)]\" data-kid=\"1-2-4-1-2-5-1\" data-name=\"equipment name\">\n                            GPU · Ground Power Unit\n                        </dt>\n                        <dd class=\"text-sm leading-relaxed text-[var(--cargo-ink)]/75\" data-kid=\"1-2-4-1-2-5-2\" data-name=\"equipment description\">\n                            Proporciona energía eléctrica a la aeronave estacionada, con los motores apagados, sin consumir su propio combustible.\n                        </dd>\n                    </div>\n                    <div class=\"grid gap-2 py-5 sm:grid-cols-[minmax(220px,.44fr)_1fr] sm:gap-8\" data-kid=\"1-2-4-1-2-6\" data-name=\"equipment definition item\">\n                        <dt class=\"font-semibold text-[var(--cargo-deep)]\" data-kid=\"1-2-4-1-2-6-1\" data-name=\"equipment name\">\n                            ASU · Air Start Unit\n                        </dt>\n                        <dd class=\"text-sm leading-relaxed text-[var(--cargo-ink)]/75\" data-kid=\"1-2-4-1-2-6-2\" data-name=\"equipment description\">\n                            Suministra aire comprimido a alta presión para asistir el arranque de los motores, especialmente si el APU está apagado o inoperativo.\n                        </dd>\n                    </div>\n                </dl>\n                <a class=\"mt-4 inline-flex items-center gap-2 text-sm font-semibold text-[var(--cargo-deep)] underline decoration-[var(--cargo-emerald)] underline-offset-4 hover:text-[var(--cargo-emerald)]\" data-kid=\"1-2-4-1-3\" data-name=\"equipment cta\" href=\"/es/servicios#ramp-gse\">\n                    Consultar alcance de plataforma y GSE\n                    <span aria-hidden=\"true\" data-kid=\"1-2-4-1-3-1\" data-name=\"external link arrow icon\">\n                        ↗\n                    </span>\n                </a>\n            </div>\n        </section>\n        <section aria-labelledby=\"about-heading\" class=\"scroll-mt-24 bg-[var(--cargo-deep)] py-16 text-white md:py-20\" data-kid=\"1-2-5\" data-name=\"company info section\" id=\"empresa\">\n            <div class=\"mx-auto grid max-w-[1320px] gap-12 px-6 lg:grid-cols-[.96fr_1.04fr] lg:gap-16 lg:px-10\" data-kid=\"1-2-5-1\" data-name=\"info container\">\n                <div data-kid=\"1-2-5-1-1\" data-name=\"info main block\">\n                    <h2 class=\"max-w-xl text-3xl font-semibold tracking-[-.04em] sm:text-4xl\" data-kid=\"1-2-5-1-1-1\" data-name=\"section title\" id=\"about-heading\">\n                        Servicios Especializados JMC\n                    </h2>\n                    <p class=\"mt-5 max-w-xl text-base leading-relaxed text-white/80\" data-kid=\"1-2-5-1-1-2\" data-name=\"info body paragraph\">\n                        Empresa venezolana dedicada a servicios especializados aeroportuarios y asistencia en plataforma. Atiende aeronaves, pasajeros, equipaje y carga con personal capacitado y equipos de apoyo terrestre.\n                    </p>\n                    <p class=\"mt-4 max-w-xl text-sm leading-relaxed text-white/65\" data-kid=\"1-2-5-1-1-3\" data-name=\"info history paragraph\">\n                        Constituida en 2012; presta servicios en el Aeropuerto Internacional Simón Bolívar de Maiquetía desde 2015. La documentación describe a un grupo de profesionales con más de 30 años de experiencia en el sector aeronáutico venezolano.\n                    </p>\n                    <div class=\"mt-8 grid gap-6 border-t border-white/20 pt-6 sm:grid-cols-2\" data-kid=\"1-2-5-1-1-4\" data-name=\"mission vision container\">\n                        <div data-kid=\"1-2-5-1-1-4-1\" data-name=\"mission block\">\n                            <h3 class=\"font-mono text-xs uppercase tracking-[.12em] text-[var(--cargo-light)]\" data-kid=\"1-2-5-1-1-4-1-1\" data-name=\"mission title\">\n                                Misión\n                            </h3>\n                            <p class=\"mt-3 text-sm leading-relaxed text-white/80\" data-kid=\"1-2-5-1-1-4-1-2\" data-name=\"mission description\">\n                                Aportar una alternativa hecha a la medida, con personal especializado, procesos innovadores y calidad en los servicios en tierra requeridos por las aerolíneas.\n                            </p>\n                        </div>\n                        <div data-kid=\"1-2-5-1-1-4-2\" data-name=\"vision block\">\n                            <h3 class=\"font-mono text-xs uppercase tracking-[.12em] text-[var(--cargo-light)]\" data-kid=\"1-2-5-1-1-4-2-1\" data-name=\"vision title\">\n                                Visión\n                            </h3>\n                            <p class=\"mt-3 text-sm leading-relaxed text-white/80\" data-kid=\"1-2-5-1-1-4-2-2\" data-name=\"vision description\">\n                                Consolidar el liderazgo en servicios especializados aeroportuarios en Venezuela mediante excelencia, calidad, innovación, adaptación y capital humano calificado.\n                            </p>\n                        </div>\n                    </div>\n                    <p class=\"mt-7 border-t border-white/15 pt-5 text-xs leading-relaxed text-white/60\" data-kid=\"1-2-5-1-1-5\" data-name=\"values block\">\n                        <span class=\"font-semibold text-white/80\" data-kid=\"1-2-5-1-1-5-1\" data-name=\"values label\">\n                            Valores de la organización:\n                        </span>\n                        respeto, tolerancia, cortesía, compromiso, justicia, responsabilidad, honestidad, innovación, superación, calidad, trabajo en equipo y excelencia.\n                    </p>\n                </div>\n                <div class=\"flex flex-col justify-center border-t border-white/20 pt-8 lg:border-l lg:border-t-0 lg:pl-12 lg:pt-0\" data-kid=\"1-2-5-1-2\" data-name=\"certification block\">\n                    <div class=\"flex flex-wrap gap-x-7 gap-y-3 font-mono text-sm text-[var(--cargo-light)]\" data-kid=\"1-2-5-1-2-1\" data-name=\"regulations tags list\">\n                        <span data-kid=\"1-2-5-1-2-1-1\" data-name=\"inac tag\">\n                            INAC\n                        </span>\n                        <span data-kid=\"1-2-5-1-2-1-2\" data-name=\"rav 111 tag\">\n                            RAV 111\n                        </span>\n                        <span data-kid=\"1-2-5-1-2-1-3\" data-name=\"cesea tag\">\n                            CESEA-021*\n                        </span>\n                    </div>\n                    <h3 class=\"mt-7 max-w-lg text-2xl font-semibold tracking-[-.025em]\" data-kid=\"1-2-5-1-2-2\" data-name=\"certification title\">\n                        Autorización y alcance documentados\n                    </h3>\n                    <p class=\"mt-3 max-w-lg text-sm leading-relaxed text-white/75\" data-kid=\"1-2-5-1-2-3\" data-name=\"certification description\">\n                        La fuente organizacional vincula los servicios autorizados con la Regulación Aeronáutica Venezolana 111 y el INAC. Consulte el documento de certificación; se mantiene su grafía oficial hasta confirmar la discrepancia entre las copias impresas.\n                    </p>\n                    <figure class=\"mt-7 flex items-center gap-5 border border-white/15 bg-white/5 p-4 sm:gap-7 sm:p-5\" data-kid=\"1-2-5-1-2-4\" data-name=\"certification evidence container\">\n                        <img alt=\"Documento de certificación de Servicios Especializados JMC\" class=\"h-24 w-32 shrink-0 border border-white/15 bg-white object-cover object-top sm:h-32 sm:w-44\" data-kid=\"1-2-5-1-2-4-1\" data-name=\"certification certificate image\" decoding=\"async\" height=\"600\" loading=\"lazy\" src=\"/api/local/images/public/assets/images/cesea-cert.webp\" width=\"800\"/>\n                        <figcaption data-kid=\"1-2-5-1-2-4-2\" data-name=\"certification caption block\">\n                            <p class=\"font-mono text-[11px] uppercase tracking-[.1em] text-[var(--cargo-light)]\" data-kid=\"1-2-5-1-2-4-2-1\" data-name=\"caption label\">\n                                Evidencia documental\n                            </p>\n                            <p class=\"mt-2 text-sm leading-relaxed text-white/80\" data-kid=\"1-2-5-1-2-4-2-2\" data-name=\"caption description\">\n                                RAV 111 · Instituto Nacional de Aeronáutica Civil\n                            </p>\n                            <a class=\"mt-3 inline-flex items-center gap-2 text-sm font-semibold text-white underline decoration-[var(--cargo-emerald)] underline-offset-4 hover:text-[var(--cargo-light)]\" data-kid=\"1-2-5-1-2-4-2-3\" data-name=\"certification link\" href=\"/assets/images/cesea-cert.webp\">\n                                Consultar certificado\n                                <span aria-hidden=\"true\" data-kid=\"1-2-5-1-2-4-2-3-1\" data-name=\"external link arrow icon\">\n                                    ↗\n                                </span>\n                            </a>\n                        </figcaption>\n                    </figure>\n                    <p class=\"mt-4 max-w-lg text-xs leading-relaxed text-white/45\" data-kid=\"1-2-5-1-2-5\" data-name=\"disclaimer note\">\n                        * La brochure muestra tanto “CESA 021” como “CESEA 021”. Confirmar la grafía antes de homogeneizar el número en todas las páginas.\n                    </p>\n                </div>\n            </div>\n        </section>\n        <section aria-label=\"Contacto y solicitud\" class=\"bg-[var(--cargo-light)] py-12 sm:py-14\" data-kid=\"1-2-6\" data-name=\"contact section\">\n            <div class=\"mx-auto flex max-w-[1320px] flex-col justify-between gap-7 px-6 md:flex-row md:items-center lg:px-10\" data-kid=\"1-2-6-1\" data-name=\"contact container\">\n                <div data-kid=\"1-2-6-1-1\" data-name=\"contact header block\">\n                    <h2 class=\"max-w-xl text-2xl font-semibold tracking-[-.035em] text-[var(--cargo-deep)] sm:text-3xl\" data-kid=\"1-2-6-1-1-1\" data-name=\"section title\">\n                        Indique el servicio, la aeronave y el contexto operativo.\n                    </h2>\n                    <p class=\"mt-3 text-sm text-[var(--cargo-deep)]/75\" data-kid=\"1-2-6-1-1-2\" data-name=\"section description\">\n                        JMC recibe solicitudes para orientar el servicio especializado requerido.\n                    </p>\n                </div>\n                <div class=\"flex flex-wrap gap-3\" data-kid=\"1-2-6-1-2\" data-name=\"contact cta group\">\n                    <a class=\"inline-flex items-center gap-3 bg-[var(--cargo-deep)] px-5 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-[var(--cargo-ink)]\" data-kid=\"1-2-6-1-2-1\" data-name=\"primary cta button\" href=\"/es/cotizacion\">\n                        Enviar solicitud\n                        <span aria-hidden=\"true\" data-kid=\"1-2-6-1-2-1-1\" data-name=\"external link arrow icon\">\n                            ↗\n                        </span>\n                    </a>\n                    <a class=\"inline-flex items-center border border-[var(--cargo-deep)]/40 px-5 py-3.5 text-sm font-semibold text-[var(--cargo-deep)] transition-colors hover:bg-white/50\" data-kid=\"1-2-6-1-2-2\" data-name=\"secondary cta button\" href=\"/es/contacto\">\n                        Ver contacto\n                    </a>\n                </div>\n            </div>\n        </section>\n    </main>\n    <footer class=\"bg-[var(--cargo-ink)] text-white\" data-kid=\"1-3\" data-name=\"footer section\">\n        <div class=\"mx-auto grid max-w-[1320px] gap-8 px-6 py-10 sm:grid-cols-[1fr_auto] sm:items-end lg:px-10\" data-kid=\"1-3-1\" data-name=\"footer top container\">\n            <div data-kid=\"1-3-1-1\" data-name=\"company info footer column\">\n                <p class=\"text-sm font-semibold\" data-kid=\"1-3-1-1-1\" data-name=\"company name footer\">\n                    Servicios Especializados JMC, C.A.\n                </p>\n                <p class=\"mt-2 max-w-lg text-sm leading-relaxed text-white/65\" data-kid=\"1-3-1-1-2\" data-name=\"footer description\">\n                    Servicios aeroportuarios en Maiquetía · INAC · RAV 111\n                </p>\n                <div class=\"mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm text-white/75\" data-kid=\"1-3-1-1-3\" data-name=\"contact link group\">\n                    <a class=\"transition-colors hover:text-white\" data-kid=\"1-3-1-1-3-1\" data-name=\"email link\" href=\"mailto:customer.service@jmchandling.com\">\n                        customer.service@jmchandling.com\n                    </a>\n                    <a class=\"transition-colors hover:text-white\" data-kid=\"1-3-1-1-3-2\" data-name=\"phone link 1\" href=\"tel:+584141180806\">\n                        +58 414 118 0806\n                    </a>\n                    <a class=\"transition-colors hover:text-white\" data-kid=\"1-3-1-1-3-3\" data-name=\"phone link 2\" href=\"tel:+19544704217\">\n                        +1 954 470 4217\n                    </a>\n                </div>\n            </div>\n            <div class=\"flex flex-wrap items-center gap-5 text-sm\" data-kid=\"1-3-1-2\" data-name=\"footer navigation links\">\n                <a class=\"text-white/75 underline decoration-white/25 underline-offset-4 hover:text-white\" data-kid=\"1-3-1-2-1\" data-name=\"capabilities link\" href=\"/es/servicios\">\n                    Capacidades\n                </a>\n                <a class=\"text-white/75 underline decoration-white/25 underline-offset-4 hover:text-white\" data-kid=\"1-3-1-2-2\" data-name=\"contact link\" href=\"/es/contacto\">\n                    Contacto\n                </a>\n                <a class=\"text-[var(--cargo-light)] underline decoration-[var(--cargo-light)]/40 underline-offset-4\" data-kid=\"1-3-1-2-3\" data-name=\"language link english\" href=\"/en/\" lang=\"en\">\n                    English\n                </a>\n            </div>\n        </div>\n        <div class=\"border-t border-white/10\" data-kid=\"1-3-2\" data-name=\"footer bottom container\">\n            <div class=\"mx-auto flex max-w-[1320px] flex-col gap-2 px-6 py-4 text-xs text-white/40 sm:flex-row sm:justify-between lg:px-10\" data-kid=\"1-3-2-1\" data-name=\"copyright container\">\n                <p data-kid=\"1-3-2-1-1\" data-name=\"copyright notice\">\n                    © 2026 Servicios Especializados JMC, C.A.\n                </p>\n                <p data-kid=\"1-3-2-1-2\" data-name=\"location notice\">\n                    Maiquetía, Venezuela\n                </p>\n            </div>\n        </div>\n    </footer>\n</div>\n",
