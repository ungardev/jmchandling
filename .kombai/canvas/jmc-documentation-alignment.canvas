    "var_20f40b170786": {
      "type": "variant",
      "label": "Propuesta 1 · Evidencia | Portada",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 7700,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap');\n  .jmc-page { --color-cargo-deep: #0F3E51; --color-cargo-light: #A0DDF5; --color-cargo-emerald: #5BA8C7; --color-cargo-ink: #0A1F2B; --color-cargo-mist: #F5F8FA; --color-cargo-white: #FFFFFF; font-family: 'Inter', sans-serif; }\n  .jmc-mono { font-family: 'JetBrains Mono', monospace; }\n</style>\n<main class=\"jmc-page m-0 min-h-screen bg-[var(--color-cargo-mist)] text-[var(--color-cargo-ink)]\" data-kid=\"1\" data-name=\"page layout container\">\n    <section class=\"bg-[var(--color-cargo-deep)] text-[var(--color-cargo-white)]\" data-kid=\"1-1\" data-name=\"hero header section\" id=\"inicio\">\n        <header class=\"mx-auto flex max-w-[1320px] items-center justify-between gap-8 px-6 py-5 lg:px-12\" data-kid=\"1-1-1\" data-name=\"navigation header container\">\n            <a aria-label=\"JMC Servicios Especializados, inicio\" class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"logo brand link\" href=\"#inicio\">\n                <img alt=\"\" aria-hidden=\"true\" class=\"h-12 w-14 object-contain\" data-kid=\"1-1-1-1-1\" data-name=\"isotipo logo icon\" decoding=\"async\" height=\"96\" loading=\"eager\" src=\"/api/local/images/public/assets/brand/isotipo-logo.webp\" width=\"114\"/>\n                <img alt=\"JMC Servicios Especializados\" class=\"h-9 w-32 object-contain object-left\" data-kid=\"1-1-1-1-2\" data-name=\"brand name logo\" decoding=\"async\" height=\"111\" loading=\"eager\" src=\"/api/local/images/public/assets/brand/fuente-logo.webp\" width=\"320\"/>\n            </a>\n            <nav aria-label=\"Navegación principal\" class=\"flex items-center gap-8 text-sm font-medium\" data-kid=\"1-1-1-2\" data-name=\"main navigation menu\">\n                <a class=\"hidden text-[var(--color-cargo-white)]/80 hover:text-[var(--color-cargo-white)] sm:inline\" data-kid=\"1-1-1-2-1\" data-name=\"inicio navigation link\" href=\"#inicio\">\n                    Inicio\n                </a>\n                <a class=\"text-[var(--color-cargo-white)] hover:text-[var(--color-cargo-light)]\" data-kid=\"1-1-1-2-2\" data-name=\"servicios navigation link\" href=\"/es/servicios\">\n                    Servicios\n                    <span aria-hidden=\"true\" data-kid=\"1-1-1-2-2-1\" data-name=\"arrow icon\">\n                        ↗\n                    </span>\n                </a>\n                <a class=\"hidden text-[var(--color-cargo-white)]/80 hover:text-[var(--color-cargo-white)] sm:inline\" data-kid=\"1-1-1-2-3\" data-name=\"jmc navigation link\" href=\"#jmc\">\n                    JMC\n                </a>\n                <a class=\"hidden text-[var(--color-cargo-white)]/80 hover:text-[var(--color-cargo-white)] md:inline\" data-kid=\"1-1-1-2-4\" data-name=\"contacto navigation link\" href=\"#contacto\">\n                    Contacto\n                </a>\n                <a class=\"jmc-mono border-l border-[var(--color-cargo-light)]/30 pl-5 text-xs tracking-wide text-[var(--color-cargo-light)] hover:text-[var(--color-cargo-white)]\" data-kid=\"1-1-1-2-5\" data-name=\"language selector link\" href=\"/en/\" lang=\"en\">\n                    ES\n                    <span class=\"text-[var(--color-cargo-white)]/40\" data-kid=\"1-1-1-2-5-1\" data-name=\"language separator slash\">\n                        /\n                    </span>\n                    EN\n                </a>\n            </nav>\n        </header>\n        <div class=\"mx-auto grid max-w-[1320px] items-center gap-10 px-6 pb-16 pt-10 md:pb-20 lg:grid-cols-[0.9fr_1.1fr] lg:gap-14 lg:px-12 lg:pb-24 lg:pt-14\" data-kid=\"1-1-2\" data-name=\"hero section content\">\n            <div class=\"max-w-[610px]\" data-kid=\"1-1-2-1\" data-name=\"hero text container\">\n                <h1 class=\"text-balance text-5xl font-semibold leading-[1.03] tracking-[-0.045em] text-[var(--color-cargo-white)] sm:text-6xl xl:text-[68px]\" data-kid=\"1-1-2-1-1\" data-name=\"hero headline text\">\n                    Servicios aeroportuarios para operar en tierra en Maiquetía.\n                </h1>\n                <p class=\"mt-7 max-w-[560px] text-lg leading-relaxed text-[var(--color-cargo-white)]/78\" data-kid=\"1-1-2-1-2\" data-name=\"hero subheadline description\">\n                    Equipos de apoyo terrestre, operación de base fija y mantenimiento para explotadores aéreos.\n                </p>\n                <a class=\"mt-9 inline-flex items-center gap-5 border-b border-[var(--color-cargo-light)] pb-3 text-base font-semibold text-[var(--color-cargo-light)] hover:text-[var(--color-cargo-white)]\" data-kid=\"1-1-2-1-3\" data-name=\"hero call-to-action link\" href=\"/es/servicios\">\n                    Revisar el alcance de servicios\n                    <span aria-hidden=\"true\" data-kid=\"1-1-2-1-3-1\" data-name=\"arrow icon\">\n                        ↗\n                    </span>\n                </a>\n            </div>\n            <figure class=\"relative m-0 overflow-hidden bg-[var(--color-cargo-ink)]\" data-kid=\"1-1-2-2\" data-name=\"hero visual figure\">\n                <img alt=\"Equipo de apoyo terrestre de JMC y unidades GSE en plataforma.\" class=\"aspect-[1.22/1] w-full object-cover md:aspect-[1.38/1] lg:aspect-[1.1/1]\" data-kid=\"1-1-2-2-1\" data-name=\"gse fleet image\" decoding=\"async\" height=\"720\" loading=\"eager\" src=\"/api/local/images/public/assets/images/gse-fleet.webp\" width=\"1280\"/>\n                <figcaption class=\"absolute inset-x-0 bottom-0 flex items-center justify-between gap-5 bg-[var(--color-cargo-deep)]/90 px-5 py-4 text-xs text-[var(--color-cargo-white)] sm:px-7\" data-kid=\"1-1-2-2-2\" data-name=\"hero image caption container\">\n                    <span class=\"jmc-mono uppercase tracking-[0.12em] text-[var(--color-cargo-light)]\" data-kid=\"1-1-2-2-2-1\" data-name=\"location text\">\n                        Aeropuerto Internacional Simón Bolívar\n                    </span>\n                    <span class=\"shrink-0 font-semibold\" data-kid=\"1-1-2-2-2-2\" data-name=\"airport code text\">\n                        Maiquetía · CCS\n                    </span>\n                </figcaption>\n            </figure>\n        </div>\n        <div class=\"border-t border-[var(--color-cargo-light)]/20\" data-kid=\"1-1-3\" data-name=\"stats banner container\">\n            <div class=\"mx-auto grid max-w-[1320px] gap-0 px-6 sm:grid-cols-2 lg:grid-cols-3 lg:px-12\" data-kid=\"1-1-3-1\" data-name=\"stats grid container\">\n                <div class=\"flex min-h-[104px] items-center gap-5 border-b border-[var(--color-cargo-light)]/20 py-6 sm:border-r sm:pr-8 lg:border-b-0\" data-kid=\"1-1-3-1-1\" data-name=\"founding year stat container\">\n                    <span class=\"jmc-mono text-3xl font-medium tracking-[-0.06em] text-[var(--color-cargo-white)]\" data-kid=\"1-1-3-1-1-1\" data-name=\"founding year label\">\n                        2012\n                    </span>\n                    <span class=\"max-w-[145px] text-sm leading-snug text-[var(--color-cargo-white)]/70\" data-kid=\"1-1-3-1-1-2\" data-name=\"founding year description\">\n                        Año de constitución de la empresa\n                    </span>\n                </div>\n                <div class=\"flex min-h-[104px] items-center gap-5 border-b border-[var(--color-cargo-light)]/20 py-6 sm:pl-8 lg:border-b-0 lg:border-r lg:pl-10\" data-kid=\"1-1-3-1-2\" data-name=\"services start stat container\">\n                    <span class=\"jmc-mono text-3xl font-medium tracking-[-0.06em] text-[var(--color-cargo-white)]\" data-kid=\"1-1-3-1-2-1\" data-name=\"services start year label\">\n                        2015\n                    </span>\n                    <span class=\"max-w-[180px] text-sm leading-snug text-[var(--color-cargo-white)]/70\" data-kid=\"1-1-3-1-2-2\" data-name=\"services start description\">\n                        Inicio de servicios en Maiquetía\n                    </span>\n                </div>\n                <div class=\"flex min-h-[104px] items-center gap-5 py-6 sm:col-span-2 lg:col-span-1 lg:pl-10\" data-kid=\"1-1-3-1-3\" data-name=\"airport station stat container\">\n                    <span class=\"jmc-mono text-sm tracking-[0.1em] text-[var(--color-cargo-light)]\" data-kid=\"1-1-3-1-3-1\" data-name=\"airport code label\">\n                        CCS\n                    </span>\n                    <span class=\"text-sm leading-snug text-[var(--color-cargo-white)]/70\" data-kid=\"1-1-3-1-3-2\" data-name=\"airport location description\">\n                        Estación: Maiquetía, Venezuela\n                    </span>\n                </div>\n            </div>\n        </div>\n    </section>\n    <section class=\"bg-[var(--color-cargo-white)] px-6 py-20 md:py-28 lg:px-12\" data-kid=\"1-2\" data-name=\"services overview section\" id=\"servicios\">\n        <div class=\"mx-auto max-w-[1320px]\" data-kid=\"1-2-1\" data-name=\"services content container\">\n            <div class=\"grid gap-7 border-b border-[var(--color-cargo-deep)]/20 pb-10 lg:grid-cols-[0.7fr_1.3fr] lg:items-end\" data-kid=\"1-2-1-1\" data-name=\"services header\">\n                <h2 class=\"max-w-[390px] text-4xl font-semibold leading-tight tracking-[-0.04em] text-[var(--color-cargo-deep)] sm:text-5xl\" data-kid=\"1-2-1-1-1\" data-name=\"services section headline\">\n                    Alcance de servicios\n                </h2>\n                <p class=\"max-w-[700px] text-base leading-relaxed text-[var(--color-cargo-ink)]/75\" data-kid=\"1-2-1-1-2\" data-name=\"services section subheadline\">\n                    Atención a aeronaves, pasajeros, equipaje y carga, con servicios agrupados por su ámbito operativo.\n                </p>\n            </div>\n            <div class=\"divide-y divide-[var(--color-cargo-deep)]/15\" data-kid=\"1-2-1-2\" data-name=\"services list container\">\n                <article class=\"grid gap-5 py-8 lg:grid-cols-[0.7fr_1.3fr] lg:gap-12 lg:py-10\" data-kid=\"1-2-1-2-1\" data-name=\"ground equipment article\">\n                    <h3 class=\"max-w-[420px] text-2xl font-semibold leading-snug tracking-[-0.03em] text-[var(--color-cargo-deep)]\" data-kid=\"1-2-1-2-1-1\" data-name=\"ground equipment title\">\n                        Equipos de apoyo terrestre en plataforma\n                    </h3>\n                    <div class=\"max-w-[750px]\" data-kid=\"1-2-1-2-1-2\" data-name=\"ground equipment details\">\n                        <p class=\"text-base leading-relaxed text-[var(--color-cargo-ink)]/80\" data-kid=\"1-2-1-2-1-2-1\" data-name=\"ground equipment description\">\n                            Atención de aeronaves de pasajeros y carga con equipos GSE. El documento organizacional consigna las secciones 1–8 habilitadas por INAC.\n                        </p>\n                        <ul class=\"mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm leading-relaxed text-[var(--color-cargo-ink)]/70\" data-kid=\"1-2-1-2-1-2-2\" data-name=\"ground equipment list\">\n                            <li data-kid=\"1-2-1-2-1-2-2-1\">\n                                Limpieza interior y exterior\n                            </li>\n                            <li data-kid=\"1-2-1-2-1-2-2-2\">\n                                Desinfección y desinsectación\n                            </li>\n                            <li data-kid=\"1-2-1-2-1-2-2-3\">\n                                Apoyo a aeronaves de pasajeros y carga\n                            </li>\n                        </ul>\n                    </div>\n                </article>\n                <article class=\"grid gap-5 py-8 lg:grid-cols-[0.7fr_1.3fr] lg:gap-12 lg:py-10\" data-kid=\"1-2-1-2-2\" data-name=\"base fixed operator article\">\n                    <h3 class=\"max-w-[420px] text-2xl font-semibold leading-snug tracking-[-0.03em] text-[var(--color-cargo-deep)]\" data-kid=\"1-2-1-2-2-1\" data-name=\"base fixed operator title\">\n                        Operador de base fija (OBF)\n                    </h3>\n                    <div class=\"max-w-[750px]\" data-kid=\"1-2-1-2-2-2\" data-name=\"base fixed operator details\">\n                        <p class=\"text-base leading-relaxed text-[var(--color-cargo-ink)]/80\" data-kid=\"1-2-1-2-2-2-1\" data-name=\"base fixed operator description\">\n                            Servicios de despacho y asistencia en tierra para explotadores aéreos. El documento organizacional indica las secciones 1, 4, 6 y 7.\n                        </p>\n                        <ul class=\"mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm leading-relaxed text-[var(--color-cargo-ink)]/70\" data-kid=\"1-2-1-2-2-2-2\" data-name=\"base fixed operator services list\">\n                            <li data-kid=\"1-2-1-2-2-2-2-1\">\n                                Despacho y seguimiento de vuelos (121/135)\n                            </li>\n                            <li data-kid=\"1-2-1-2-2-2-2-2\">\n                                Guía de estacionamiento\n                            </li>\n                            <li data-kid=\"1-2-1-2-2-2-2-3\">\n                                Tráfico de pasajeros (121/135)\n                            </li>\n                            <li data-kid=\"1-2-1-2-2-2-2-4\">\n                                Asistencia especial, PRM y menores sin acompañante\n                            </li>\n                        </ul>\n                    </div>\n                </article>\n                <article class=\"grid gap-5 py-8 lg:grid-cols-[0.7fr_1.3fr] lg:gap-12 lg:py-10\" data-kid=\"1-2-1-2-3\" data-name=\"maintenance article\">\n                    <h3 class=\"max-w-[420px] text-2xl font-semibold leading-snug tracking-[-0.03em] text-[var(--color-cargo-deep)]\" data-kid=\"1-2-1-2-3-1\" data-name=\"maintenance title\">\n                        Mantenimiento de equipos de apoyo terrestre\n                    </h3>\n                    <p class=\"max-w-[750px] text-base leading-relaxed text-[var(--color-cargo-ink)]/75\" data-kid=\"1-2-1-2-3-2\" data-name=\"maintenance description\">\n                        Soporte para los equipos GSE utilizados en la operación aeroportuaria.\n                    </p>\n                </article>\n            </div>\n            <a class=\"mt-8 inline-flex items-center gap-3 text-sm font-semibold text-[var(--color-cargo-deep)] hover:text-[var(--color-cargo-emerald)]\" data-kid=\"1-2-1-3\" data-name=\"all services call-to-action link\" href=\"/es/servicios\">\n                Ver servicios y descripciones completas\n                <span aria-hidden=\"true\" data-kid=\"1-2-1-3-1\" data-name=\"arrow icon\">\n                    ↗\n                </span>\n            </a>\n        </div>\n    </section>\n    <section class=\"bg-[var(--color-cargo-deep)] px-6 py-16 text-[var(--color-cargo-white)] md:py-20 lg:px-12\" data-kid=\"1-3\" data-name=\"certification evidence section\" id=\"evidencia\">\n        <div class=\"mx-auto grid max-w-[1320px] items-center gap-10 lg:grid-cols-[1fr_0.92fr] lg:gap-20\" data-kid=\"1-3-1\" data-name=\"certification content container\">\n            <div class=\"max-w-[610px]\" data-kid=\"1-3-1-1\" data-name=\"certification text container\">\n                <h2 class=\"text-4xl font-semibold leading-tight tracking-[-0.04em] sm:text-5xl\" data-kid=\"1-3-1-1-1\" data-name=\"certification headline\">\n                    Un documento que respalda el alcance.\n                </h2>\n                <p class=\"mt-6 text-base leading-relaxed text-[var(--color-cargo-white)]/78\" data-kid=\"1-3-1-1-2\" data-name=\"certification main description\">\n                    Servicios Especializados JMC, C.A. presta servicios bajo la Regulación Aeronáutica Venezolana 111, con certificado de explotador emitido por el Instituto Nacional de Aeronáutica Civil.\n                </p>\n                <p class=\"mt-5 text-sm leading-relaxed text-[var(--color-cargo-light)]\" data-kid=\"1-3-1-1-3\" data-name=\"certification note text\">\n                    El documento adjunto identifica a Servicios Especializados JMC, C.A. y hace referencia a la RAV 111. Se muestra sin atribuirle un número que no es legible en esta imagen.\n                </p>\n                <a class=\"mt-7 inline-flex items-center gap-3 border-b border-[var(--color-cargo-light)]/60 pb-2 text-sm font-semibold text-[var(--color-cargo-light)] hover:text-[var(--color-cargo-white)]\" data-kid=\"1-3-1-1-4\" data-name=\"view certificate link\" href=\"/api/local/images/public/assets/images/cesea-cert.webp\" rel=\"noopener noreferrer\" target=\"_blank\">\n                    Abrir imagen del certificado\n                    <span aria-hidden=\"true\" data-kid=\"1-3-1-1-4-1\" data-name=\"arrow icon\">\n                        ↗\n                    </span>\n                </a>\n            </div>\n            <figure class=\"m-0 bg-[var(--color-cargo-white)] p-3 sm:p-5\" data-kid=\"1-3-1-2\" data-name=\"certification visual figure\">\n                <img alt=\"Escaneo del certificado otorgado a Servicios Especializados JMC, C.A.; en el texto se lee la referencia a la Regulación Aeronáutica Venezolana 111.\" class=\"w-full object-contain\" data-kid=\"1-3-1-2-1\" data-name=\"certificate image\" decoding=\"async\" height=\"600\" loading=\"lazy\" src=\"/api/local/images/public/assets/images/cesea-cert.webp\" width=\"800\"/>\n                <figcaption class=\"jmc-mono mt-3 px-1 text-[11px] uppercase tracking-[0.08em] text-[var(--color-cargo-deep)]\" data-kid=\"1-3-1-2-2\" data-name=\"certificate image caption\">\n                    Documento oficial · referencia RAV 111\n                </figcaption>\n            </figure>\n        </div>\n    </section>\n    <section class=\"bg-[var(--color-cargo-mist)] px-6 py-20 md:py-28 lg:px-12\" data-kid=\"1-4\" data-name=\"company profile section\" id=\"jmc\">\n        <div class=\"mx-auto grid max-w-[1320px] gap-14 lg:grid-cols-[0.86fr_1.14fr] lg:gap-24\" data-kid=\"1-4-1\" data-name=\"profile content container\">\n            <div class=\"max-w-[520px]\" data-kid=\"1-4-1-1\" data-name=\"profile text container\">\n                <h2 class=\"text-4xl font-semibold leading-tight tracking-[-0.04em] text-[var(--color-cargo-deep)] sm:text-5xl\" data-kid=\"1-4-1-1-1\" data-name=\"profile headline\">\n                    Servicios Especializados JMC\n                </h2>\n                <p class=\"mt-7 text-base leading-relaxed text-[var(--color-cargo-ink)]/80\" data-kid=\"1-4-1-1-2\" data-name=\"profile description paragraph 1\">\n                    Somos una empresa venezolana especializada en handling y asistencia en plataforma para aerolíneas. Acompañamos la operación aeroportuaria atendiendo aeronaves, pasajeros, equipaje y carga, con personal capacitado y equipos de apoyo terrestre.\n                </p>\n                <p class=\"mt-5 text-base leading-relaxed text-[var(--color-cargo-ink)]/80\" data-kid=\"1-4-1-1-3\" data-name=\"profile description paragraph 2\">\n                    Nacimos de la iniciativa de profesionales con más de 30 años de experiencia en el sector aeronáutico venezolano.\n                </p>\n                <p class=\"mt-8 border-t border-[var(--color-cargo-deep)]/15 pt-5 text-sm leading-relaxed text-[var(--color-cargo-ink)]/70\" data-kid=\"1-4-1-1-4\" data-name=\"profile details paragraph\">\n                    Una flota moderna y un taller de soporte técnico propio acompañan el mantenimiento riguroso y la capacitación continua del equipo. Los procesos de atención en tierra se adaptan a las necesidades operativas de cada aerolínea.\n                </p>\n            </div>\n            <div class=\"space-y-9\" data-kid=\"1-4-1-2\" data-name=\"profile values container\">\n                <article data-kid=\"1-4-1-2-1\" data-name=\"mission article\">\n                    <h3 class=\"text-xl font-semibold text-[var(--color-cargo-deep)]\" data-kid=\"1-4-1-2-1-1\" data-name=\"mission title\">\n                        Misión\n                    </h3>\n                    <p class=\"mt-3 max-w-[690px] text-base leading-relaxed text-[var(--color-cargo-ink)]/80\" data-kid=\"1-4-1-2-1-2\" data-name=\"mission description\">\n                        Aportar al mercado de servicios especializados aeroportuarios venezolano una alternativa hecha a la medida del cliente, con servicios en tierra, capital humano especializado, innovación de procesos y excelencia en el servicio.\n                    </p>\n                </article>\n                <article class=\"border-t border-[var(--color-cargo-deep)]/15 pt-8\" data-kid=\"1-4-1-2-2\" data-name=\"vision article\">\n                    <h3 class=\"text-xl font-semibold text-[var(--color-cargo-deep)]\" data-kid=\"1-4-1-2-2-1\" data-name=\"vision title\">\n                        Visión\n                    </h3>\n                    <p class=\"mt-3 max-w-[690px] text-base leading-relaxed text-[var(--color-cargo-ink)]/80\" data-kid=\"1-4-1-2-2-2\" data-name=\"vision description\">\n                        Consolidar el liderazgo en los servicios especializados aeroportuarios de Venezuela, sosteniendo estándares de excelencia y calidad mediante innovación, adaptación y capital humano calificado.\n                    </p>\n                </article>\n                <div class=\"border-t border-[var(--color-cargo-deep)]/15 pt-6\" data-kid=\"1-4-1-2-3\" data-name=\"values list container\">\n                    <h3 class=\"jmc-mono text-xs font-medium uppercase tracking-[0.1em] text-[var(--color-cargo-deep)]\" data-kid=\"1-4-1-2-3-1\" data-name=\"values section title\">\n                        Valores de JMC\n                    </h3>\n                    <p class=\"mt-4 max-w-[700px] text-sm leading-loose text-[var(--color-cargo-ink)]/75\" data-kid=\"1-4-1-2-3-2\" data-name=\"values description\">\n                        Respeto · tolerancia · cortesía · compromiso · justicia · responsabilidad · honestidad · innovación · superación · calidad · trabajo en equipo · excelencia\n                    </p>\n                </div>\n            </div>\n        </div>\n    </section>\n    <section class=\"bg-[var(--color-cargo-white)] px-6 py-20 md:py-28 lg:px-12\" data-kid=\"1-5\" data-name=\"equipment functions section\">\n        <div class=\"mx-auto max-w-[1320px]\" data-kid=\"1-5-1\" data-name=\"equipment functions container\">\n            <div class=\"mb-10 grid gap-5 lg:grid-cols-[0.75fr_1.25fr] lg:items-end\" data-kid=\"1-5-1-1\" data-name=\"functions header container\">\n                <h2 class=\"max-w-[420px] text-4xl font-semibold leading-tight tracking-[-0.04em] text-[var(--color-cargo-deep)] sm:text-5xl\" data-kid=\"1-5-1-1-1\" data-name=\"functions headline\">\n                    Funciones de los equipos de plataforma\n                </h2>\n                <p class=\"max-w-[690px] text-base leading-relaxed text-[var(--color-cargo-ink)]/70\" data-kid=\"1-5-1-1-2\" data-name=\"functions description\">\n                    Seis equipos de apoyo terrestre descritos por su función en la operación.\n                </p>\n            </div>\n            <div class=\"grid gap-x-14 border-y border-[var(--color-cargo-deep)]/20 md:grid-cols-2\" data-kid=\"1-5-1-2\" data-name=\"functions list grid\">\n                <article class=\"border-b border-[var(--color-cargo-deep)]/15 py-6 md:py-7\" data-kid=\"1-5-1-2-1\" data-name=\"carrucha equipment item\">\n                    <h3 class=\"text-lg font-semibold text-[var(--color-cargo-deep)]\" data-kid=\"1-5-1-2-1-1\" data-name=\"carrucha title\">\n                        Carrucha\n                    </h3>\n                    <p class=\"mt-2 text-sm leading-relaxed text-[var(--color-cargo-ink)]/75\" data-kid=\"1-5-1-2-1-2\" data-name=\"carrucha description\">\n                        Equipo sin motor que transporta equipaje, correo o carga suelta, enlazado en un tren entre la terminal y la aeronave.\n                    </p>\n                </article>\n                <article class=\"border-b border-[var(--color-cargo-deep)]/15 py-6 md:py-7\" data-kid=\"1-5-1-2-2\" data-name=\"tractor equipment item\">\n                    <h3 class=\"text-lg font-semibold text-[var(--color-cargo-deep)]\" data-kid=\"1-5-1-2-2-1\" data-name=\"tractor title\">\n                        Tractor remolcador de equipaje\n                    </h3>\n                    <p class=\"mt-2 text-sm leading-relaxed text-[var(--color-cargo-ink)]/75\" data-kid=\"1-5-1-2-2-2\" data-name=\"tractor description\">\n                        Vehículo de perfil bajo y gran tracción para remolcar carruchas y equipos pequeños hasta la plataforma.\n                    </p>\n                </article>\n                <article class=\"border-b border-[var(--color-cargo-deep)]/15 py-6 md:py-7\" data-kid=\"1-5-1-2-3\" data-name=\"waste water cart item\">\n                    <h3 class=\"text-lg font-semibold text-[var(--color-cargo-deep)]\" data-kid=\"1-5-1-2-3-1\" data-name=\"waste water cart title\">\n                        Carro de aguas residuales\n                    </h3>\n                    <p class=\"mt-2 text-sm leading-relaxed text-[var(--color-cargo-ink)]/75\" data-kid=\"1-5-1-2-3-2\" data-name=\"waste water cart description\">\n                        Atiende el servicio de sanitarios: vacía los tanques y recarga agua limpia con líquido desinfectante y desodorizante.\n                    </p>\n                </article>\n                <article class=\"border-b border-[var(--color-cargo-deep)]/15 py-6 md:py-7\" data-kid=\"1-5-1-2-4\" data-name=\"belt loader item\">\n                    <h3 class=\"text-lg font-semibold text-[var(--color-cargo-deep)]\" data-kid=\"1-5-1-2-4-1\" data-name=\"belt loader title\">\n                        Cinta transportadora de equipaje\n                    </h3>\n                    <p class=\"mt-2 text-sm leading-relaxed text-[var(--color-cargo-ink)]/75\" data-kid=\"1-5-1-2-4-2\" data-name=\"belt loader description\">\n                        Con banda elevable hasta la bodega, facilita la carga y descarga manual de maletas y carga a granel.\n                    </p>\n                </article>\n                <article class=\"border-b border-[var(--color-cargo-deep)]/15 py-6 md:py-7\" data-kid=\"1-5-1-2-5\" data-name=\"gpu equipment item\">\n                    <h3 class=\"text-lg font-semibold text-[var(--color-cargo-deep)]\" data-kid=\"1-5-1-2-5-1\" data-name=\"gpu title\">\n                        GPU · Ground Power Unit\n                    </h3>\n                    <p class=\"mt-2 text-sm leading-relaxed text-[var(--color-cargo-ink)]/75\" data-kid=\"1-5-1-2-5-2\" data-name=\"gpu description\">\n                        Proporciona energía eléctrica a la aeronave estacionada con los motores apagados, sin consumir combustible de la aeronave.\n                    </p>\n                </article>\n                <article class=\"border-b border-[var(--color-cargo-deep)]/15 py-6 md:py-7\" data-kid=\"1-5-1-2-6\" data-name=\"asu equipment item\">\n                    <h3 class=\"text-lg font-semibold text-[var(--color-cargo-deep)]\" data-kid=\"1-5-1-2-6-1\" data-name=\"asu title\">\n                        ASU · Air Start Unit\n                    </h3>\n                    <p class=\"mt-2 text-sm leading-relaxed text-[var(--color-cargo-ink)]/75\" data-kid=\"1-5-1-2-6-2\" data-name=\"asu description\">\n                        Proporciona aire comprimido a alta presión para asistir en el encendido de los motores, incluso cuando el APU está inoperativo o apagado.\n                    </p>\n                </article>\n            </div>\n        </div>\n    </section>\n    <section class=\"bg-[var(--color-cargo-deep)] px-6 py-16 text-[var(--color-cargo-white)] md:py-20 lg:px-12\" data-kid=\"1-6\" data-name=\"differentiators section\">\n        <div class=\"mx-auto grid max-w-[1320px] gap-10 lg:grid-cols-[0.72fr_1.28fr] lg:gap-20\" data-kid=\"1-6-1\" data-name=\"differentiators container\">\n            <h2 class=\"max-w-[430px] text-3xl font-semibold leading-tight tracking-[-0.035em] sm:text-4xl\" data-kid=\"1-6-1-1\" data-name=\"differentiators headline\">\n                Lo que distingue la operación de JMC\n            </h2>\n            <ul class=\"grid gap-x-10 gap-y-7 border-t border-[var(--color-cargo-light)]/25 pt-6 sm:grid-cols-2 lg:grid-cols-3\" data-kid=\"1-6-1-2\" data-name=\"differentiators list\">\n                <li data-kid=\"1-6-1-2-1\" data-name=\"differentiator item 1\">\n                    <h3 class=\"font-semibold text-[var(--color-cargo-light)]\" data-kid=\"1-6-1-2-1-1\" data-name=\"differentiator 1 title\">\n                        Flota de equipos moderna\n                    </h3>\n                    <p class=\"mt-2 text-sm leading-relaxed text-[var(--color-cargo-white)]/72\" data-kid=\"1-6-1-2-1-2\" data-name=\"differentiator 1 description\">\n                        GSE para apoyar las operaciones de plataforma.\n                    </p>\n                </li>\n                <li data-kid=\"1-6-1-2-2\" data-name=\"differentiator item 2\">\n                    <h3 class=\"font-semibold text-[var(--color-cargo-light)]\" data-kid=\"1-6-1-2-2-1\" data-name=\"differentiator 2 title\">\n                        Mantenimiento riguroso\n                    </h3>\n                    <p class=\"mt-2 text-sm leading-relaxed text-[var(--color-cargo-white)]/72\" data-kid=\"1-6-1-2-2-2\" data-name=\"differentiator 2 description\">\n                        Taller propio de soporte técnico.\n                    </p>\n                </li>\n                <li data-kid=\"1-6-1-2-3\" data-name=\"differentiator item 3\">\n                    <h3 class=\"font-semibold text-[var(--color-cargo-light)]\" data-kid=\"1-6-1-2-3-1\" data-name=\"differentiator 3 title\">\n                        Capacitación constante\n                    </h3>\n                    <p class=\"mt-2 text-sm leading-relaxed text-[var(--color-cargo-white)]/72\" data-kid=\"1-6-1-2-3-2\" data-name=\"differentiator 3 description\">\n                        Formación del equipo técnico y de rampa.\n                    </p>\n                </li>\n                <li data-kid=\"1-6-1-2-4\" data-name=\"differentiator item 4\">\n                    <h3 class=\"font-semibold text-[var(--color-cargo-light)]\" data-kid=\"1-6-1-2-4-1\" data-name=\"differentiator 4 title\">\n                        Normativa oficial\n                    </h3>\n                    <p class=\"mt-2 text-sm leading-relaxed text-[var(--color-cargo-white)]/72\" data-kid=\"1-6-1-2-4-2\" data-name=\"differentiator 4 description\">\n                        Operación bajo el marco regulatorio del INAC.\n                    </p>\n                </li>\n                <li data-kid=\"1-6-1-2-5\" data-name=\"differentiator item 5\">\n                    <h3 class=\"font-semibold text-[var(--color-cargo-light)]\" data-kid=\"1-6-1-2-5-1\" data-name=\"differentiator 5 title\">\n                        Servicio a la medida\n                    </h3>\n                    <p class=\"mt-2 text-sm leading-relaxed text-[var(--color-cargo-white)]/72\" data-kid=\"1-6-1-2-5-2\" data-name=\"differentiator 5 description\">\n                        Procesos adaptados a cada aerolínea.\n                    </p>\n                </li>\n                <li data-kid=\"1-6-1-2-6\" data-name=\"differentiator item 6\">\n                    <h3 class=\"font-semibold text-[var(--color-cargo-light)]\" data-kid=\"1-6-1-2-6-1\" data-name=\"differentiator 6 title\">\n                        Transparencia y seguridad\n                    </h3>\n                    <p class=\"mt-2 text-sm leading-relaxed text-[var(--color-cargo-white)]/72\" data-kid=\"1-6-1-2-6-2\" data-name=\"differentiator 6 description\">\n                        Principios para construir relaciones de largo plazo.\n                    </p>\n                </li>\n            </ul>\n        </div>\n    </section>\n    <section class=\"bg-[var(--color-cargo-mist)] px-6 py-16 md:py-20 lg:px-12\" data-kid=\"1-7\" data-name=\"contact section\" id=\"contacto\">\n        <div class=\"mx-auto flex max-w-[1320px] flex-col gap-7 border-b border-[var(--color-cargo-deep)]/20 pb-12 md:flex-row md:items-end md:justify-between\" data-kid=\"1-7-1\" data-name=\"contact container\">\n            <div class=\"max-w-[710px]\" data-kid=\"1-7-1-1\" data-name=\"contact text container\">\n                <h2 class=\"text-4xl font-semibold leading-tight tracking-[-0.04em] text-[var(--color-cargo-deep)] sm:text-5xl\" data-kid=\"1-7-1-1-1\" data-name=\"contact headline\">\n                    Conversemos sobre su operación.\n                </h2>\n                <p class=\"mt-4 text-base leading-relaxed text-[var(--color-cargo-ink)]/70\" data-kid=\"1-7-1-1-2\" data-name=\"contact description\">\n                    Contacto comercial de JMC Servicios Especializados.\n                </p>\n            </div>\n            <a class=\"inline-flex shrink-0 items-center justify-between gap-10 bg-[var(--color-cargo-emerald)] px-6 py-4 text-sm font-semibold text-[var(--color-cargo-ink)] hover:bg-[var(--color-cargo-light)]\" data-kid=\"1-7-1-2\" data-name=\"request quote button\" href=\"/es/cotizacion\">\n                Enviar solicitud\n                <span aria-hidden=\"true\" data-kid=\"1-7-1-2-1\" data-name=\"arrow icon\">\n                    ↗\n                </span>\n            </a>\n        </div>\n    </section>\n    <footer class=\"bg-[var(--color-cargo-deep)] px-6 py-10 text-[var(--color-cargo-white)] lg:px-12\" data-kid=\"1-8\" data-name=\"footer container\">\n        <div class=\"mx-auto grid max-w-[1320px] gap-8 md:grid-cols-[0.85fr_1.15fr] md:items-end\" data-kid=\"1-8-1\" data-name=\"footer info container\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-8-1-1\" data-name=\"footer logo brand container\">\n                <img alt=\"\" aria-hidden=\"true\" class=\"h-10 w-12 object-contain\" data-kid=\"1-8-1-1-1\" data-name=\"isotipo logo icon\" decoding=\"async\" height=\"96\" loading=\"lazy\" src=\"/api/local/images/public/assets/brand/isotipo-logo.webp\" width=\"114\"/>\n                <img alt=\"JMC Servicios Especializados\" class=\"h-8 w-28 object-contain object-left\" data-kid=\"1-8-1-1-2\" data-name=\"brand name logo\" decoding=\"async\" height=\"111\" loading=\"lazy\" src=\"/api/local/images/public/assets/brand/fuente-logo.webp\" width=\"320\"/>\n            </div>\n            <div class=\"grid gap-5 text-sm sm:grid-cols-2\" data-kid=\"1-8-1-2\" data-name=\"footer contact details container\">\n                <p data-kid=\"1-8-1-2-1\" data-name=\"footer email block\">\n                    <span class=\"jmc-mono mb-2 block text-[10px] uppercase tracking-[0.1em] text-[var(--color-cargo-light)]\" data-kid=\"1-8-1-2-1-1\" data-name=\"email label\">\n                        Correo\n                    </span>\n                    <a class=\"hover:text-[var(--color-cargo-light)]\" data-kid=\"1-8-1-2-1-2\" data-name=\"email address link\" href=\"mailto:customer.service@jmchandling.com\">\n                        customer.service@jmchandling.com\n                    </a>\n                </p>\n                <p data-kid=\"1-8-1-2-2\" data-name=\"footer phone block\">\n                    <span class=\"jmc-mono mb-2 block text-[10px] uppercase tracking-[0.1em] text-[var(--color-cargo-light)]\" data-kid=\"1-8-1-2-2-1\" data-name=\"phone label\">\n                        Teléfonos\n                    </span>\n                    <a class=\"block hover:text-[var(--color-cargo-light)]\" data-kid=\"1-8-1-2-2-2\" data-name=\"venezuela phone link\" href=\"tel:+584141180806\">\n                        Venezuela · +58 414 118 0806\n                    </a>\n                    <a class=\"mt-1 block hover:text-[var(--color-cargo-light)]\" data-kid=\"1-8-1-2-2-3\" data-name=\"usa phone link\" href=\"tel:+19544704217\">\n                        USA · +1 954 470 4217\n                    </a>\n                </p>\n            </div>\n        </div>\n        <div class=\"mx-auto mt-8 flex max-w-[1320px] flex-col gap-3 border-t border-[var(--color-cargo-light)]/20 pt-5 text-xs text-[var(--color-cargo-white)]/58 sm:flex-row sm:justify-between\" data-kid=\"1-8-2\" data-name=\"footer copyright container\">\n            <p data-kid=\"1-8-2-1\" data-name=\"company legal name\">\n                Servicios Especializados JMC, C.A. · Maiquetía, Venezuela\n            </p>\n            <p class=\"jmc-mono\" data-kid=\"1-8-2-2\" data-name=\"copyright notice\">\n                © 2026 JMC · Información basada en documentación de la empresa\n            </p>\n        </div>\n    </footer>\n</main>\n",
